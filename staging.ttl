<https://aa.perseus.org/staging/o/ham:287349> a stg:Object ;
    stg:aatType <http://vocab.getty.edu/aat/300193015> ;
    stg:accessionmethod "Bequest" ;
    stg:accessionyear 1972 ;
    stg:catalogPage <https://www.harvardartmuseums.org/collections/object/287349> ;
    stg:century "5th century BCE" ;
    stg:classification "Vessels" ;
    stg:colorName "#191919",
        "#323232",
        "#4b4b4b",
        "#7d4b32",
