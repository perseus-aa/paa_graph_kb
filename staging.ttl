        <https://aa.perseus.org/staging/color/287008/#c8967d>,
        <https://aa.perseus.org/staging/color/287008/#c8c8c8> ;
    stg:iiifManifest <https://iiif.harvardartmuseums.org/manifests/object/287008> ;
    stg:materialAAT <http://vocab.getty.edu/aat/300265960> ;
    stg:objectid 287008 ;
    stg:objectnumber "1972.46" ;
    stg:periodId 906 ;
    stg:periodLabel "Classical period, Early"@en ;
    stg:primaryImage <https://nrs.harvard.edu/urn-3:HUAM:74122_dynmc> ;
    stg:provenance "Jacob Hirsch (said to come from Gela). Frederick M. Watkins, 1941, bequest; to Fogg Art Museum, 1972." ;
    stg:source "ham" ;
    stg:standardreferencenumber "Beazley Archive Database #207216" ;
    stg:style "Red-figure" ;
    stg:title "Kalpis-Hydria (water jar): Youth Flanked by Two Women"@en .

