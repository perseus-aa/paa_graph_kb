PREFIX stg:  <https://aa.perseus.org/staging#>
PREFIX crm:  <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT {
  ?obj a crm:E22_Human-Made_Object ;
       crm:P2_has_type ?classNode ;
       crm:P2_has_type ?styleNode .

  ?classNode a crm:E55_Type ;
             rdfs:label ?classification .

  ?styleNode a crm:E55_Type ;
             rdfs:label ?style .
}
WHERE {
  ?s a stg:Object ; stg:source ?src ; stg:objectid ?oid .
  BIND( IRI(CONCAT("https://aa.perseus.org/id/thing/", SHA256(CONCAT(?src, ":", STR(?oid))))) AS ?obj )

  OPTIONAL {
    ?s stg:classification ?classification .
    BIND( IRI(CONCAT("https://aa.perseus.org/id/type/", SHA256(CONCAT("class|", LCASE(STR(?classification)))))) AS ?classNode )
  }

  OPTIONAL {
    ?s stg:style ?style .
    BIND( IRI(CONCAT("https://aa.perseus.org/id/type/", SHA256(CONCAT("style|", LCASE(STR(?style)))))) AS ?styleNode )
  }
}
