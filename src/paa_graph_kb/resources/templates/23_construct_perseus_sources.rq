PREFIX stg:  <https://aa.perseus.org/staging#>
PREFIX crm:  <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

# Transform Perseus bibliographic references and sources
# Handles sources_used field which may contain TEI markup

CONSTRUCT {
  ?obj a crm:E22_Human-Made_Object ;
       crm:P67i_is_referred_to_by ?sourcesNode .

  # Bibliographic references
  ?sourcesNode a crm:E33_Linguistic_Object ;
               rdfs:label "Bibliographic references"@en ;
               crm:P190_has_symbolic_content ?cleanSources ;
               rdf:value ?sourcesHTML ;
               crm:P2_has_type <http://vocab.getty.edu/aat/300026497> . # bibliography
}
WHERE {
  ?s a stg:PerseusObject ; stg:source ?src ; stg:perseusId ?perseusId .

  BIND( SHA256(CONCAT(?src, ":", ?perseusId)) AS ?h )
  BIND( IRI(CONCAT("https://aa.perseus.org/id/thing/", ?h)) AS ?obj )

  # Sources/bibliography (may contain TEI markup)
  # We expect both stg:sourcesUsed and stg:sourcesUsedClean to be present if sources exist
  
    ?s stg:sourcesUsed ?sources .
    OPTIONAL { ?s stg:sourcesUsedClean ?cleanRaw . }
    
    # Use clean text if available, otherwise fall back to raw
    BIND( COALESCE(?cleanRaw, ?sources) AS ?cleanSources )
    
    # Bind raw source as rdf:HTML
    BIND( STRDT(STR(?sources), rdf:HTML) AS ?sourcesHTML )

    # Stable URI for sources based on object hash
    BIND( IRI(CONCAT("https://aa.perseus.org/id/text/", SHA256(CONCAT("sources|https://aa.perseus.org/id/thing/", ?h)))) AS ?sourcesNode )
  
}
