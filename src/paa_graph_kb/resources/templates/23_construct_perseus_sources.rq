PREFIX stg:  <https://aa.perseus.org/staging#>
PREFIX crm:  <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Transform Perseus bibliographic references and sources
# Handles sources_used field which may contain TEI markup

CONSTRUCT {
  ?obj a crm:E22_Human-Made_Object ;
       crm:P67i_is_referred_to_by ?sourcesNode .

  # Bibliographic references
  ?sourcesNode a crm:E33_Linguistic_Object ;
               rdfs:label "Bibliographic references"@en ;
               crm:P190_has_symbolic_content ?sources ;
               crm:P2_has_type <http://vocab.getty.edu/aat/300026497> . # bibliography
}
WHERE {
  ?s a stg:PerseusObject ; stg:source ?src ; stg:perseusId ?perseusId .

  BIND( SHA256(CONCAT(?src, ":", ?perseusId)) AS ?h )
  BIND( IRI(CONCAT("https://aa.perseus.org/id/thing/", ?h)) AS ?obj )

  # Sources/bibliography (may contain TEI markup)
  OPTIONAL {
    ?s stg:sourcesUsed ?sources .
    BIND( IRI(CONCAT("https://aa.perseus.org/id/text/", SHA256(CONCAT("sources|", LCASE(STR(?sources)))))) AS ?sourcesNode )
  }
}
