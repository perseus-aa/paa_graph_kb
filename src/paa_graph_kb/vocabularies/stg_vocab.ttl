@prefix stg:  <https://aa.perseus.org/staging#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

stg:Object       a rdfs:Class ; rdfs:label "Staging Object"@en .
stg:Period       a rdfs:Class ; rdfs:label "Staging Period"@en .
stg:Place        a rdfs:Class ; rdfs:label "Staging Place"@en .
stg:Technique    a rdfs:Class ; rdfs:label "Staging Technique"@en .
stg:Material     a rdfs:Class ; rdfs:label "Staging Material"@en .
stg:Appellation  a rdfs:Class ; rdfs:label "Staging Appellation"@en .
stg:WebResource  a rdfs:Class ; rdfs:label "Staging Web Resource"@en .
stg:Person       a rdfs:Class ; rdfs:label "Staging Person"@en .

stg:source       a rdfs:Property ; rdfs:label "Source code"@en .
stg:objectid     a rdfs:Property ; rdfs:label "Object id (source)"@en ; rdfs:range xsd:integer .

stg:title        a rdfs:Property ; rdfs:label "Title literal"@en .
stg:altTitle     a rdfs:Property ; rdfs:label "Alternative title literal"@en .
stg:creditline   a rdfs:Property ; rdfs:label "Credit line"@en .
stg:provenance   a rdfs:Property ; rdfs:label "Provenance"@en .
stg:lang         a rdfs:Property ; rdfs:label "Language tag"@en .
stg:displayOrder a rdfs:Property ; rdfs:label "Display order"@en ; rdfs:range xsd:integer .

stg:typeLabel    a rdfs:Property ; rdfs:label "Object type label (text)"@en .
stg:aatType      a rdfs:Property ; rdfs:label "AAT Type IRI"@en .

stg:culture      a rdfs:Property ; rdfs:label "Culture label (text)"@en .
stg:cultureAAT   a rdfs:Property ; rdfs:label "AAT Culture IRI"@en .

stg:material     a rdfs:Property ; rdfs:label "Material label (text)"@en .
stg:materialAAT  a rdfs:Property ; rdfs:label "AAT Material IRI"@en .

stg:technique    a rdfs:Property ; rdfs:label "Technique label (text)"@en .
stg:techniqueAAT a rdfs:Property ; rdfs:label "AAT Technique IRI"@en .

stg:periodId     a rdfs:Property ; rdfs:label "HAM period id"@en ; rdfs:range xsd:integer .
stg:periodLabel  a rdfs:Property ; rdfs:label "Period label"@en .
stg:placeId      a rdfs:Property ; rdfs:label "HAM place id"@en ; rdfs:range xsd:integer .
stg:placeLabel   a rdfs:Property ; rdfs:label "Place label"@en .

stg:iiifManifest a rdfs:Property ; rdfs:label "IIIF Manifest IRI"@en .
stg:primaryImage a rdfs:Property ; rdfs:label "Primary image IRI"@en .

stg:catalogPage  a rdfs:Property ; rdfs:label "Catalog page IRI"@en .

# Additional textual properties
stg:dimensions   a rdfs:Property ; rdfs:label "Dimensions description"@en .
stg:description  a rdfs:Property ; rdfs:label "Object description"@en .
stg:commentary   a rdfs:Property ; rdfs:label "Commentary text"@en .
stg:labeltext    a rdfs:Property ; rdfs:label "Label text"@en .

# Identifier properties
stg:objectnumber         a rdfs:Property ; rdfs:label "Object number"@en .
stg:standardreferencenumber a rdfs:Property ; rdfs:label "Standard reference number"@en .

# Dating properties
stg:datebegin    a rdfs:Property ; rdfs:label "Date begin (integer year)"@en ; rdfs:range xsd:integer .
stg:dateend      a rdfs:Property ; rdfs:label "Date end (integer year)"@en ; rdfs:range xsd:integer .
stg:dated        a rdfs:Property ; rdfs:label "Dated (literal description)"@en .
stg:century      a rdfs:Property ; rdfs:label "Century"@en .

# Classification properties
stg:classification a rdfs:Property ; rdfs:label "Classification"@en .
stg:style        a rdfs:Property ; rdfs:label "Style"@en .

# Institutional properties
stg:department   a rdfs:Property ; rdfs:label "Department"@en .
stg:division     a rdfs:Property ; rdfs:label "Division"@en .

# Color properties
stg:colorName    a rdfs:Property ; rdfs:label "Color name"@en .
stg:hasColor     a rdfs:Property ; rdfs:label "Has color"@en .
stg:hexValue     a rdfs:Property ; rdfs:label "Hex color value"@en .

# Accession properties
stg:accessionyear   a rdfs:Property ; rdfs:label "Accession year"@en ; rdfs:range xsd:integer .
stg:accessionmethod a rdfs:Property ; rdfs:label "Accession method"@en .

# Image properties
stg:hasImage        a rdfs:Property ; rdfs:label "Has image"@en ;
                      rdfs:comment "Links an object to an image node"@en .
stg:imageid         a rdfs:Property ; rdfs:label "Image ID"@en ; rdfs:range xsd:integer .
stg:baseImageURL    a rdfs:Property ; rdfs:label "Base image URL"@en ;
                      rdfs:comment "URL to the base/full resolution image"@en .
stg:iiifBaseURI     a rdfs:Property ; rdfs:label "IIIF base URI"@en ;
                      rdfs:comment "IIIF Image API base URI"@en .
stg:imageWidth      a rdfs:Property ; rdfs:label "Image width (pixels)"@en ; rdfs:range xsd:integer .
stg:imageHeight     a rdfs:Property ; rdfs:label "Image height (pixels)"@en ; rdfs:range xsd:integer .
stg:imageFormat     a rdfs:Property ; rdfs:label "Image format"@en ;
                      rdfs:comment "File format (e.g., 'image/jpeg')"@en .
stg:imageDescription a rdfs:Property ; rdfs:label "Image description"@en ;
                      rdfs:comment "Textual description of the image content"@en .
stg:altText         a rdfs:Property ; rdfs:label "Alt text"@en ;
                      rdfs:comment "Alternative text for accessibility"@en .
stg:publicCaption   a rdfs:Property ; rdfs:label "Public caption"@en ;
                      rdfs:comment "Public-facing caption text"@en .
stg:copyright       a rdfs:Property ; rdfs:label "Copyright"@en ;
                      rdfs:comment "Copyright statement or rights holder"@en .
stg:imageTechnique  a rdfs:Property ; rdfs:label "Image technique"@en ;
                      rdfs:comment "Imaging technique used"@en .
stg:renditionNumber a rdfs:Property ; rdfs:label "Rendition number"@en ;
                      rdfs:comment "Rendition/version identifier"@en .
stg:imageDate       a rdfs:Property ; rdfs:label "Image date"@en ; rdfs:range xsd:date ;
                      rdfs:comment "Date when the image was created"@en .

# Person/Agent properties
stg:hasPerson       a rdfs:Property ; rdfs:label "Has person"@en ;
                      rdfs:comment "Links an object to a person node"@en .
stg:personid        a rdfs:Property ; rdfs:label "Person ID"@en ; rdfs:range xsd:integer ;
                      rdfs:comment "HAM person identifier"@en .
stg:personName      a rdfs:Property ; rdfs:label "Person name"@en ;
                      rdfs:comment "Person's name"@en .
stg:personDisplayName a rdfs:Property ; rdfs:label "Person display name"@en ;
                      rdfs:comment "Formatted name for display"@en .
stg:personAlphaSort a rdfs:Property ; rdfs:label "Person alpha sort"@en ;
                      rdfs:comment "Name in sortable format (lastname, firstname)"@en .
stg:personRole      a rdfs:Property ; rdfs:label "Person role"@en ;
                      rdfs:comment "Role in relation to object (e.g., Artist, Donor)"@en .
stg:personCulture   a rdfs:Property ; rdfs:label "Person culture"@en ;
                      rdfs:comment "Cultural or national origin"@en .
stg:personGender    a rdfs:Property ; rdfs:label "Person gender"@en .
stg:personDisplayDate a rdfs:Property ; rdfs:label "Person display date"@en ;
                      rdfs:comment "Life dates in display format"@en .

# Person date properties
stg:personDateBegin a rdfs:Property ; rdfs:label "Person date begin"@en ; rdfs:range xsd:integer ;
                      rdfs:comment "Birth year or earliest active date"@en .
stg:personDateEnd   a rdfs:Property ; rdfs:label "Person date end"@en ; rdfs:range xsd:integer ;
                      rdfs:comment "Death year or latest active date"@en .
stg:personBirthYear a rdfs:Property ; rdfs:label "Person birth year"@en ; rdfs:range xsd:integer .
stg:personDeathYear a rdfs:Property ; rdfs:label "Person death year"@en ; rdfs:range xsd:integer .
stg:personBirthPlace a rdfs:Property ; rdfs:label "Person birthplace"@en .
stg:personDeathPlace a rdfs:Property ; rdfs:label "Person deathplace"@en .

# Authority identifier properties
stg:lcnafId         a rdfs:Property ; rdfs:label "LCNAF ID"@en ;
                      rdfs:comment "Library of Congress Name Authority File identifier"@en .
stg:ulanId          a rdfs:Property ; rdfs:label "ULAN ID"@en ;
                      rdfs:comment "Getty Union List of Artist Names identifier"@en .
stg:viafId          a rdfs:Property ; rdfs:label "VIAF ID"@en ;
                      rdfs:comment "Virtual International Authority File identifier"@en .
stg:wikidataId      a rdfs:Property ; rdfs:label "Wikidata ID"@en ;
                      rdfs:comment "Wikidata entity identifier"@en .
stg:wikipediaId     a rdfs:Property ; rdfs:label "Wikipedia ID"@en ;
                      rdfs:comment "Wikipedia page identifier"@en .

# Publication/Bibliography properties
stg:Publication     a rdfs:Class ; rdfs:label "Staging Publication"@en .
stg:publicationid   a rdfs:Property ; rdfs:label "Publication ID"@en ; rdfs:range xsd:integer ;
                      rdfs:comment "HAM publication identifier"@en .
stg:publicationTitle a rdfs:Property ; rdfs:label "Publication title"@en .
stg:publicationSubtitle a rdfs:Property ; rdfs:label "Publication subtitle"@en .
stg:publicationCitation a rdfs:Property ; rdfs:label "Publication citation"@en ;
                      rdfs:comment "Formatted citation string"@en .
stg:publicationAuthor a rdfs:Property ; rdfs:label "Publication author"@en ;
                      rdfs:comment "Author name"@en .
stg:publicationYear a rdfs:Property ; rdfs:label "Publication year"@en ; rdfs:range xsd:integer .
stg:publisher       a rdfs:Property ; rdfs:label "Publisher"@en .
stg:isbn            a rdfs:Property ; rdfs:label "ISBN"@en ;
                      rdfs:comment "International Standard Book Number"@en .
stg:issn            a rdfs:Property ; rdfs:label "ISSN"@en ;
                      rdfs:comment "International Standard Serial Number"@en .
stg:doi             a rdfs:Property ; rdfs:label "DOI"@en ;
                      rdfs:comment "Digital Object Identifier"@en .
stg:publicationURL  a rdfs:Property ; rdfs:label "Publication URL"@en ;
                      rdfs:comment "URL to publication"@en .

# ========================================
# Perseus Digital Library Properties
# ========================================

# Perseus Classes
stg:PerseusObject   a rdfs:Class ; rdfs:label "Perseus Object"@en ;
                      rdfs:comment "Object from Perseus Digital Library"@en .
stg:PerseusImage    a rdfs:Class ; rdfs:label "Perseus Image"@en ;
                      rdfs:comment "Image from Perseus Digital Library"@en .

# Perseus Core Identifiers
stg:perseusId       a rdfs:Property ; rdfs:label "Perseus ID"@en ;
                      rdfs:comment "Perseus Digital Library identifier"@en .
stg:perseusName     a rdfs:Property ; rdfs:label "Perseus name"@en ;
                      rdfs:comment "Full name field from Perseus (e.g., 'Harvard 1960.250')"@en .
stg:perseusVersion  a rdfs:Property ; rdfs:label "Perseus version"@en ;
                      rdfs:comment "Perseus data version/quality indicator"@en .

# Perseus General Properties
stg:objectType      a rdfs:Property ; rdfs:label "Object type"@en ;
                      rdfs:comment "Type of object (Building, Vase, Sculpture, etc.)"@en .
stg:location        a rdfs:Property ; rdfs:label "Location"@en ;
                      rdfs:comment "Current location or repository"@en .
stg:summary         a rdfs:Property ; rdfs:label "Summary"@en ;
                      rdfs:comment "Brief summary or description of the object"@en .
stg:institution     a rdfs:Property ; rdfs:label "Institution"@en ;
                      rdfs:comment "Institution or museum name"@en .
stg:accessionNumber a rdfs:Property ; rdfs:label "Accession number"@en ;
                      rdfs:comment "Museum accession or catalog number"@en .
stg:collection      a rdfs:Property ; rdfs:label "Collection"@en ;
                      rdfs:comment "Collection name or identifier"@en .
stg:condition       a rdfs:Property ; rdfs:label "Condition"@en ;
                      rdfs:comment "Physical condition of the object"@en .

# Perseus Geographic Properties
stg:region          a rdfs:Property ; rdfs:label "Region"@en ;
                      rdfs:comment "Geographic region (e.g., 'Attica', 'Saronic Gulf')"@en .
stg:context         a rdfs:Property ; rdfs:label "Context"@en ;
                      rdfs:comment "Archaeological or geographic context"@en .

# Perseus Dating Properties
stg:startModifier   a rdfs:Property ; rdfs:label "Start date modifier"@en ;
                      rdfs:comment "Modifier for start date (e.g., 'ca.', 'before', 'after')"@en .
stg:endModifier     a rdfs:Property ; rdfs:label "End date modifier"@en ;
                      rdfs:comment "Modifier for end date (e.g., 'ca.', 'before', 'after')"@en .
stg:dateForSort     a rdfs:Property ; rdfs:label "Date for sort"@en ; rdfs:range xsd:integer ;
                      rdfs:comment "Numeric date value for chronological ordering"@en .
stg:unitaryDate     a rdfs:Property ; rdfs:label "Unitary date"@en ; rdfs:range xsd:integer ;
                      rdfs:comment "Single date value (when object has one date, not a range)"@en .
stg:unitaryModifier a rdfs:Property ; rdfs:label "Unitary date modifier"@en ;
                      rdfs:comment "Modifier for unitary date (e.g., 'ca.', 'before', 'after')"@en .

# Perseus Descriptive Properties
stg:decorationDescription a rdfs:Property ; rdfs:label "Decoration description"@en ;
                      rdfs:comment "Detailed iconographic or decorative description"@en .
stg:shape           a rdfs:Property ; rdfs:label "Shape"@en ;
                      rdfs:comment "Shape of object, especially for ceramics (e.g., 'amphora', 'kylix')"@en .
stg:ware            a rdfs:Property ; rdfs:label "Ware"@en ;
                      rdfs:comment "Ceramic ware type (e.g., 'Attic black-figure')"@en .

# Perseus Attribution Properties
stg:painter         a rdfs:Property ; rdfs:label "Painter"@en ;
                      rdfs:comment "Attribution to painter or artist"@en .
stg:painterModifier a rdfs:Property ; rdfs:label "Painter modifier"@en ;
                      rdfs:comment "Attribution qualifier (e.g., 'attributed to', 'manner of', 'near')"@en .
stg:beazleyNumber   a rdfs:Property ; rdfs:label "Beazley number"@en ;
                      rdfs:comment "Beazley Archive identifier for Greek vases"@en .

# Perseus Provenance Properties
stg:enteredBy       a rdfs:Property ; rdfs:label "Entered by"@en ;
                      rdfs:comment "Person or entity who entered the data"@en .
stg:sourcesUsed     a rdfs:Property ; rdfs:label "Sources used"@en ;
                      rdfs:comment "Bibliographic sources and references (may contain TEI markup)"@en .

# Perseus Image Properties
stg:imageId         a rdfs:Property ; rdfs:label "Image ID"@en ;
                      rdfs:comment "Perseus image identifier"@en .
stg:archiveNumber   a rdfs:Property ; rdfs:label "Archive number"@en ;
                      rdfs:comment "Archive or repository number for image"@en .
stg:imageName       a rdfs:Property ; rdfs:label "Image name"@en ;
                      rdfs:comment "Name or title of the image"@en .
stg:caption         a rdfs:Property ; rdfs:label "Caption"@en ;
                      rdfs:comment "Image caption or description"@en .
stg:credits         a rdfs:Property ; rdfs:label "Credits"@en ;
                      rdfs:comment "Image credits, attribution, or copyright information"@en .
stg:iiifImageService a rdfs:Property ; rdfs:label "IIIF Image Service"@en ;
                      rdfs:comment "IIIF Image API service base URL"@en .
