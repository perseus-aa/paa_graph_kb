        <https://aa.perseus.org/staging/color/287119/#fafafa> ;
    stg:hasImage <https://aa.perseus.org/staging/image/287119/40964> ;
    stg:iiifManifest <https://iiif.harvardartmuseums.org/manifests/object/287119> ;
    stg:materialAAT <http://vocab.getty.edu/aat/300010669> ;
    stg:objectid 287119 ;
    stg:objectnumber "1977.216.309" ;
    stg:periodId 1525 ;
    stg:periodLabel "Archaic period, Late, to Early Classical"@en ;
    stg:primaryImage <https://nrs.harvard.edu/urn-3:HUAM:VRS89266_dynmc> ;
    stg:provenance """Bought at Athens by George Pfeiffer.
