<https://aa.perseus.org/id/text/b9b1ad7ca9d858671a05d2d18ae65e5d5f9058e1c560378b714e1ed916735851> a crm:E33_Linguistic_Object ;
    rdfs:label "Provenance"@en ;
    crm:P190_has_symbolic_content "[Robert E. Hecht Jr, New York (by ca. 1982)], sold; to the Harvard University Art Museums, 1997." .

<https://aa.perseus.org/id/text/baea62ea2b6d249f5a0d043cd10a8107176ddab42ed63a077d5d296393df1c26> a crm:E33_Linguistic_Object ;
