<https://aa.perseus.org/id/text/448366a89f5a49d1fd2d77c81b9f00919b5a1f13cb4967ae0fbb0fcecedc8d0f> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Brouskari 1974, 134, fig. 254 (with previous bibliography)</bibl>" ;
