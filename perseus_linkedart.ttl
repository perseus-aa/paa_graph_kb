<https://aa.perseus.org/id/text/506ffbc2eb85be7e0bcf943068632ae3fceff4acef26bbe4499d4aa6ebf6b657> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">BMCRE</hi></bibl> IV, 425, nos. 294-296, pl. 58.9; <bibl>Cohen 1880-1892, 3, Lucius Verus, no. 248</bibl>; <bibl>Perkins Collection 1902, 101, 26</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/507e50b1d6af31ee27986d50159d2e15166b6eb1ee49fafac7a53229e02fefbf> a crm:E33_Linguistic_Object ;
