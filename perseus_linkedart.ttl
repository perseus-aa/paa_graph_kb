<https://aa.perseus.org/id/text/bc23b73a8a34ebf1a9e3015cbd12dcfdd9289bd6177be05e743981186212bdaa> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>CVA, German 22, Berlin 3: pl. 119.1-4, 120.1-3, 121.2-4,
