<https://aa.perseus.org/id/text/1409ff9ebdc0c5929c7da5918a79a6d1e51a2f2d6aa908e9e31ee0f7d59b00a3> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "The head of a male figure, identified as Plato, with furrowed brow, wavy hair, and a tidy, medium-length beard"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/140a318309fb7da7122e31be5132f7dca65ab015661000d58ec72405ce3b95f4> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Ajax, who has fallen on his sword, is attended by three Achaian
      mourners; an ape, at left, mimicks the mourning gestures. A snake is coiled on the bottom of
      the aryballos.</P><P>Additional decoration includes a frieze of tongues on the
      lip; a wreath around the rim; checkerboard and chevrons on the thick handle; and a chevron
      frieze around the bottom.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

