    crm:P190_has_symbolic_content """Rim: Lotus and palmette chain<lb>Handles: Running gorgons<lb>Side A, top:
      Departure of Amphiaraos<lb>Side B, top: Funeral games for Pelias (chariot
      race)<lb>Side A, below: Riders galloping to the left<lb>Side B, below: Hoplites in
      battle<lb>Under left handle: Wrestlers"""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/2a8b15d53d9aa4dc6714cb0773ee477efb47d4db7ae56cfcfe019ea3f788b39b> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """Paidia (labelled), standing profile to the right, bent at her waist,
      wearing a short sleeved chiton, a sphendone, a beaded necklace, and bead earrings, reaches
      both arms to the right, having just pushed Himeros (labelled) (nude and white), seated profile
      to right in a swing (rising to the right), supported by white strings, which he holds with
      both hands, while he reaches his bent legs forward, to the right, wearing a red taenia in his
      hair.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/2a900b72334bfa88233cc72de2e06bf1029dd44d7f394a9d7164ae0d767d909d> a crm:E33_Linguistic_Object ;
