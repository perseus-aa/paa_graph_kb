<https://aa.perseus.org/id/text/44dd6aa8e87390ed5c6a96f3672feac7b9b2da459e49eaf66d8601674b7d8703> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Tondo: boxer and trainer. Side A: boxers; side B: javelin-throwers."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/44ec15662cb470048fa618098f3d8e4a4607f8be73d42ccb9e8f67b801bbed5e> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Side A: Athena<lb>Side B: javelin-throwing on horseback"@en ;
