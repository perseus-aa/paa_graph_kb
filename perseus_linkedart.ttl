<https://aa.perseus.org/id/text/e82578731e09e942bceacbe643b3c73008144eb0a5f3bc4b0b9a3b60739cde8e> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>The satyr is drawn in outline technique on the black body while
      the maenad is painted in added white.</P><P>The shoulder is decorated (from top to
      bottom) with a tongue frieze over a spiral frieze; the top of the body is decorated with black
      bands interspersed with rows of dots; a reserved band decorates the molded
      base.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/e82eb4808cb986eea41d247a558c5b29309f709dd9747b325f1665bae65d746d> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Lekythos with scene of three figures"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/e833d6aabdabd22afedfdbf8d0a9a07f607d7eccc9e427c9f8c1e34a8b725c8b> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
