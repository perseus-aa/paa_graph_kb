<https://aa.perseus.org/id/text/e64699a34f944dd2a3e9c5aa4892e2fa7ed51c19d73f740d65dfda70e205138d> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="head">Sides A and B</hi>: eyes and grape
      clusters. Large eyes topped by eyebrows decorate each side. Between them is a 'nose,' a
      vertical red slash (flame?) atop a double volute capital. Clusters of grapes hang on vines
      next to the handles. The stems of the vines on sides A and B cross under the
      handles.</P><P><hi rend="head">Interior</hi>: the inside of the kylix
      is glazed black with a central reserved circular area.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

