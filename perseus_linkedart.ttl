<https://aa.perseus.org/id/text/11085c338c2bee87d4eb2e742ced66c9c12513e5646271f59317386d03b63a76> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Incised lines are above and below the neck ring. Vertical pairs
      of incised lines separate the tongue pattern on the shoulder. The tongue pattern consists of
      alternating red and white tongues, separated by pairs of blanks. Nine added red bands encircle
      the vase below the tongue pattern. On the single animal frieze, a harpy or siren appears
      between facing lion and lioness, followed by a swan behind a lioness, goat behind lion, and a
      second lioness or panther to the right of the handle between goat and swan. Rosettes are
      visible in the field. And added red band runs below the animal frieze and above a band of rays
      over the foot. A single black band rings the foot, with two black circles on the underside of
      the foot. The handle, neck, and interior of the mouth are
      glazed.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/110ddc3a85ad0b3f1b46f31de2585a99ece791513fe58e28902d41a4802b8110> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>CVA, Munich 1, pls. 41, no. 2, 42, nos. 1-3, 52, no.
      4</bibl>; <bibl>Johnston 1979</bibl>; <bibl>von Bothmer
      1957</bibl>; <bibl>LIMC, I, Antilochos I, 835-837</bibl>; <bibl>Bohr
      1982</bibl></P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/11153554705f62a7d4b1f94474dfd5c81fe1f0472ae40c54ca12f600e11268ee> a crm:E33_Linguistic_Object ;
