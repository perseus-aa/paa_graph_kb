<https://aa.perseus.org/id/text/d31dc8ec71eda72c13ae725bd8893e83c2bab467ad24f58d98451a8ed8753537> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Side A: Menelaos (or Ajax) seizing Helen (or Kassandra). Side B: Draped bearded
      man."""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/d320cae19c931fc73955eb616e4e4a6e0740a1737efd5327a734c2dc897020b6> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>An "Aethiopian" (i.e. black African) archer, drawn in outline
      except for the face, hands, and cloak. There is no use of incision. The archer stands with his
      torso frontal, legs in profile to the right, head turned to the left, and arms outstretched on
      either side. He wears long trousers decorated with stripes and dots, a tunic with long,
      striped sleeves, and a cuirass with shoulder-flaps and black belt. In his left hand he holds a
      bow, in his right a battle-axe like those often carried by Amazons. A large quiver of <hi
      rend="ital">gorytos</hi> type hangs at his waist. To the right is a small table,
      probably 3-legged. On the side opposite the archer is a tall palm tree with rippling trunk.
      The groundline is a slender stripe of thinned glaze. The lip and base are black. A black band
      framed by two narrow stripes circles the upper body.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/d32d8c24469a0b111fa849b6086a2d299ea6dffa60a993432c4b895647e456b7> a crm:E33_Linguistic_Object ;
