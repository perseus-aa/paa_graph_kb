<https://aa.perseus.org/id/text/18644a0d508d3a9af6b46543696dc63893ac8bddd4004ebd5ff1b2df409fdc4e> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">BMCRE</hi></bibl> II, 49, no. 275" ;
