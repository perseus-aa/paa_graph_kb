<https://aa.perseus.org/id/text/cc3598e454cef2924ecc729350f68c3ba24f2eaf57e3dff64ab3601098eeeb2b> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<bibl>LIMC</bibl>, 7.435 s.v. Pompe no. 2, pl. 348 (E. Simon);
      <bibl>Robertson 1992</bibl>, 288 fig. 291; <bibl>Valavanis
      1991</bibl>, 153 n. 408; <bibl>Boardman 1989a</bibl>, fig. 394; F.W.
      Hamdorf, Dionysos--Bacchus. Kult und Wandlungen des Weingottes (Munich 1986) 80 pl. 42;
      <bibl>LIMC</bibl>, 3.494 s.v. Dionysos no. 849 (D. Gasparri); <bibl>Simon
      1983</bibl>, 5, 70, 96, pl. 5.2; <bibl>Simon & Hirmer 1976</bibl>, fig.
      235; W. Biers, The Archaeology of Greece (Cornell 1980) 272, fig. 9.44; R. Folson, Attic
      Red-Figured Pottery (Park Ridge 1976) pl. 63; <bibl>Robertson 1975</bibl>, 417; J.
      Schelp, Das Kanoun (Wrzburg 1975) 27, 48 pl. 4.2; G. Schneider-Herrmann, "Anticipation of a
      Dionysos Festival on a Lekythos," <hi rend="ital">BABesch</hi> 42 (1967) 77 fig.
      4; E. Simon, "Attische Monatsbilder," <hi rend="ital">JdI</hi> 80 (1965) 121, fig.
      12; <bibl>Hibbs 1961</bibl> 64, fig. 71; <bibl>Mtzger 1951</bibl>, pl.
      45.1; M. Bieber, "Eros and Dionysos on Kerch Vases," <hi rend="ital">Hesperia
      Suppl</hi>. 8 (1949) pl. 4.1; <bibl>Richter 1946</bibl>, fig. 123; O.
      Brendel, "Procession Personified," <hi rend="ital">AJA</hi> 49 (1945) 519-25, fig.
      1; A.W. Byvanck, "Onderzoekingen over de Kunst der vierde Eeuw vr Christus. VIII. De Kunst
      omstreeks het Midden en Gedurende de Tweede helft van de Vierde eeuw," <hi
      rend="ital">BABesch</hi> 20 (1945) 23-25, fig. 25; <bibl>Richter & Hall
      1936</bibl>, 215-16 no. 169, pls. 164, 177 (with previous bibliography).""" ;
