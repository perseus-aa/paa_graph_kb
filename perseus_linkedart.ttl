<https://aa.perseus.org/id/text/2badd1be82bdbb2acbb6fe4b88f32a3f842fadc990bdc07627f8027473fcf19c> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Meyer 1989, 288 A 81, pl. 26.1</bibl>; K. Stemmer, \"\"Untersuchen zur Typologie, Chronologie, und Ikonographie der Panzerstatuen,\"\" <hi rend=\"ital\">AF</hi> 4 (1978) 135 n. 431; L. Budde and R. Nicholls, <hi rend=\"ital\">A Catalogue of the Greek and Roman Sculpture in the Fitzwilliam Museum, Cambridge</hi> (Cambridge 1964) 11-12 no. 27, pl. 5; <hi rend=\"ital\">CIG</hi> 3635; F.M. Heichelheim, \"\"The Greek Inscriptions in the Fitzwilliam Museum,\"\" <hi rend=\"ital\">JHS</hi> 62 (1942) 15 no. 6c; A. Michaelis, <hi rend=\"ital\">Ancient Marbles in Great Britain</hi> (C.A.M. Fennell trans.) (London 1882) 248 no. 15; H.A. Chapman, <hi rend=\"ital\">Handbook of the Collection of Antiquities and Other Objects Exhibited in the Fitzwilliam Museum</hi>, 2nd ed. (Cambridge 1904) 41; E.D. Clarke, <hi rend=\"ital\">Travels in Various Countries of Europe, Asia and Africa</hi> (London 1810) 4 2.163, 8 3.205; E.D. Clarke, <hi rend=\"ital\">Greek Marbles Brought from the Shores of the Euxine, Archipelago, and Mediterranean, and Deposited in the Vestibule of the Public Library of the University of Cambridge</hi> (Cambridge 1809) 51 no. 29." ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/2bb00f5fc79aeb5b6ea7d60fd34d9025dbe34e9d972672a3461c8e09e17519d6> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Int.</hi>: The tondo is encircled
      by a narrow reserved band. Hyakinthos is shown seated on the swan. They are in profile to the
      left, riding upon waves indicated by reserved area. Marine animals are indicated in black
      paint on the waves: a crab, cuttlefish, and two other fish. The boy is slender and nude except
      for a mantle around his shoulders. He guides the swan with reins, painted purple. In the field
      in front of the swan's beak is the partial inscription (in purple paint) <foreign
      lang="Greek">*O*P*A*I*S *K*A*L [*O*S]</foreign> ("The boy is
      beautiful").</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/2bb8f5aeea16497ad009d05b8388e11543284e5e62841065ec057fa755208160> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Decorated with five bands of black glaze on foot and body"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/2bd11f7001f82a6b983aec32761c67086ab66fa115bbe12ecb342cff302b2a2f> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Sides A and B</hi>: a fighting cock
      is centered in the reserved lip zone. The bird is painted in a fine miniaturist style with
      much detail of plumage.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/2bd58f48a1eecb60dd32d1d333410d9a9b1b5481297280443f0078e8d03b87e8> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content "<P>Heavily pitted surface.</P>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/2be09f8d15eadb2cca5e1681a62d16c87bdca457c490a56f16e8b719440b16a3> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Side A</hi>: athlete washing. A
      naked youth wearing a fillet stands at a pedestalled wash basin, a strigil held in his right
      hand. His left hand is in the water. On the right, a naked boy kneels on the ground cleaning
      one of the youth's sandals with a sponge. The other sandal, a sponge and an aryballos hang
      near the basin. There is an inscription on the basin.</P><P><hi
      rend="ital">Side B</hi>: youth. A youth leans on his staff in front of a truncated
      column set on a base. The youth's left arm is raised and he is looking at the column. A fillet
      is tied around the column near the top, and an aryballos hangs near it. The youth wears a
      mantle.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

