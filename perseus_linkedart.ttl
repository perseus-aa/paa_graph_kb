    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/7e99ac68a42633aa684d1119f0b92d73aa2525a915788618236e48d0e907b495> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
