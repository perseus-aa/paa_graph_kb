    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/506c83f5e454c4bfb3dbe80b54545defadb8ee5f829723760053e66e513d8623> a crm:E33_Linguistic_Object ;
