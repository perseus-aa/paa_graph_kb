<https://aa.perseus.org/id/text/22d2520e728ec718ffe60e4c4e3a7e9ba5049b47a81189eb0958d7076b0c8cdd> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Sides A and B</hi>: In the center,
      a lion walks to the right, its left leg raised. The tail is raised high in an arc and the
      mouth is open, roaring. Added red on the mane. The groundline is a black stripe. Handles
      black; lower body black except for reserved stripe; side of foot reserved, the rest black.
      <hi rend="ital">Interior</hi>: Black except for central medallion with a circle
      and dot, and a narrow reserved band at rim.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

