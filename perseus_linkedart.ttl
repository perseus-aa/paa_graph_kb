<https://aa.perseus.org/id/text/99aa0238095f06b3e0c7f5d533fd5249b152bd35c688aaf40f7d64fbf754d3f0> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """E. Simon, <bibl>LIMC, I.752</bibl>; <bibl>Kaempf-Dimitriadou
      1979, 26-30</bibl>; <bibl>Simon 1982, 147-48</bibl>; <bibl>Burn 1987,
