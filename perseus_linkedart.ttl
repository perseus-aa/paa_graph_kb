<https://aa.perseus.org/id/text/faa02b216786c0878d54be026e0aff7df6071cfe8f4be32f4be1958fbb921ab0> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<bibl>LIMC</bibl>, 7.246 s.v. Peitho no. 30, pl. 180 (N.
      Icard-Gianolio), 501 s.v. Pothos 1 no. 3, pl. 394 (J. Bazant); <bibl>Shapiro
      1993</bibl>, 62, 109, 203, 241 no. 48, figs. 59, 165; <bibl>LIMC</bibl>,
      6.668 s.v. Mousa/Mousai no. 93 (F. Queyrel), 687 s.v. Mousaios no. 13 (A. Kauffmann-Samaras);
      <bibl>Add2</bibl>, 362; <bibl>LIMC</bibl>, 4.56 s.v. Eumolpos no. 1,
      pl. 245 (L. Weidauer), 413 s.v. Harmonia no. 13, pl. 241 (E. Paribeni), 835 s.v. Herakles no.
      1681, pl. 559 (J. Boardman et al.); <bibl>Burn 1987</bibl>, 98 M 7 pls. 35-37;
      <bibl>Shapiro 1986</bibl>, pl. 3.1-2; <bibl>LIMC</bibl>, 2.121, 145
      s.v. Aphrodite nos. 1264 1518 (A. Delivorrias); <bibl>Para</bibl>, 477;
      <bibl>Richter 1969</bibl>, 242d; E.B. Harrison, ""Hesperides and Heroes. A Note on
      the Three-Figure Reliefs,"" <hi rend="ital">Hesperia</hi> 33 (1964) pl. 14a;
      <bibl>Papadaki 1960</bibl> 122; <bibl>Webster 1956</bibl>, 42, pl. 7;
      <bibl>Becatti 1947</bibl>, pls. 12-14; <bibl>Richter 1946</bibl>, fig.
      114; <bibl>Richter 1944</bibl>, 17; G.M.A. Richter, "Archaeological Notes. Two
      recent acquisitions by the Metropolitan Museum of Art," <hi rend="ital">AJA</hi>
      43 (1939) 2-6 figs. 1-3; G.M.A. Richter, "A New Vase by the Meidias Painter," <hi
      rend="ital">BMMA</hi> 33 (1938) 262-64, figs. 1-2.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/faa7815ae6751f94f0a5e417df3ee3d2be481dbdaec3d86e507aa1af8b35b031> a crm:E33_Linguistic_Object ;
