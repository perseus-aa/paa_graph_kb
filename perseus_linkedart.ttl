<https://aa.perseus.org/id/text/1d29e8ae2e5b39c13b32d5196e990ecd38e4320bf1f1d5cca7b90545b999fd43> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<P><bibl>Vierneisel-Schlrb 1979, 262 n. 4.6</bibl>; <bibl>Jung 1976, no. 7</bibl>; <bibl>La Rocca 1974, 113 no. 7, figs. 14-15</bibl>; P.A. Fevrier, FastiArch 18-19 (1963-1964) 110 no. 7755, pl. 36 (erroneous identification as a caryatid).</P>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

