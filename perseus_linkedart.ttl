<https://aa.perseus.org/id/text/9afec310435e6bed0732052ef79502e117f20e87068bfb0d7a6c37f781d3933a> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Side A: A bearded man picks grapes beneath a tree on a bough of
      which sits another bearded man, picking grapes. Two boys help picking grapes, while a man
      picks up a basket (of grapes) on the right of the scene.</P><P>Side B: a maenad
      dances between two dancing satyrs, while the satyr on the left plays the double
      flute.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/9b0067755de1184dc386e65e07e19f2b76929329421ca0ab1e9032dc49c99121> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "A. Kosmopoulou, \"\"The Relief Base of Atarbos, Akropolis Museum 1338,\"\" in K. Hartswick and M. Sturgeon eds., <hi rend=\"ital\">Studies in Honor of Brunilde Sismondo Ridgway</hi> (Philadelphia 1998); <bibl>Kosmopoulou 1996, 190-93, cat. 30</bibl>; <bibl>Boardman 1995, fig. 153</bibl>; <bibl>Palagia 1994, 115, fig. 6</bibl>; V. Machaira in <hi rend=\"ital\">Mind and Body</hi>,  210 no. 101 (ill.); <bibl>Parke 1977, fig. 7</bibl>; <bibl>Brouskari 1974, 20, pl. 5</bibl>; W.H. Schuchhardt, \"Das 'bdende Mdchen' in Mnchner Antiquarium,\" <hi rend=\"ital\">Die Antike</hi> 12 (1936) 84-106, esp. 100-12, figs. 16-17; R. Horn, <hi rend=\"ital\">Stehende Weibliche Gewandstatuen in der Hellenistischen Plastik. RM-EH</hi> 2 (1931) 16-17 pl. 4.1; S. Casson, <hi rend=\"ital\">Catalogue of the Acropolis Museum 2.  Sculpture and Architectural Fragments</hi> 1921, 2.240; W. Klein, <hi rend=\"ital\">Praxiteles</hi> (Leipzig 1898) 35" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/9b16a70cc32741c425bf01712cebcaf290cc165d6bcc48c8481ad7eb0578bdf3> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """The aryballos was made in a two-part mold in the form of a recumbent
      lion. There are suspension holes on either side of the lion's face; there is an opening at the
      top of the head for filling. Much of the body is covered with fine dots. Painted lines radiate
      from the face to indicate the lion's mane.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/9b19bdc2aea15d05ead2473a9afdbf406974d2899f12653fe36f09490834b0aa> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Cook 1976, 57-58, fig. 47</bibl>; <bibl>Robertson 1975, 175</bibl>; <bibl>Richter 1970d, no. 159</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/9b1d9b52e9695db52779864284a1d1b6df3e98d4200ca21f5054b4d568ce8c89> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Priest standing in 3/4-view to the right"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

