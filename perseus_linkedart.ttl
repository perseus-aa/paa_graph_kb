<https://aa.perseus.org/id/text/15e8b44c333adbc0eadf119fb6e3190b39cbbe995c3a5341cede20d56c4cffc2> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Front: winged demon or boread flying right<lb>Under handle: standing
      bird"""@en ;
