<https://aa.perseus.org/id/text/d6ebd40274266d954c0965a966ea335695e78e5fca2c8f92bd2e833a0684c93b> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "The sanctuary of Apollo Delphinios is a rectangular temenos enclosure bordered by two-aisled stoas at the north, east and south. The sanctuary is situated to the north-east of the North Market of Miletus, close to the Lion Harbor."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

