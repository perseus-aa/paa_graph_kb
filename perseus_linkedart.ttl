<https://aa.perseus.org/id/text/de327359b2b14f896ae4bd9ace0363ff24c926ce219c5b3786ebd2583909cea4> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<bibl>Matheson 1995</bibl>, 287, 480 no. PGU 171, pl.149;
      <bibl>Add2</bibl>, 323; <bibl>Maas & Snyder 1989, 90</bibl>;
      <bibl>Para</bibl>, 445; H. Immerwahr, "Book Rolls on Attic Vases," <hi
      rend="ital">Classical, Mediaeval, and Renaissance Studies in Honor of Berthold Louis
      Ullmann</hi> 1 (Rome 1964) 26; J.D. Beazley, "Hymn to Hermes," <hi
      rend="ital">AJA</hi> 52 (1948) 338; Beazley 1928, 55 n. 5; <bibl>Collignon
      & Couve</bibl>, 401-403 no. 1241 (with previous bibliography).""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/de34b19219da3d1cb3cf1c43a5cbcd19876f029d0cef777c21b289713e366d9c> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Sides A and B</hi>: A large pair of
      eyes separated by a rudimentary nose. Between the eyebrows is a teardrop-shaped mark flanked
      by dots; another dot above the nose. The irises are painted white. Within the pupil is a
      concentric circle of applied red; both are outlined with compass-drawn incision. On either
      side, by the handles, nude komasts run away from the eyes but look back toward them; all but
      one are beardless and all have red hair. Beneath each handle is a lotus bud with dots,
      pointing downward. There are two black bands on the lower body. The foot is black, save for
      the fillet at top and the side of the lower edge. The black handles are streaked with red from
      misfiring. <hi rend="ital">Tondo</hi>: Gorgoneion, drawn in outline, with the
      irises and lips in added white, the tongue and hair in added
      red.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/de38a0909ba51f58c1a85b8ec9db5a24f119d75cb4a7e33f17fee7ac30686a0d> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Temple; on the ridge marking the southern extent of the city, east of the Temple of Herakles."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/de433f60992453281714d848378e37fcd3c5d215a22e4015dc1bac286f674fc3> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
