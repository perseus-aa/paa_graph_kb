<https://aa.perseus.org/id/text/9975a72abc15725b95004c8b719b1493bbef7e5a154bb46463b0ffebff6396f6> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Charbonneaux 1963, 30</bibl>" ;
