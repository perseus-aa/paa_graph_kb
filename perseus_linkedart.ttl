<https://aa.perseus.org/id/text/2f5fe6a0374b0e1f050d77e60fb788c089fd6b0dbdb197dac031ad8e9b8ef9e2> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
