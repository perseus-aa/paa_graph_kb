    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/eb3a9cbaeccc5e3867686d5871642e4c19dc5f9ee56b1b57792fb43d4ebdedee> a crm:E33_Linguistic_Object ;
