<https://aa.perseus.org/id/text/15214817201bd6d3ec43613589e891a05123d26fb7cf7643a689d1e1a89b6cab> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<bibl>Shapiro 1993</bibl>, 224-25, 264 no. 147, fig. 185; Oakley 1990,
      35, pl. 124A; <bibl>Add2</bibl>, 316; <bibl>Boardman 1989a</bibl>,
      fig. 318; J. Burow, CVA Tbingen 5 (1986) 49-52, pls. 21, 22.1-6, fig. 22 (with previous
      bibliography); <bibl>LIMC</bibl>, 3.96 s.v. Bendis no. 2 (Z. Goceva/D.
      Popov).""" ;
