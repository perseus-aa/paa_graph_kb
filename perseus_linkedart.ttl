      vierten Jahrhunderts v. Chr.," <hi rend="ital">AM</hi> 79 (1964) 47, 64; A.A.
      Peredolskaja, <hi rend="ital">Truky Otdela</hi> 1 (Leningrad 1945) 56;
      <bibl>Furtwngler 1895, 487 no. 5 ["aryballos"]</bibl>.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/1261c892540ef4ef55e07030bcdb3b78d8ae1c2584b550e6f35a751da2ff8602> a crm:E33_Linguistic_Object ;
