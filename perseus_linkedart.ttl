<https://aa.perseus.org/id/text/9ab673e27b0e22b487d1f2ac5c3a863eae0139b41307eb05cbd7916676aa6f23> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Shear 1973a, 164-5</bibl>; <bibl>Agora XI, 108-76</bibl>; <bibl>Agora Guide 1990, 90-2</bibl>; <bibl>Camp 1986, 74-7</bibl>; <bibl>Boardman 1985a, 177</bibl>" ;
