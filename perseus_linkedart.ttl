<https://aa.perseus.org/id/text/eaa5436260e58536668c67fa210f05197af91d812662c1e003bc9fb472344084> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Sabina, draped and veiled"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/eaaf1050e7e6a0077bb8258af45e9f5fb1662c193ca7ffe38e3217ed21c1fa37> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>A woman sits on a diphros or stool to the right. She holds up a
      wreath with both hands, grasping it with the thumb and finger of the left hand above and the
      right below. She wears a long, sleeved chiton, with himation around her legs, earrings, and
      bracelets and her hair is looped up with rows of curls over her forehead. On the right a
      sakkos hangs from the upper border; on the left an alabastron hangs from an oblong object.
      Behind her hangs a large basket. In the field is inscribed, <foreign
      lang="Greek">*K*A*L*E</foreign>, "(she is) beautiful."</P><P>Above the
      design, there is a strip of meander on white. On the shoulder is a pattern of three red figure
      palmettes and two lotus buds. Above this is an egg pattern in red figure. The body is covered
      with a warm yellow slip, on which the design is drawn in black outline. A second white was
      used for the flesh, sakkos, and alabastron and spoils the drawing. Her hair and himation are
      black with details added in pink. The chiton is pink with brown
      detailing.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/eab03fc9895f41ed426d97a2db705f1b9b7fff59450cf31ef44b459b391446e3> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Exterior: Side A:</hi> Between
      feminine eyes, a nude silen attacks a Maenad. She advances toward him, but turns her head
      away. Her flesh is white; she wears a garland of ivy leaves in her hair, and is draped in a
      chiton and himation, decorated with white dots arranged in triangles. The hair, beard, and
      tail of the silen are red. In the field there is conventional
      foliage.</P><P><hi rend="ital">Side B:</hi> Similar scene except that
      the Maenad flees from the silen, and looks back at him. In her hands she holds a pair of
      krotala. In the field there is conventional foliage. Under each handle there is a flying bird.
      There is no design on the interior.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/eabbb99ce3c94b7a20c61ec9168bdee2f0c96826095abdd5a0d3444a0d9b6010> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">BMCRE</hi></bibl> IV, 611, no. 1359 (sestertius: 27.07 gm.)" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/eacd560c2c2a73fecc7fa5dfca93466bb2e7ea3005581acc21ff4e8927aae584> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """The vase remains without repairs or restorations, but the surface has been dulled by the
      effect of salts. A dark horizontal line--perhaps original--mars the lower right portion of the
      scene on side A.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/eacd849832dd7dd721a0958530086bfa8b47160d205ff45454af6a5215afdc5c> a crm:E33_Linguistic_Object ;
