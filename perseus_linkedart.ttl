<https://aa.perseus.org/id/text/adceecd6ce89c5d086a49f767e238a0cb69866e181dad5942b6d285056d81be3> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Comstock & Vermeule 1976, no. 345 (ill., with previous bibliography)</bibl>; <hi rend=\"ital\">AJA</hi> 68 (1964) 338, pl. 108, fig. 320" ;
