<https://aa.perseus.org/id/text/2e99f7c9078d1f848e0d2acd24a5823ad37c96a0634c4dc811204716224915d7> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>The outer edge, as well as the central depression in the
      interior, are encircled by kimatia. The rim interior is marked by a band of red. The interior
      itself is decorated with three large fish, a scorpion fish and a sargus oriented the same way,
      as well as a mullet pointing the opposite direction. In between these creatures are smaller
      ones resembling nematodes.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

