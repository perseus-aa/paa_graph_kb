<https://aa.perseus.org/id/text/2b62dcd34d373aef07c93c79986d636d56f5e47f162d3eaa1e7289e8f9b85eae> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<P><bibl>McDonagh 1989, 327-329</bibl>; <bibl>PECS, 474-475</bibl>; <bibl>Bean 1971, 58-68</bibl></P>" ;
