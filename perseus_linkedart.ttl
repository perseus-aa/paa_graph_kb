<https://aa.perseus.org/id/text/ab6b4ad0f6f303c2d1b5f49e9458a022cea5d1e806eb3830b3497d13c976ee4d> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """On either side of a tomb, comprised of a simple stele on a four-step
      base, with at least two red fillets tied around it, stand a woman and a youth. The woman, on
      the left, stands profile to the right, and holds a basket of wreaths, lekythoi, and fillets.
      The man, on the left, stands in 3/4-view to the left, wears a dark himation, and tilts his
      head down slightly while he places a fillet on the steps of a tomb.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

