    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/5a241e0a7e51b796b80900933c7eae7f9e77527f0517a1beb6e955c3a0033b20> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
