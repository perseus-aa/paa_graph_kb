    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/18e2af8d5eb92811eb50091419bf759368e7add20b47bddf00628fefabc7b906> a crm:E33_Linguistic_Object ;
