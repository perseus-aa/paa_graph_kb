<https://aa.perseus.org/id/text/14d375a62bb1068374685dc73a9e7e674eda5730c4ad14409f8e02e61eb6fff7> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Karouzou 1968, 154</bibl>; <bibl>Svoronos 1903-12, 545-46, pl. 86</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/14ddf10423d2fd9bc44f1d52396bb20260a1c517ce7cebf3d1afb25a1cac5ffa> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>An Ethiopian walks to the right, but faces left. His short
      curly hair is rendered in crude stippling, his skin is black. Dressed like an archer, he wears
      a sleeved jerkin with a fringe on the bottom and anaxyrides (trousers). Both are embroidered
      with stripes and dots. Over his left arm he has a garment with a meander border and fringe. In
      his right hand he wields a double axe. On the left is a table and on the right, a palm tree.
      The painting is in thick lines on a drab ground.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/14edab600f4d33657533edb6a036afe7de62ecb4ab496d96665e31e4e05fa464> a crm:E33_Linguistic_Object ;
