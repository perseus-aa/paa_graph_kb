    crm:P190_has_symbolic_content "Athena with diagonal aegis"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/34374957cb65c11e4c5b907597a97815aad87a938189aa90d2a9fe516c819d39> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Sides A and B: Gigantomachy. Athena attacking fallen giant. Int.: Potter in his
      workshop."""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/343da6cc1b297abede8440b8bdc098a92dbf91d2967bb702cab24865d1c805ce> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "A monumental building complex located in the north-east of the agora, originally circular in groundplan and probably an important public meeting place; later, the plan was transformed into a theater."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

