    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/e93fafb2c02b606ae3f4b51e7f3c17ac981318e1d65328db142aa8feb10c7885> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Comstock & Vermeule 1976, no. 338 (ill., with previous bibliography)</bibl>" ;
