<https://aa.perseus.org/id/text/35654fd0cc3af3e5cbfa5a6edaf46cb8c4da147f829914cc3913fd164f207e89> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Side A: Penelope and Telemachos<lb>Side B: Odysseus recognized by his
      nurse"""@en ;
