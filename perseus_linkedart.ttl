<https://aa.perseus.org/id/text/9b2b99d93ad12c2fa75e031c1216cd0761fcf11d9394cd51c50e83fccb5670b0> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
