<https://aa.perseus.org/id/text/bb8749b0662fb74bec849310b4b2044618a5cc53aff2f3fddd6c4b7bfd84349e> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>Broken and repaired, with some missing pieces restored and re-painted. Some
      areas misfired red, particularly the mouth and neck. Weathering of the added white, especially
      the panther.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/bb8c54fa95baef7b7bfebca95b2fd31ccb7e63fe6005ab2ec8bc978071d7fcd4> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>The surface of the base is worn and pitted, especially on side B. The black
      glaze is better preserved than are the red portions of the vase.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/bb9110219e97c88b93929094c37358eb250702ba1dc57b93abda827b396d2e24> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Svoronos 1903-12, 429-30, pl. 45</bibl>" ;
