    crm:P190_has_symbolic_content """<P>Unbroken; surface worn and pitted in places, most noticeable on the handles and
      adjacent areas on the body, and on the right-hand figures on either side. The glaze misfired
      red beneath both handles.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/8abbb9b2f15ad9ad12dbccbc276b98b13f623abe0f4e0c9509bea45b843686fc> a crm:E33_Linguistic_Object ;
