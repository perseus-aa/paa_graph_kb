<https://aa.perseus.org/id/text/20f9845f44459c0ce56958a8a825845a3743082522b933e8b4d155a8a1167f99> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<P><bibl>Olynthus, 8, 118-121, 141ff.</bibl>; other Olynthus volumes; unpublished excavation notes.</P>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/20fa014736fd37a5f9dbe11f0946687be574a21d344ad6820154a6ea3046cca9> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Tongue pattern, black bands and rays. The neck of the vase is
      glazed black with the rim reserved. A small, round molding separates the neck from the
      shoulder. Pendant rays decorate the shoulder of the vase. A series of wheel-painted black
      bands decorate the body of the vase, beginning just under the handles. There is a small, round
      molding at the juncture of the foot and body. A long tongue pattern covers the foot and base.
      The tongues are outlined in black glaze and alternately filled with purple and
      white.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/21116c693d9422b3926011566fb64ecd3e2c13f9bc10fac6d6fe7693cf777632> a crm:E33_Linguistic_Object ;
