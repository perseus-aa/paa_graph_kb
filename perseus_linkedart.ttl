      <bibl>LIMC, I, pl. 114, Achilleus 559</bibl>; <bibl>Beazley 1951,
      56</bibl>; <bibl>von Bothmer 1985, 130-131, n. 24</bibl>;
      <bibl>Mommsen 1975, 16, 30, 33, fn. 179, 47, fn. 239</bibl>; <bibl>Schefold
      1978, fig. 310</bibl></P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/a61ed4065e0b185cc2f7aa858d9c55a264e0da4496d2a79a8efc52762e941f5f> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """Chrysos (labelled), standing near profile to the right, wearing an
      oriental tunic with zig-zag sleeves, and a white taenia around his long hair, holds a chous in
      his lowered left hand, and his right hand at his side; a white Nike (with red wings)
      (labelled), driving a quadriga near profile to the right, wearing a chiton (?) flowing around
      her legs, a beaded necklace, a red taenia, red bead earrings, and two bands on each wrist,
      holds a whip and reins in her right hand, and reaches with her left hand to the (red or gold)
      wings of the (white) horses; a tripod atop a white pedestal; Ploutos (labelled), striding to
      the left, wearing a himation loosely draped over his right shoulder, held in his left hand,
      reaches to a tripod with his right hand.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/a62a7ff624d4a588c84d6fdb405a15cb5c24b4d9e25826e752be0093e0e421a9> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "On the flat, a bearded man running, with a lyre in his left hand and a cock in his right; on the convex, a beetle"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

