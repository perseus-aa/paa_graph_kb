<https://aa.perseus.org/id/text/e2f4c9da34924b94b9568f70a1cc981a3d3ecb5afc93ceeaa916c2511a751adc> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
