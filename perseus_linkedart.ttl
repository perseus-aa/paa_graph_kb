    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/e5bea040e6877e03c54bf05062672feca7e12349eeaa9b21a21f20cfca9a5207> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
