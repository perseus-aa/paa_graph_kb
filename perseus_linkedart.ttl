      63.3.</bibl>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/0a0a7c9506e2055210483e24fe87e972c37b5c803592ac84afef2332f4e1702b> a crm:E33_Linguistic_Object ;
