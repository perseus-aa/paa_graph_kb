    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/74947ac2b8cb4ca9ff301f121f8c682024b14f54c62fe462887554a36c6a341f> a crm:E33_Linguistic_Object ;
