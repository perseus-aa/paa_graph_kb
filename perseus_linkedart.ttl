<https://aa.perseus.org/id/text/631fc29953a32987c84853d6a24e07cb180c70783bfb6565d271c9a64c095e6e> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Narrow hall; on the north side of the Stoa at Artemision in the Sanctuary of Artemis."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/63245d7e5336ae1d495b645033546f0d6d25996866af8507a1a9b6b215355f70> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>White dot-rosettes mark the two rotellae flanking the handle,
      and they encircle the neck. A red band appears on the collar, and underneath it are four
      registers of animal processions, mostly lions, bulls, and ibexes, with black dot rosettes in
      the field behind. The lower body is surrounded by a ray
      pattern.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

