<https://aa.perseus.org/id/text/fbb781aaf45328d29a926586a9b8b95072b7bf46bfd1f3213ce0c01ed762e340> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Head of a horse with mane in low relief, incised eyes, and mouth slightly opened"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/fbc05e41a24c7841a35b1cacd6af108bbe54dae1a32bac744da9d88d887060c8> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>On shoulder: chariot race proceeding to right. Both teams of
      horses have their forelegs in the air and the rear team has all legs in the air. Below the
      leading team a dog runs to right. The horses have red manes and tails. The nearer trace horses
      have manes and chest bands. Both charioteers have red forelocks and wear long white chitons.
      Both charioteers hold a goad and reins. The losing charioteer has a red sash. In the
      background are grape vines.</P><P>Above, a band of lotus buds is seen, and at the
      sides, a band of net pattern. Below is a key pattern to left. A red stripe runs around the
      neck.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

