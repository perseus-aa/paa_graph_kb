<https://aa.perseus.org/id/text/b244e2360acbd0c1e6d8c0453097be21460a5498cac1e606180b9e3718cf15f4> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>CVA, USA 2, RISD 1, pp. 20-21, Pl.11:
      1a-b</bibl></P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/b245d2dbec3255fc570d32d5e2dd1fbdbe03f4d8f6c70f83a8a2b06f223f3d5a> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Sides A and B</hi>: Satyrs. <hi
      rend="ital">Int.</hi>: A young boy is shown fishing. He crouches in profile to the
      left on a rock on the right hand side of the composition. He is nude, and holds his fishing
      pole in his left hand and a small basket in the right. The rock juts above the water which
      extends to the left. The scene is depicted in such a way that one sees everything in the
      water: six fish (two of which look like small dolphins), a basket sitting on the sea floor,
      and a little black octopus hiding under the rock.</P><P>A partial inscription on
      the interior, near the boy's head, reads <foreign lang="Greek">*P*A . . .
      *S</foreign>.</P><P>Vermeule (180) states that the scene "shows life above
      and below the water line; the boy knows what he is doing, but cannot see everything, like the
      octopus hiding under the rock; the octopus knows what is being done, and circumvents
      it."</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

