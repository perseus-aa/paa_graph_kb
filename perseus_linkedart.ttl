<https://aa.perseus.org/id/text/e0fdf97f1b04072fc7575b9f82068c63b0661ea179d50fdf82a398782ec0783e> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Woman with bird. The woman stands in profile, facing right and
      holding a large striped bird in both arms. She wears a long Ionic style chiton with loose
      elbow sleeves and a himation over her left shoulder. Her hair is gathered up into a bandeau.
      Behind her is a stool with a decorated cushion, in front a small
      chest.</P><P>Where the neck and shoulder join there is an egg-and-dot band.
      Beneath this on the shoulder, there are three elaborate palmettes and blossoms. On front of
      the vase only, above and below the panel runs a band of running
      meanders.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/e11db1e7c24b17cd1feaeb167b971409bfb4f0a6d3fd4bd4f2f7b3bd924d07a1> a crm:E33_Linguistic_Object ;
