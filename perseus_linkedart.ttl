    crm:P190_has_symbolic_content "<bibl>Clairmont 1993, 1.9, cat. 7 (ill.)</bibl>; <bibl>Karouzou 1968, 120</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/74baa805ff85c196708e1c6311dff38658b4bef1527c4a489deaeafe81e88727> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Side A: Grape harvest<lb>Side B: A maenad between satyrs"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/74c5c3bfd2a36b908bb56d40e02dadc2a61793ca502c3d05d0221c02c93a434b> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
