    crm:P190_has_symbolic_content "<bibl>Vermeule & Comstock 1988, 77-78 no. 91</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/5fe19b0eed057bdbae786bb08ff1d87f5b6d4c0d80f260c2eee048998de496b3> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "A female figure seated on a rock, probably a Kekropid (Herse?)"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/5fefd0fe3adc2918bc38463c991700b9ed65be0d0709870d655913c459d2e165> a crm:E33_Linguistic_Object ;
