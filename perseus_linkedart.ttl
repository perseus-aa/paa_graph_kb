<https://aa.perseus.org/id/text/8f99a43f9d8678348444997518707afcc07f93542a88be5e70d999032c20062d> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Relief on an alliance decree between Athens and Peloponnesian states (Arcadia, Achaia, Elis, and Phleious)"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/8fa16308a8b62ea0a9a9c8361dadfe3b83003ae089c2f826db66a093428fd53c> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Int.</hi>: Hoplite blowing trumpet.
      In a reserved field, the hoplite runs to the right, raising a trumpet to his lips with his
      left hand. He wears a high crested helmet, a short chiton belted at the waist, a cloak, and
      greaves.</P><P>Walters (108) characterizes this work as careful, though not
      mannered drawing, with a generally restrained composition and sparing use of accessory colors,
      which is symptomatic of later stages of black figure vase
      painting.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/8fa192d679e537733c2a7dda355b5379c0f5172d069d3ef8257f5b4063a3962c> a crm:E33_Linguistic_Object ;
