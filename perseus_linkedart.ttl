<https://aa.perseus.org/id/text/e55ececf4980329cf86ff8a971adde5bb3bea5381923cda08a326e001b301cf9> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Herzfelder 1936</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/e56ed8e24c2cc2a53e6d8b627caf48f73e6c665a3dd46ee35e97d4b7b955f1e8> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Side A</hi>: Paris and Helen. Paris
      stands holding his horse as Helen approaches accompanied by a handmaiden. Helen occupies the
      approximate center of the scene. She stands with her head modestly tipped down. Both hands are
      raised as she pulls back her veil. She wears a transparent chiton, a thin mantle and sandals.
      Her maid stands with ankles crossed in a leaning pose, though there is nothing to lean
      against. She is pulling a piece of drapery forward to cover her head, and is naked but for a
      necklace and a wreath. Paris, on the left, wears a short cape knotted at his throat and a
      wreath over his hair, but is otherwise naked. He holds a spear in his right hand and firmly
      grips the reins of his horse in his left. An elaborate stand is positioned between Helen and
      the horse, and an object hangs between Helen and her maid. Below, an Erotes checks a dog in
      pursuit of a duck. The Erotes, holding the dog's leash, has fallen while trying to control
      him.</P><P><hi rend="ital">Side B</hi>: youths. Five youths stand in
      conversational attitudes. Each of the youths wears a mantle, with the exception of the middle
      youth who is nude. Four of the youths wear diadems with three vertical points in front; the
      right-hand youth wears a wreath. The central youth holds a wreath in his right
      hand.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/e574d5ee1473b94a99fa781f995dc0d5b6a1245038df388ba80e7489527b5e3e> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Brouskari 1974, 156, fig. 330 (left)</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/e585ee844a12d2ed7479c1472309fb5798860f408c7169bdabab8e7611d2add4> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Body:</hi> Iris (?) facing toward
      altar. Iris (?) flies towards an altar with a volute superstructure and dotted molding. She
      holds in both hands a large casket, decorated in black squares and wavy vertical lines at top
      and bottom, with a horizontal running meander pattern in the center. Fugitive lines around her
      shoulders show that although ostensibly nude, she was clothed with a transparent garment,
      probably chiton and himation. Her black hair is simply arranged.</P><P>On the
      shoulder there are five palmettes connected by tendrils. A running meander decorates the top
      of the body where it joins the shoulder.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/e58b2962ea6629f8e1c4d2a38d853255505cab7a922bfd04e504301e8f205bea> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Side A: A Samnite warrior leaning on a stele, between a woman and another
      warrior<lb>Side B: three youths"""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/e58e08571b8c5c81c8a43c5790d54d848d47fee4c41a1006f5f543ec6e4de1b7> a crm:E33_Linguistic_Object ;
