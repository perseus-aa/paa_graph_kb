<https://aa.perseus.org/id/text/62f9b8f55a16f3ea8fccc4db2a738a9e270c6db5e0ee03c19b2ae35b7fffe75d> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
