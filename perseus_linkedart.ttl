<https://aa.perseus.org/id/text/36700ef37743c9a6b7fc4e58aab4f7387e5d209fa9e2644561265d001a62f39a> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>The surface of the vase is chipped and peeling and there is some encrustation.
      Especially large chips are missing from the rim.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/367abfa439d81d7cfca76672503b69bf1a9ca4acde9930c31c8b1790bb9e48c8> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>On the interior, Aphrodite riding on her goose. Aphrodite sits
      in the crook of the goose's wing, as the goose flies effortlessly up and through the air. Like
      Exekias' earlier cup with Dionysos sailing (Munich 2044), Aphrodite is set in an empty white
      field, without ground line or spatial reference. She wears a bonnet, a long white chiton with
      purple ornament and a purple mantle, and sandals. Her left hand is curled in her lap; in her
      right she carries a stylized, curling branch or tendril.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/3683d8d8cb19210f46f4ef002440f535c7331be03efc2420a4788bf4d713a56d> a crm:E33_Linguistic_Object ;
