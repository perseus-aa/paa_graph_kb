    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/29a8f0e7a2d60fe3c37980700b81e3e15e46b6661031cff3908025d5bd1c5481> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
