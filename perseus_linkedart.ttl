<https://aa.perseus.org/id/text/7d897b515497ee3f9e3cecde7aa2ad692c08e8b0982bbcffb0efaec4a6ca43cd> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Concert in the open air: a faun and a nymph watching a dancing satyr"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/7d9cd1513b20bc14cd4e2f4d1c8c6c13612e9e6ef21ecf3c300061df9f1c0b2f> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Herakles and Nemean lion; Apollo and Herakles"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/7d9cfe0d77ff9350d6abbce4d2cfe3ae8f19f35c4d355caaca1e697d320da8f1> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>The body is divided into panels containing meanders, swastikas,
      checkerboard patterns, herringbone patterns and simple hatching. The bottom of the pyxis is
      decorated with an elaborate patterna curved swastika in the center of radiating circles filled
      with double lozenges. The effect is flame-like. Four horses stand side-by-side on the lid.
      They are painted black with reserved rectangular panels on their chests painted with
      dot-filled diamonds.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/7d9f94b47a63189dee457db01531d5c9b7646c1d4a386d99845041016e5f2b29> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>GuideDelphMu 1991</bibl>; <bibl>Stewart 1990, 128f.</bibl>; <bibl>Brinkmann 1985, 77ff.</bibl>; <bibl>Hurwit 1985, 295ff.</bibl>; <bibl>Watrous 1982</bibl>; <bibl>Boardman 1978a, 158</bibl>; <bibl>Ridgway 1977, 269ff. and elsewhere</bibl>; <bibl>Robertson 1975, 152 ff.</bibl>; <bibl>FdDelph 4.2, 57-171</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/7da32ced4674783c6112ca554c646807974e8f45c6ecc234da0ea27639584f42> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
