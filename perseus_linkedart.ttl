<https://aa.perseus.org/id/text/282ca5d513cfe66d95f3fbb626929bdbb809af1b00cea0449a1a5feb3f5a5172> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<P><bibl>Clairmont 1993, 1.470-71, cat. 1.862 (ill.)</bibl>; <bibl>Blmel 1966, no. 29</bibl></P>" ;
