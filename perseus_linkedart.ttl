<https://aa.perseus.org/id/text/4e1cfcc69832881bb9678b6db2f0388ac96162adccbc5a3b06e12292e2e622da> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Frieze of three standing swans alternating with large rosettes.
      A large rosette on bottom and top, dots around side of mouth. "Italo-corinthian"
      style.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/4e316af7e2c1e2cecc002ee84577dcede1dbc6bf4d71dfb2673d6ebe6be5bbf9> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Rectangular building; against the east wall of the Sanctuary of Apollo, just south of the mid-point."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/4e31994c7c3448955e757b42523a3fe41d6059503882386a3a4076166f4a1f58> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Interior, symposium (man reclining, singing, and youth playing the flute)<lb>Side
      A: Herakles and Linos<lb>Side B: men and youths"""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/4e37d101bb7a31d8d54f1063ad566b320dcaa07f16ad286d2c580e05d734807d> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """A female figure (perhaps Eudaimonia?), seated profile to the right,
      wearing a himation around her lower body, over a medium-sleeved, belted chiton, a sphendone,
      hoop earrings, and a beaded necklace, holds a string of beads between her upraised right hand
      and her lowered left hand; a female figure, probably Paidia (labelled), standing near frontal
      (slightly to the right), with her weight on her straight left leg, her right leg relaxed, and
      her head profile to the left, wearing a peplos belted over a long overfold, a high pony tail,
      and a beaded necklace, holds a short string of beads between her hands, which she raises in
      front of her chest; Aphrodite (labelled), standing 3/4-view to the right, wearing a belted,
      sleeveless chiton and a himation pulled over her head and shoulders, a beaded necklace, disk
      earrings (?), and a stephane, holds a scepter in her right hand, and an unidentifiable object
      over her left shoulder; Adonis (labelled), seated 3/4-view to the right, on his himation, with
      his left foot raised on a rock, his head profile to the left, wearing an olive wreath, rests
      his right hand on his seat, and in his left arm cradles a lyre; a nude, winged Eros, standing
      profile to the left, with his weight on his straight left leg, wearing a grain (?) wreath,
      holds a plate of fruit in both hands.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/4e37f92ed25e85293e9bff48cfbdbb3a54cfd364f13fe034592c85119a0fba8c> a crm:E33_Linguistic_Object ;
