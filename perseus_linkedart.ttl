    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/20f656d93ffd4dab423485e90af65a79f81d622d3539b56f543c085cbebead8f> a crm:E33_Linguistic_Object ;
