<https://aa.perseus.org/id/text/4431fd7d06c50fdfd7fe715bd7d1216fc38086aec74a66297a539d184196ca83> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Athlete with javelins and discus"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/4451719c6451262e4fc5dfbb7ed5577e74488f88dc61d5dd0373fea9168b33fe> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>The vase is plastically modeled in the shape of a black man's
      head. The neck of the vessel grows from the top of his head; at the back is a handle which
      runs from the rim of the vase to the top of his head. The modeling is accomplished; his nose,
      lips and hair are well-formed and veristic. "Wrinkles" have been etched in his forehead and at
      the corners of his eyes to give the appearance of age (Biers, 120). The whites of his eyes are
      painted white, and his lips, eyebrows, hair, and pupils are painted red.</P><P>On
      the neck of the vase is a Dionysiac scene. Dionysos sits to the right, holding a rhyton. He
      wears a white chiton and dark mantle, and is bearded. Before and behind him runs a satyr. In
      the field are vines and bunches of grapes, painted white. Near the handle are painted
      eyes.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/445422d05868e36853416eb2fb476e893bdb144b7118a7c93d314a0372e5f128> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Head, shoulders, and right side of warrior leaning forward."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/445846584da0b94ed76fa32f5b0724038b47fe24a7991af89b04a9e942b0aba2> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>G. Ahlberg-Cornell <hi rend="ital">Herakles and the Sea
      Monster in Attic Black-figure Vase-painting</hi> (Stockholm, 1984): 100, 105, fig.
      37</bibl>; <bibl>Boardman 1975, fig. 54</bibl>; <bibl>Bruhn 1943,
      113-114</bibl>; <bibl>Philippaki 1967, 2, pl.
      2</bibl></P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/445beca3b0b68aafea6e5308300a9ba90fae86a70bdfa143d131e49ffbe23d07> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content "<P>Some cracks have been repainted.</P>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/445c8f1cb100821cadffd894d823051a46733e30c5a668c020c0d573d7ee824f> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Side A</hi>: Zeus striding to the
      right, holding a lotus sceptre in his left hand and hurling a thunderbolt in the form of two
      lotus buds joined by a bar. He wears a himation and mantle which are actually typical of
      female dress in Late Nolan amphorae (Kurtz, 86).</P><P><hi rend="ital">Side
      B</hi>: Semele (?) runs to the right and looks back with a gesture of fear. She wears a
      bracelet on each wrist, and her dress is similar to that of Zeus.</P><P>Below the
      design on each side there is a band of broken, stopped meanders alternating with patterned
      squares (crosses and dotted saltires). Underneath the foot is an incised <foreign
      lang="Greek">*B</foreign>.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/44645a249f3e147d511fa88ca3ce5f3eefdbc9fc770a355b7f3633af4014ba09> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Rectangular market area in center of city, south of the North Market and the Bouleuterion. Bordered at the east by a long portico, and at the north and south by two L-shaped stoas."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/44721fec9c0b53c2a54b0a3bb1d2911af40d5ebaf3f4547a3725845a740d08cb> a crm:E33_Linguistic_Object ;
