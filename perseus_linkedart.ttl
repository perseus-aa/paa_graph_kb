<https://aa.perseus.org/id/text/66d78339318f56727184baca7a20f8facfcacd05ef08e3a4129c1a1b9bb1a650> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Perkins Collection 1902, 100, 2</bibl>; <hi rend=\"ital\"><bibl>BMCRR</bibl></hi> II, 335, no. 46 (with IIIIX in exergue)" ;
