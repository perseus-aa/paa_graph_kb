<https://aa.perseus.org/id/text/a505d9e2dc4645de6e248db39622c70575f48728769d49c5010ad5323196cfa2> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Tondo</hi>: injured stag with spear
      in back, emerging from right shoulder.</P><P><hi rend="ital">Exterior: Side
      A</hi>: in band, inscription <foreign lang="Greek">*T*L*E*S*O*N *O *N*E*A*R*X*O
      *E*P*O*E*S*E*N</foreign> ("Tleson the son of Nearchos made it"). <hi
      rend="ital">Side B:</hi> in band, <foreign lang="Greek">*T*L*E*S*O*N *O*E
      *N*E*A*R*X*O *E*P*O*E*S*E*N</foreign> (the same, slightly different spelling). Palmettes
      to either side of handles.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

