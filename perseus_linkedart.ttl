    crm:P190_has_symbolic_content """<bibl>Kurtz 1983, pp. 94-95</bibl>; <bibl>Boardman 1985b,
      94-95</bibl>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/e5973c8a5245e45ce7a635f08b1afc676d74d72e6ee66eb857fa3f18ebf5b319> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Hand (of Nike?) holding a helmet"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/e598564baee5491164d44eb8965479ca1a8002f85f40cc0a0fc18d8e4e418593> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content "<P>Side B misfired.</P>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/e5a1b365c9ae853546389bc873a878809b20447e98c0c94cbf443c091f37750d> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Flying Nike. She flies to the right with outstretched frontal
      wings. In her right hand she holds a phiale, in her left a long incense-stand. She wears a
      long Ionic chiton, broken into many folds and with elbow sleeves, the right sleeve billowing
      with the breeze just before her descent. A himation falls down in heavy folds from her
      shoulder and ends in swallow-tail plaits. Her hair is covered with a netted sakkos or snood,
      curling up to a point at the back. In her ears are drop earrings, and on her right arm is a
      bracelet. On top of the sakkos is a diadem.</P><P>Where the neck joins the
      shoulder there is an egg-and-dot band, beneath which are elaborate ribbed palmettes and buds,
      joined by tendrils. Above and below the design panel is a band of meanders punctuated by
      squares with dotted crosses.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/e5a80cef081cde8ee1d7503615071712d4c3d4a7d80e742d4d4f29d0d9241892> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Zanker 1995, 36-37, fig. 23, 348 no. 56</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/e5aca3c17138db323785566ea51df3ebdc7d326f3e56b11ca6a2ec433b656060> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Clairmont 1993, 3.314-15, cat. 3.410</bibl>; <bibl>Karouzou 1968, 117</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/e5b73f9d641150ffa198e6e1532dabc47c112d8acf9785c233f56e31b28cddd3> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """A: A female figure, a youth (Iolaos?), standing 3/4-view to the right,
      carrying two spears, Athena, Herakles, a bull, behind him a female figure, Krete (labelled in
      retrograde red dipinti) fleeing to the right (only the foot and the bottom of drapery are
      preserved) near a male figure (Minos?), standing profile to the left; under each handle sits a
      quietly seated female figure, with her back to the scene (local deities [Shefton], nymphs, or
      Europe and Pasiphae [Vollkommer]).""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/e5b9b3200bdf4df02ec001088cc01db0841b28c6265e24fe552ddc78d9a0c293> a crm:E33_Linguistic_Object ;
