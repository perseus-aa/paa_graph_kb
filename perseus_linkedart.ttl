<https://aa.perseus.org/id/text/8900280bb088a136f8cc64846353343adb456430120d25f385a94333059f109e> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Interior: lovers (woman and old man)<lb>Side A: Herakles and
      Eurystheus<lb>Side B: chariot, young driver, warrior (Odysseus?), Hermes"""@en ;
