<https://aa.perseus.org/id/text/72550eb1aec6e75cd0e411b3bd3c92700cfb4921ca301e023513c38cf6eab5d5> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "A. Ajootian in <bibl>Palagia & Pollitt 1996, 122-24</bibl>; <bibl>Stewart 1990, 177, 279, figs. 492-94</bibl>" ;
