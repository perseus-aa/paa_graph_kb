<https://aa.perseus.org/id/text/c4da87a4c04b89c2016d2a46cde508d78bcc82bb0c6977311e335c974abc1bc5> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Tondo: boxer."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/c4db355927a5fdf889c6211455d25730e4f8e6ee6685396f6f9bda11ffb49ebb> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Lip cup. Side A: a siren stands at left with upraised wings,
      and faces a sphinx with its right paw in the air. Both have white female faces and white
      breasts. There are touches of added white and red on the wings. Both wear red fillets. Side B:
      same.</P><P>In the handle zone are palmettes linked by tendrils to the handle
      bases.</P><P>Tondo: reserved circle with black
      circle.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/c4dc73048e53a5834ad2d8b04e42472140aeb1e81c0af9e73e1072df6b603c1c> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<P><bibl>PECS, 739-740</bibl>; <bibl>Leekley and Noyes 1975, 94</bibl>; <bibl>Cameron 1988, 137-138</bibl></P>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

