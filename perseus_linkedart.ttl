<https://aa.perseus.org/id/text/4591bdb64190750e486b0748c5a46d6f2ba9eb1d2cef03c7266dcfc17c43e855> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">BMCRE</hi></bibl> III, 169, no. 796 (obv. variable) " ;
