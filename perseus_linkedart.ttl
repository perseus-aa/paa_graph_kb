<https://aa.perseus.org/id/text/971a670c0328978e1073bbc14f8e355b8a219ef51467d88b640dc95281754683> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<P><bibl>Lattimore 1979, 73 no. 15, pl. 8.20-23</bibl>; <bibl>Vierneisel-Schlrb 1979, 425</bibl></P>" ;
