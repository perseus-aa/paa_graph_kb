<https://aa.perseus.org/id/text/81957f44e994e81d22026c63e6a66028f0d644b68e9d6ea84ef2956f2da193e4> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Side A</hi>: A nude athlete crowned
      with a myrrh wreath is depicted standing to the left, holding a discus raised behind his head.
      Below his right arm is the vertical inscription painted retrograde in red: <foreign
      lang="Greek">*S*O*K*R*A*T*E*S*K*A*L*O*S</foreign> ("Socrates is
      beautiful").</P><P><hi rend="ital">Side B</hi>: A youth dressed in a
      red mantle is standing to the left, holding a burled stick in his right hand. His left hand is
      stretched out in front of him.</P><P>Both figures are standing on a short band of
      red meanders. The vase is an early work of the Berlin painter. The name Sokrates appears only
      once more on another, even earlier, vase of this artist, which is now in St. Petersburg
      (<rs type="vase">St. Petersburg 635</rs>).</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/819afbca0baebafa1df986de9e90ef4ab42562beed07e602c00750b3ba3cec45> a crm:E33_Linguistic_Object ;
