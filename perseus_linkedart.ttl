    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/f049acdd27ec5f48782f325096f3b88279a3ba869b1a20bb6c0ab7f0726a90ed> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
