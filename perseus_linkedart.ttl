<https://aa.perseus.org/id/text/f9b97fa5f92bbb12ec7066f3feee44f3c77c86dae2f5563ec7ea268109b2488e> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>GuideDelphMu 1991, 33ff.</bibl>; <bibl>Jeffery 1990, 154ff.</bibl>; <bibl>Stewart 1990, 109,112</bibl>; <bibl>Faure 1985, 56ff.</bibl>; <bibl>Hurwit 1985, 200ff.</bibl>; <bibl>Vatin 1982, 509ff.</bibl>; <bibl>Boardman 1978a, fig. 70</bibl>; <bibl>Vatin 1977, 13ff.</bibl>; <bibl>Robertson 1975, 46</bibl>; <bibl>FdDelph 4.1, 5ff.</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/f9bde1fc03ff1c03fab26ca0ef0e89c18e7cde20c8aed85967dbf3df56734f0a> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Side A</hi>: Nike, the winged
      goddess of victory, walks left and pours an offering of wine to the sea god Poseidon, who sits
      at the left on a throne. He holds a trident in his left hand and a phiale in his right. <hi
      rend="ital">Side B</hi>: A woman at left runs to the right with her right arm
      outstretched to a bearded man holding a spear. Palmette pattern appears under the rim. Under
      the scene is a meander band.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/f9cf898798f20b359f630bd75e614c990bf2926cf7358b51ec1df069c0b051ca> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Warrior and woman at a tomb."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/f9e3bb5c2550d3af9b7eb9ee04d9c49a6c4d8a860bf364d5c66ce25e18552264> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Side A</hi>: Apollo on a swan, with
      two women and a satyr. A palm tree with bunches of fruit rises from a small mound in the
      center of the scene. From the left, Apollo is descending to earth seated on a swan and playing
      a lyre. He wears a laurel-wreath in his hair, held by a broad fillet, a chlamys bordered with
      a broad stripe, and high, elaborately tied sandals. The swan flies with wings held high and
      legs outstretched as it prepares to land. To the right of the palm tree, a maenad sits facing
      right, but turns her head to the left to watch Apollo's approach. She is wearing a chiton with
      an embroidered hem and overfold, a spiked crown, and a necklace and bracelet, and holds a lyre
      in her left arm. To her right is a naked satyr facing left, holding a thyrsos at his side in
      his left hand. In his right hand is a fillet, which he holds over the head of the seated
      maenad. He wears a garland in his hair. Above the outstretched arm of the satyr is a broad
      semi-circle, perhaps a hanging garland. A second maenad occupies the left-hand side of the
      scene. She is leaning on her left foot which rests on a rock, and has picked up a fillet with
      her left hand. She is dressed similarly to the other maenad. A hare stands in front of her,
      just below the tail of the descending swan. Yellow is used for many of the ornaments and
      details in the scene.</P><P><hi rend="ital">Side B</hi>: Eros and two
      athletes.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/f9ea8e91818912278789d92f0e1fa05659a4b84f0a456623c3f09e6fa58f0a97> a crm:E33_Linguistic_Object ;
