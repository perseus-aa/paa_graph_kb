    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/2ae03e510abc144da7a5e59647b4f34a419dfb7fd334f7b448be7545087c6154> a crm:E33_Linguistic_Object ;
