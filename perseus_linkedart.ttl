<https://aa.perseus.org/id/text/01f55ee77c47003382e81d0251190f9a6f20840f7054bece989281aed9139d02> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Upper frieze: Panels of simple maeander with horse, checkerboard, and crosshatched
      patterns over the handles<lb>Handle zone: Birds, standing profile to right, with
      diagonal rows of "birdseeds" between them<lb>Stand: Alternating panels of checkerboards
      and crosses"""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

