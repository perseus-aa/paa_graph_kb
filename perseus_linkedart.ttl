<https://aa.perseus.org/id/text/e90c5239ec9269979d0f0cc0e0032dd5b239ab6c0ef4a19211279f246403bb9a> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
