<https://aa.perseus.org/id/text/126ce13c58aaa1f3bc22a08b9e57484440c1ccb2f674d75133916b9514fa73b2> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="head">Neck:</hi> side A: sphinxes, side
      B: panther and ram.</P><P><hi rend="head">Side A:</hi> Achilles and
      Hektor fighting over the body of Troilos, with rounded altar in front of Troilos. To left,
      Hermes and Athena. To right, Aeneas, Deithynos and hoplite. Achilles, Hektor, Troilos, Aeneas,
      Deithynos and altar are labelled.</P><P><hi rend="head">Side B:</hi>
      sphinxes between swans.</P><P><hi rend="head">Below:</hi> side A:
      sirens between panthers, side B: a naked youth running, between panthers, themselves flanked
      by goats. <hi rend="head">Lowest panel:</hi>
      animals.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

