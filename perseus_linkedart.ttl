<https://aa.perseus.org/id/text/fc63ab529acf45703ca69d34eb2eadd93ec91a89158cf1d8e1348397c40ecd69> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Tondo</hi>: youthful reveler with
      body front balances himself on one bent leg and his walking stick. He holds a large kylix with
      his left hand. His wreathed head is in profile to the left. <foreign
      lang="Greek">*K*A*L*O*S</foreign> (beautiful) is written in the upper right. A
      meander is used as the tondo border.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/fc68e76a61d2ad8c01eea96bbbcfd6861039b9dbf49f8d4b6588e250b8a59a71> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>Some of the lekythos fragments are in excellent condition, while others are
      worn and faded; the black glaze on one large fragment toward the back of the vase is
      completely worn away.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/fc74dd766462f8c4be471243b33c5357dbeedb57765ca1cb8abfed57a1ab8339> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Side A: Dionysos, satyrs, maenads<lb>Side B: Satyrs and
      maenads<lb>Interior: Satyr and maenad"""@en ;
