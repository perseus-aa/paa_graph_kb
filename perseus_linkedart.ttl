<https://aa.perseus.org/id/text/f43fdec35212e28ab3508634b11ddb114073b7b816153fb5931f63b9afd078a7> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Blmel 1964, no. 50 (with full bib.)</bibl>; <bibl>Mendel, I: nos. 248-249</bibl>" ;
