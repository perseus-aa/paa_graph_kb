<https://aa.perseus.org/id/text/75b39d690b8d27f325672a5decb4331a161de45b8d53783e164b39fcbdec7a20> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Interior: Satyr. Side A: Dionysos with satyr and maenad. Side B: Satyr and
      maenads."""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/75b8cb38ae85b7a7f3821a1946378544578c0252913347a1734c7f079fa2cab1> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Kephalion and a woman shaking hands, in front of a tomb, while two other women (and a baby) look on"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/75b8f30745adacf37e620ba3b297d9db572ebc2f9f3a6c01f8bb99f6768af2bc> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Herakles attacks a lion to right, holding the lion in his left
      hand and with his club in his right hand swung back. He wears a short belted chiton, and a
      sword hangs at his left side. He is beardless and has red hair. The lion rears on one leg; his
      right paw touches Herakles' left arm. The lion looks away from Herakles, his mouth open. Two
      figures flank the main scene on either side. At right, a nude youth (Iolaos?) walks to right
      and looks back to the lion. The youth has a sword and holds a club. He wears a red fillet.
      Beyond the youth to right, stands a man facing right, wearing a himation and holding a staff,
      probably a trainer. Behind Herakles at left a woman stands to right wearing a peplos and red
      fillet. The upper part of her peplos is red. To the left of the woman, a nude youth runs to
      right and looks back to left, and carries a javelin. Red stripes appear above and below
      scene.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/75be09a5d0824c1cc1d27b97373b70e5f6195f2e793e4688ab694828c034944a> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
