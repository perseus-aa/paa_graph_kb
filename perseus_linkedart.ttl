<https://aa.perseus.org/id/text/925bfe9b2840d900c089cd293b1f943343855c8674dbb16b760dd978b45c647a> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Busts of a woman with a tall coiffure and her young son, shown within a curved niche, with an inscription below"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/92652b9ffc8fac55dbd1e94476ca28b1e388adb5b2fde8167a18f741183aed94> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Int.</hi>: The interior of the
      vessel is decorated with alternate concentric bands of black paint and reserved
      area.</P><P><hi rend="ital">Ext.</hi>: Forty-three snakes are still
      visible on the exterior of the cup. They are gathered with tails toward the base, heads
      fanning out toward the rim, at each side of the vessel between the handles. The snakes' scales
      are incised.</P><P>There is a similar vase that was excavated from a tomb in
      Rhitsona (Ure, 53, no. 50, pl. 16).</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/92671b7b1f1171baf017d7ac765684b94acb6d73f641d2005c65b7397e9cca67> a crm:E33_Linguistic_Object ;
