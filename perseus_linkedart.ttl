<https://aa.perseus.org/id/text/45eb2095da5f0e93fb515e6526dcfd1030df74c8e3340cabc88543084ff068ed> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">RIC</hi></bibl> IV.2, 156, no. 9; <bibl>Cohen 1880-1892, 4.526, 12</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/45eed942e2af974c6e56922203755dc2916fb2dcc478df68d8db2492180b6967> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>he base and palmette suggest that this sphinx serves here, as
      elsewhere, as a guardian of the dead, which is an appropriate decoration for an oil flask, or
      lekythos, which was customarily used as a grave offering.</P><P>The shoulder bears
      a reserved band with five black palmettes, below a tongue frieze. A short maeander frieze,
      between two red bands, serves as the ground line for the sphinx. Added red is used for the
      fillet worn by the sphinx.</P><P>Characteristics of the style of the Bowdoin
      Painter that are exhibited in this vase include the use of a continuous line to represent the
      nose and the forehead and a wide eye, with curved upper lid and straight lower
      lid.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/45f555e8d56221a006d6c6974fa196c34bcf28b391d3fc890bc49a7261c8bfc6> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Bruneau 1983, 61</bibl>; <bibl>Richter 1970b, 105 no. 111, figs. 342, 345</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/45f910ebf20711e352b2b03d4a8f9ba7409b4fc8eff2e9b7632d1d7f79f8ef21> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>The surface is chipped and somewhat discolored. Most of the white paint is
      intact.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

