<https://aa.perseus.org/id/text/fa7ef3cb3f1889f0ad6f582e1939dc522c9a5da0153caeb9f83e53a02c09aee3> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<hi rend=\"ital\"><bibl>BMCRR</bibl></hi> I, 82, no. 623; pl. 20.6; <hi rend=\"ital\"><bibl>RRC</bibl></hi> no. 147/1, pl. XXV" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/fa88f2e95229ddab905daf2e85b1e726c1646c0a35dcc5984bdbd7a6b53b74ae> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Interior: lion to right. The lion's left forepaw is raised and
      his mouth is open. Below the lion's legs stands a swan. Flying to the left above is an eagle.
      In the field is a dotted circle and palmette.</P><P>There are palmettes by the
      handle bases. Black and red stripes, a band of rays, and a band of dots around the foot-body
      juncture complete the vessel's decoration.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/fa9f145f4d2c72ddb6e5481e5a0034db03e91c7b1d5f82251eadf1cb49487ef2> a crm:E33_Linguistic_Object ;
