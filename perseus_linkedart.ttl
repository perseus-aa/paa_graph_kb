    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/b9db0b02c9e4111deaa3e440054e3e3baa2950f72e0b9b9366f4fd65f4c1302d> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Top frieze: Troilos and Polyxena at the fountain; Centauromachy; komos; return of
      Hephaistos; symposium<lb>Main frieze: a hoplite and infantry battle<lb>Bottom
      frieze: a horse race"""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/b9e5cf79153b103e42f6535bc08e96c18693cfec0f3177979be817a18f3fd312> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<bibl>Burke & Pollitt 1975, 26-28 no. 31 (ill.)</bibl>;
      <bibl>ABL, 21 no. 3</bibl>""" ;
