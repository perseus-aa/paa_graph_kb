<https://aa.perseus.org/id/text/f6c530a87fed5926f49057940b8ffed661c7ee6bb66661cc468e13776e0936df> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Lid: two leopards on either side, one pursuing a hare, another
      pouncing on a swan or waterbird. Circles and coiling tendrils decorate the field. There are
      rays on the edge of the lid. The body is decorated by laurel
      wreaths.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/f6cb30195510ad86d79482c26bc2c12c1a8d451f6d6a0b80d8d2f8e472b8f747> a crm:E33_Linguistic_Object ;
