<https://aa.perseus.org/id/text/7f14ff5c345d23b9c2e837ea296b80c64f10ca603d767d2ca407ebbb1ef157b2> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>Moon 1983, 97-118</bibl>; <bibl>Hurwit 1991,
      33-62</bibl></P>""" ;
