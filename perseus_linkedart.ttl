<https://aa.perseus.org/id/text/185affa2aebceb1e42e6756e188bd7fb1fee95f2761ccd4d81fedd4512455cc4> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<bibl>LIMC</bibl>, 7.244 s.v. Peitho no. 5 (N. Icard-Gianolio);
