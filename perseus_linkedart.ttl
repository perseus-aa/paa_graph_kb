<https://aa.perseus.org/id/text/9dc488665cfb5ca37b01209bf0b5fced07c215864080916459e447d462d43206> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Standing female figure in peplos with diagonal quiver strap"@en ;
