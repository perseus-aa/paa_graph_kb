<https://aa.perseus.org/id/text/806148cfa8cd37e3f9bdfacf42f1fd9ba05b1d482fa56c0f27b8054b7bcf6172> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Side A</hi>: Herakles battling the
      centaur Nessos in the center of a group of four men. Herakles' left hand touches centaur's
      flank. Nessos holds stone in left hand. At left, nude man and draped man. At right, Iolaos
      with bow and quiver. Fawn and draped man to right.</P><P><hi
      rend="ital">Side B</hi>: Theseus in combat with the Minotaur, flanked by draped men.
      Theseus grasps Minotaur's horn and Minotaur grasps Theseus' club. At left edge, nude man
      facing in; at right edge, nude man running to right with head turned back. Three men look on
      and fourth runs away.</P><P><hi rend="ital">Neck</hi>: Side A: three
      dancing men. Side B: three men dancing, central figure wearing chlamys.</P><P>On
      upper shoulder, alternating black and red tongues with lotus bud chain below. Rays on lower
      body above foot. Flying bird beneath one handle; small cauldron on high stand beneath the
      other.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/80623acd2c9d51d2499b446e70bd03385fa04757cbc045ec94e79b54ebdb922d> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>A small hole in the right side of the neck has been replastered and repainted.
      Most painted decoration is worn.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/806fa0fba8cf82709a264aa8caa4dab95c6fbeaff399b04e2ac888647e35f613> a crm:E33_Linguistic_Object ;
