<https://aa.perseus.org/id/text/da71decd639d76c700f1549a0b7887091c376bbeb463655500a83194b4d28b27> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>The surface of the pyxis is chipped and scratched, especially on the bottom and
      in the interior. The lid and exterior of the body are in good condition.</P>""" ;
