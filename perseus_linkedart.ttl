<https://aa.perseus.org/id/text/8fde5ef4c9c9f440e290fd478cda34b006aff74b529e46d602eb3246b30bda43> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Shoulder: boxers, main zone: maenads and satyrs."@en ;
