    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/1d1ee062fdfafaa0cecfcc28f2fe3de7cffbf0610d2abd2c2ea09113be1cb0be> a crm:E33_Linguistic_Object ;
