<https://aa.perseus.org/id/text/be44885612a581dfc0cb2bdeb2f242228caf5f2dcce2f7151c1e065ed4ee0f21> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Svoronos 1903-12, 507-508, pl. 183</bibl>" ;
