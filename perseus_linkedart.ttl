<https://aa.perseus.org/id/text/da7863eeb8c95ba48c3c0f13d668900a93376e6bdb9f5d9ec8ff4f194304347a> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
