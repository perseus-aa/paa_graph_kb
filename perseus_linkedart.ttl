<https://aa.perseus.org/id/text/80544f08fa92e461ca7a973289b31802d087b760ef288d0d240a641b14c11b23> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Svoronos 1903-12, 632, pl. 130.9</bibl>" ;
