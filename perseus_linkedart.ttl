<https://aa.perseus.org/id/text/77c65b90c20b59a4398be290c6e9689a5dc5d52ad3d822d5501c8eb26a0617ba> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="head">Side A:</hi> Between the eyes, a
      satyr is seated frontally playing a flute. <hi rend="head">Side B:</hi> The like.
      <hi rend="head">Interior</hi>: A gorgoneion decorates the interior of the cup.
      Vine scrolls decorate the handles. The foot profile is
      black.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

