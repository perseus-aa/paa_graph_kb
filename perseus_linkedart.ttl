<https://aa.perseus.org/id/text/a7e3908a530130d196b0c58cce8951deb0c42f931342ab14cdcd5e60490b1f85> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>Coldstream 1968, 201-204</bibl>; <bibl>Fairbanks
      1928, no. 287, pl. 25</bibl></P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/a7e4b810ba1054689c6c272ec8ef5fe975159fff4c4a0b5fcefab9cda7195159> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="head">Side A</hi>: Dionysos, maenad and a
      goat. Dionysos and the maenad stand facing one another, the long-horned goat between them and
      partially hidden behind Dionysos' mantle. Dionysos, on the left, holds up a kyathos in his
      left hand and reaches toward the maenad with his right. She is leaning away, her weight on her
      back right foot, and her head bent forward. She holds an unidentified object in her right
      hand, and holds her left hand at her chest. Dionysos is bearded and has a fillet bound over
      his long hair, and he wears a long white chiton and a black mantle. The maenad is wearing a
      long black chiton, an animal skin draped diagonally, and a short cape. A wreath of grape
      leaves sits atop her head, and her long hair falls down her back. A grape vine springs from
      the ground by Dionysos' feet. It grows behind and around him and continues along the top of
      the scene, with some of the vines falling between the two figures.</P><P><hi
      rend="head">Side B</hi>: Athena arming. Athena and a handmaiden stand facing one
      another. Athena, on the left, is helmeted and holds a long staff in her left hand. The rest of
      her body is not preserved, but a shield can be seen resting behind her on the left. The maid
      helping Athena holds her shield ready. She is wearing a black garment and wears her hair long,
      one tendril falling in front of her shoulder.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/a7e7f0ae9c24045cda07d7233450e525f4c761939523d71c54400417df3dff0d> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<P><bibl>Leekley and Noyes 1976, 26-27</bibl>; <bibl>PECS, 915-16</bibl>; <bibl>Rossiter 1977, 203-204</bibl></P>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/a7ed1270866cede11b7cd0a294225b92ba5277dffa4c9a37e6b2030cb5bab102> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Three nymphs led by Hermes in a dance"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/a7ef95171b590ffbfc6ef9bcd021e9e3354c1e99c40b73819e52bcb2fbf5c3cc> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<P><bibl>E. Vermeule 1965, 34-39</bibl></P>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/a7f2a74c423aa9e6f2c23fe52cdb4f0e0e548c3d5b9305c91de1ba1106a77c54> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content "<P>The vase was restored by Terry Longyear in 1981.</P>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/a7f33adacdc6c30f271519d80c429bdbf639abfcc6db9c8e2464e83faa269584> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>A nude young hunter is returning home. He walks to the right
      with a pole over his left shoulder, from which are suspended a fox (left) and a hare (right).
      The pelt of both animals is tinted with dilute glaze, the rabbit's scumbled to suggest its
      furrier texture. The youth touches the fox with his right hand while twisting around to look
      backwards. A cloak with a black border is draped over his arms.</P><P>The shoulder
      as well as the upper two thirds of the body are coated with white slip; the lower body is
      black, with two reserved stripes. At the base of the neck is a band of simple, unframed
      tongues. On the shoulder are five linked black palmettes, the middle one pointing downwards,
      the others up. Above the figure is a band of key pattern to right, framed by paired black
      stripes that continue around the body. On either side of the figure is a pair of large
      palmettes, vertical and addorsed, which are linked and enclosed by a common tendril (it is
      these that give Side-palmette Lekythoi their name). The riser of the foot is reserved, the
      lower fillet black. The mouth and the outside of the handle are
      black.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/a7f6976cee7c1d07a92fbf0e898309d4e4eeb24ad9c754322ee2322a6ff5951c> a crm:E33_Linguistic_Object ;
