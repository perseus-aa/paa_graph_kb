<https://aa.perseus.org/id/text/0773fd335b0aa088750b7bba26caf8c4f41b1d19b5aa50d49c46b240dd4ef3d2> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>Smith 1896, 183</bibl>; <bibl>CVA, 6, 9, pl. 97,
      3</bibl></P>""" ;
