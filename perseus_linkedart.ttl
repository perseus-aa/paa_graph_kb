<https://aa.perseus.org/id/text/30839172ff806e7d1e0a58a5025e46660ce4d9b546e20bf24e10e4cc018630e1> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Shear 1971, 271-2</bibl>; <bibl>Camp 1986, 121-2</bibl>; <bibl>Agora Guide 1990, 204-5</bibl>" ;
