<https://aa.perseus.org/id/text/50df6ce79d09beb7ccb2f71fd01b071faa39d83da46b75dc06ccce38a390a80d> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Zanker 1995, 71, fig. 41</bibl>; <bibl>Richter 1984, 96-97, fig. 62</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/50e3b0bdb841fc720f3753e7b34b8dc8a9b21bb9fc13c42be1824a606674dabc> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<bibl>Matheson 1995</bibl>, 424, no. KLM 16; <bibl>Matheson
      1994</bibl>, 358-59; <bibl>Clinton 1992</bibl>, 124, figs. 11-14;
      <bibl>Hayashi 1992, cat. no. 102</bibl>; <bibl>Shapiro 1988</bibl>,
      206; I. and A. Raubitschek, "The Mission of Triptolemos," in <hi rend="ital">Studies in
      Athenian Architecture, Sculpture and Topography Presented to H.A. Thompson. Hesperia
      Suppl</hi>. 20 (1982) pls. 15-16; <bibl>LIMC</bibl>, 4.s.v. Demeter no. 364
      (L. Beschi); <hi rend="ital">MuM</hi> 40 (1969) 65, no. 108.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

