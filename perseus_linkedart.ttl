<https://aa.perseus.org/id/text/f26e36a09616d522cd3e4ff7cc3c7d891c3b66e18773de0a1034d75bfb7eb1db> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>A bearded traveller sits on a rock, facing right. He holds his
      left knee in his hands. He wears a chlamys, petasos, and shoes with striped leggings. In front
      of him is his bundle of gear, tied to a stick; one item is clearly a mug like this one. The
      subject thus alludes to the intended use as a traveling cup. The groundline is a simple
      reserved stripe, which circles the lower body. The side of the foot is
      reserved.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/f27fd69f59140f6b4f64d177b44ea2041a65e8b18d5d1b39d7b2d9d7e5609a73> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">BMCRE</hi></bibl> II, 51, nos. 290 ff., pl. 8.20" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

