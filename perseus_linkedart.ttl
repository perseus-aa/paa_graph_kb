<https://aa.perseus.org/id/text/4c0de2f50ba4dd23520740e2addb132e78f4de0be5d82f3f4e9c04a3f952ac17> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Tondo:</hi> A stag trots to the
      right, none of its feet touching the plain reserved circle that forms the border of the scene.
      The resting surface of the foot is reserved and offset from the glazed
      underside.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

