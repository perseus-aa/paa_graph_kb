    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/1e30cf2a4eef6155ae1a44163fb1cccc1af454c0c05f8dc68e7a40e40e9ac271> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
