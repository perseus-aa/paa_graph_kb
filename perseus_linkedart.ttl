    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/a091e654319e1613eeb104cf022035077cc3307d1f31a032699cde20c66fae3b> a crm:E33_Linguistic_Object ;
