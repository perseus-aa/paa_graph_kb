<https://aa.perseus.org/id/text/57cb067ccaa88c9e77df16c8d24415787034b60b052ccf43261a819a96e6c44a> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Hermary 1984, 24 no. 12, pl. 11 (with previous bibliography)</bibl>; <bibl>Bruneau 1983, 68</bibl>; <bibl>Ridgway 1983, 61</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/57cbb23ffc283af4eb939288607d2b087761cf6e6079e24d61e4f9eb5ffaac06> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>A profile cock, facing right, left wing raised and flapping,
      right wing at side. Two of his tail feathers stretch around in back almost as far as the tip
      of his left wing. The comb, wattles, and parts of the wings are in added red. In the field
      there are large and small incised rosettes and small incised blobs. The rosette above his left
      wing has both interior incision and an incised contour. Rays or tongues occur at the top of
      lip, on the neck, and on the bottom. There are dots around the edge of the
      lip.</P><P>Accessories are rendered in added red. Firm, hasty incisions are used
      for details.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

