<https://aa.perseus.org/id/text/7ea2daebe24b9663f4e588acc9b6622084a5d68d5317cb75c808c24b649ed8eb> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Female figure, wearing a chiton belted over an overfold and a himation, seated on a rock to the right."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/7eac0579d87c8ff5eea0df8d3e3e564771f524d2181d1d57a6b841c5e8637cce> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Comstock & Vermeule 1976, no. 382 (ill., with previous bibliography)</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/7eb29cf6546ba0a74c846860177b014694a958e5b7e9de55a08cc9969dc4c768> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Side A: sphinx seated to right looking left. There is a broad
      red stripe on its wing, a double red fillet in its hair, and a coiling tendril emerging from
      top of its head. The face and breasts in added white are flaked off. A rosette appears in the
      field.</P><P>Side B: youth mounted on horse walking to right. The youth holds the
      reins in both hands and a stick in one hand. He has red hair and a red circle around his
      nipple. The horse has a red mane and tail. A tendril is seen below the horse and a rosette
      above.</P><P>There are lotus buds on the neck and rays at the base. Two red
      stripes run around the lower body, and one inside the
      mouth.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

