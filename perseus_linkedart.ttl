<https://aa.perseus.org/id/text/004c753b1cc27e5b434140b6ef69238f6e9a0e9a45da0a718f7dd5d34c283941> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>The surface has suffered slight discoloration and chipping, especially in the
      areas of added red paint. A circular misfired red area on the breasts of the central horses on
      Side A perhaps indicates that this vase had contact with another during the firing
      process.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

