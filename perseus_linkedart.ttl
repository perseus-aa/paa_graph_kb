<https://aa.perseus.org/id/text/dd2bece7135bde63b76f5cc271dcd86557f7fafc0dfc11eb036a7cde3b5668b8> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Exterior</hi>: Perseus with sword
      and winged boots pursues the three Gorgons. Stylized ivy vines throughout background. Details
      such as Gorgons' tongues, belts, boots, and wing feathers are highlighted with added red and
      white.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

