    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/a4e8d4926616a83d3d58f6ddfa9e5f5aaddaba5dfc644e44c171a98cc2078b1c> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>A satyr seated on a pointed amphora wears a white fillet. A
      filleted thyrsos is seen. The tondo border is made of meanders and saltiered squares. There
      are concentric circles on the bottom. The style is"Faliscan". The vessel belongs to the
      Cauliflower Class.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/a4e940b3e68cf3d762078bf788f2200200574a862aaf2955f9add6a3e82a6142> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "One thallophoros and seven bearded men, perhaps Attic heroes"@en ;
