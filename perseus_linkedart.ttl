<https://aa.perseus.org/id/text/5fba4c2d7222df7facc691753dc876d8e24628fb0a38777fb2beeaae27a47606> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "A mother holding an infant"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/5fc2e44ccfa25c7d3f8d94447961ed8e27889251592e3f9b18cad4aff14936ff> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Side A:</hi> Zeus strides to the
      right while holding a bird in his outstretched hand and brandishing a thunderbolt in the other
      hand at the back. He wears a chiton, himation, and fillet (in added purple). Some of the
      musculature and bird feathers are outlined in dilute glaze. The groundline is a decorated band
      with stopt key pattern.</P><P><hi rend="ital">Side B:</hi> A Giant in
      hoplite garb walks to the left wearing a helmet and carrying a spear and round shield with a
      device of a flying eagle with snake in its beak. He stands on a groundline decorated with ivy
      leaves.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/5fc6462f8a6fe99673db4310f92639d847893359c52859a7e61d878ae0f16854> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Interior</hi>: symposium. A bearded
      man wearing a mantle reclines on a cushioned kline. He holds a phiale in his left hand, and
      his right hand rests on his raised knee. His head is turned as if to listen to a companion
      behind him. He wears a large wreath (painted white). A table stands in front of the kline, its
      legs ending in lions' feet. There is an inscription above the
      scene.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/5fd08d7b83d5419529ae885b5acb4f2cf03e372c99ff20e0351d675891209e7f> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>A woman seated in a chair, drawing a long strip of wool out of
      a wicker basket. She wears an Ionic chiton, and has a mantle wrapped around her legs. Her hair
      is bound with a broad headband except for four locks which fall on either side of her neck.
      She wears a disk earring and a spiral bracelet on each wrist. The chair has a high back and
      had a plaited seat. On the wall behind her, a sakkos and a mirror. The mirror is decorated at
      the top with a small female head. In the field, inscription <foreign lang="Greek">*E
      *P*A*I*S *K*A*L*E</foreign> ("The girl is
      beautiful").</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/5fda18f668389329cc3d7c16914009957311c83f9a782f38d9a528469c460b9b> a crm:E33_Linguistic_Object ;
