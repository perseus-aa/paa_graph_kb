<https://aa.perseus.org/id/text/4fb6656c17b6e6a6bc139d948c9509b2a90a49eb271531ccbcea6d5057069b32> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Six horse heads to left in a band around the body. Three have
      red manes, one has a red face, one has a red chest, and one a red face and chest. All have
      reins. Above and below are bands of ivy leaves, alternating red and black. The top of the rim
      has black zigzags. A red stripe runs around the outer rim. Two thin red circles appear under
      the base.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/4fc0f759372283492595bd0bbcd2a40c264204378da64f17310fe36f90762087> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Seated Zeus with attribute representing a sacred mountain"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/4fc1220efcc1c135a40ea85c3861178297d7a187cc0abe689c065d4102ea94b8> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<P><bibl>Walters 1893, 78</bibl></P>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/4fdc44e3c7979dc5f40cb232968a91218e29fef311e4ceba1e9f2012ddd38688> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>A woman appears in a chiton with a fillet in her right hand, a
      ball of wool in her left. She wears a necklace. To the left is a low pillar. A nude youth
      (athlete?) stands with a staff holding a strigil and aryballos in his left hand. Below the
      handle are stacked palmettes flanked by coiling tendrils. There is a wave pattern around the
      base of the neck. There is red wash under the base.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/4fdff71a1a9a7a707a0476d285234d6bec7d113828af6a7b116e5a4e8b19b149> a crm:E33_Linguistic_Object ;
