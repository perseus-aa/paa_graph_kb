    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/e5cc96e9d1a363afedcf87c54c7d92bb77cd105d9bc76945e93aa803fd8070a2> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Freyer-Schauenburg 1974, 69-73 no. 35, pls. 20-22</bibl>; <bibl>Richter 1970b, 86 no. 77, figs. 258-60</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/e5dd16af283be82ae14a30d3ee914588f8fe3e940d5c7940d94d1f6ebee63a49> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Side A: a man is seated at left on a klismos holding a staff or
      sceptre upright in both hands. He wears a red radiate fillet. Before him at right, a woman
      stands wearing a peplos and a sphendone with upright elements. She holds a shield with a star
      device and gestures toward the man. To her right, looking left, stands a youth in a himation
      and a red radiate fillet holding a tall staff. At right is a man in a himation with a
      fillet.</P><P>Side B: a departing warrior stands at center facing a youth in a
      himation; the youth is holding a staff. The nude warrior carries a large fore-shortened shield
      and a spear. His face is largely destroyed. A woman at left pours a libation. She wears a
      peplos and holds a phiale in her left hand and an oinochoe in her lowered right hand. To right
      of the warrior facing left, a woman in a chiton, himation, and a radiate stephane gestures
      toward the warrior. There are palmettes under the handles.</P><P>Tondo: departing
      warrior. A nude young warrior faces left, his torso frontal. He holds a long spear and a
      shield with a star device, a sword hangs at his left hip, and he wears an Attic helmet with a
      low crest and upturned cheek flaps. Facing him, a long-haired woman in a chiton, himation and
      sphendone with three upright elements gestures to him. Meanders and cross-squares surround the
      tondo.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/e5e866db9794b14f198e170f68f9c7282e3799050aff0572138b7df246903bb4> a crm:E33_Linguistic_Object ;
