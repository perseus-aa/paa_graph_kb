<https://aa.perseus.org/id/text/61e8ca46ab2275194b9aadf13ad2792630f1b492e3f2c7c41d5a647e459700bd> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Medallic plaque with bust of Zeus"@en ;
