<https://aa.perseus.org/id/text/7d079bdf9eebd753b7de4bd505c72184a8817b7efa4758c527425ec6da724a16> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """"<bibl>LIMC</bibl>, 7.914-15 s.v. Thebe no. 8 (C. Vlassopoulou);
      <bibl>Shapiro 1993</bibl>, 103, 242 no. 50, fig. 57;
      <bibl>LIMC</bibl>, 5.866 s.v. Kadmos 1 no. 9, pl. 558 (M.A. Tiverios);
      <bibl>LIMC</bibl>, 4.413 s.v. Harmonia no. 3, pl. 239 (E. aribeni);
      <bibl>Shapiro 1988</bibl>, 206; <bibl>LIMC</bibl>, 2.135 s.v.
      Aphrodite no. 1414 (A. Delivorrias); <bibl>Vian 1963</bibl>, 38 no. 12 pls. 6-7;
      Beckel 1961, 75 no. 89 n. 647, 669, 671; X.S. Gorbunova and A.A. Peredolskaya, Mastera
      grecheskikh raspisnykh Vaz (Leningrad 1961) 106; <bibl>Roscher</bibl>, 2.1
      (1890-1894) 839 s.v. Kadmos (O. Crusius), fig. 3; CRPtersb 1860, pl. 5.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/7d08e363021ed4278814509557b2f3883a30fabb4e6e7f203f10de31bdc14981> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """On the pyxis foot taken traditionally to be "side A" appears a scene
      from the <hi rend="ital">Kypria</hi> (some of this story is also retained in
      Virgil's <hi rend="ital">Aeneid</hi> 1.474): Achilles, wearing the helmet, has
      ambushed the Trojan prince, Troilus, at the fountainhouse, where he has come with his sister,
      Polyxena, to fetch water. As Troilus flees on horseback, his sister, Polyxena, also flees on
      foot; she has just dropped her amphora, which appears on the ground behind Troilus' horse. The
      man at the far left is not identifiable.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/7d1829b86e4eae046508a3834315e20d167805ce539a832a2ce3c652ee448786> a crm:E33_Linguistic_Object ;
