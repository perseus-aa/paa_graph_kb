<https://aa.perseus.org/id/text/257f5d590578fbbb7b3a365842ec6cf5e276450c28b58275216016904791d74d> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>Smith 1896, 146</bibl>; <bibl>CVA, 5, 10, pls.
      70, 1 and 72, 1</bibl>; <bibl>Williams 1985, 40, fig.
      45a</bibl></P>""" ;
