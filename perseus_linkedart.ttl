<https://aa.perseus.org/id/text/1c799bfddec0495c447f500ee8cee2836a7c716855d3055742731c3f06c0b3dc> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>On side A, the woman carrying a kottabos stand had lost part of her right
      shoulder and a small portion of the hair at the back of her head. In addition, part of a bunch
      of grapes over Pan's head was restored.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/1c7e6e147d8d0c5a19b3695b15f870982920ee146e4161071a00eb58c2fece66> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Standing male figure playing flute-like instrument"@en ;
