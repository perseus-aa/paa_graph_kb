<https://aa.perseus.org/id/text/ff1315a238936a7cded1595b62ba0fe83d3babdd70d94fb2f7ac5684db625275> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>A: Demeter standing profile to the right, with her left foot
      advanced, wearing a himation draped over her left shoulder and around her lower body, over a
      medium-, button-sleeved chiton, a narrow stephane, a krobylos, and a spiked pendant earring,
      holds grains in both hands, her left arm raised, and her right arm lowered; Triptolemos,
      seated 3/4-view to the right in his winged chariot (with a spotted snake profile to the right
      just behind the wheel), wearing a himation draped over his left arm and around his lower body,
      over a short-sleeved chiton, a white wreath in his hair, with a bun, hold grains in both
      hands, each arm bent at waist level; Persephone, labelled on the left of her body, following
      the curve of her drapery and interrupted by her arm), standing 3/4-view to the left, with her
      right foot advanced, wearing a himation draped over her left shoulder and around her lower
      body, over a medium-, button-sleeved chiton, and her hair in a krobylos (?), tied with two
      narrow taeniae, and a spiked red pendant earring, holds an oinochoe in her slightly lowered
      left hand, and extends a phiale in her right hand, at waist level; bearded Kalamites, standing
      3/4-view to the left, with his right foot advanced, wearing a himation draped around his lower
      body and over his left shoulder, over a short-sleeved chiton, a fugitive white wreath in his
      hair, holds his clenched left fist just below waist level, and a scepter in his left
      hand.</P><P>B: Bearded Theos, standing profile to the right, with his left foot
      advanced, wearing a himation around his lower body and draped over his left shoulder, over a
      medium-sleeved decorated chiton, and a krobylos tied with two thin taeniae, holds a scepter
      upright in his slightly raised left hand, and a phiale, at waist level, in his right hand,
      into which a female figure (Thea? [Clinton], inscribed KALOS), pours a libation from an
      oinochoe held in her upraised right hand; she is standing profile to the left, with her weight
      on her left leg, her right leg slightly advanced, wearing a himation draped around her lower
      body and draped over her left arm, over a medium-sleeved chiton, and two taenia in her hair,
      the ends of her hair held by a swath of fabric; a bearded male figure, standing profile to the
      right, with his left foot advanced, enveloped in a himation wrapped around his bent right arm,
      his left hand extended, at waist level; Eleusis, standing profile to the right, with her left
      foot advanced, wearing a himation draped around her lower body and over her left shoulder,
      over a medium-sleeved chiton, a sakkos, a pointed pendant earring, holds an oinochoe in her
      upraised right hand, and a phiale at waist level in her extended left hand; bearded Hippothon,
      standing near frontal, turning his head profile to the right, with weight on his frontal left
      leg, his right leg relaxed and bent, wearing a himation draped around his lower body and over
      his left shoulder, over a short-sleeved chiton, and a fugitive white wreath, his hair in a
      bun, rests his obscured left hand on his hip, and holds a scepter upright in his upraised
      right hand.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/ff13228bbeaa174cb842c669d7e673517a72f032c28b7403649a9da296da7c0a> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<bibl>Beazley Addenda 2, 246</bibl>; <bibl>Jahn 1854, 243 no.
      803</bibl>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/ff1d3618bfc36c35af1dfdd45a86ab5baaff68961270b6c60eebaf3bc3b0a701> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Side A: Dionysos between eyes<lb>Side B: Warrior and youths between eyes
      (Departure scene?)<lb>Shoulder: A, seated man with two youths; Dionysos and satyrs; B,
      battles<lb>Under handles: satyr"""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/ff1f39b01a7a9805fc02c699471e31fc16b4114d438078d15c10e7f0011daf0b> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "A. Ajootian in <bibl>Palagia & Pollitt 1996, 115 n. 121</bibl>; <bibl>Richter 1954, 68 no. 107</bibl>." ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/ff22aa21de219eb3f6f7c511be3207921e405c6f9a185f3a19ea8bf11694052f> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Circular patterns and long-legged birds"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/ff23462a802856ea14d931da4a8029a2436b082280e67c436b77275dc5e06036> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Body</hi>: Two projecting "nipples"
      are in the front of the vessel just under the neck; they are encircled with painted rings and
      dots. Under this is a painted eye with a symmetrical curl pattern below it. Around the
      shoulder of the vessel is a repeated pattern of four-petalled flowers within circles. The
      paint is a matte black-brown color.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/ff23ef5165f9c4510bb421be8b14775a7ba968aa74d3f735a4148f6810a439dc> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "A family of worshippers approaches Artemis (?)"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/ff25d2106118a275faf6143f280cf1a86a202c3a52fd3886ba2518f11a8cdd23> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Interior: warrior leaving home (youth and old man). Side A: Judgment of Paris. Side B:
      meeting of Paris and Helen."""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/ff2a043b1c5a715497f8c5f4fbb28f3026645c75ad22623f4ba787f74fe0291a> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>CVA, USA fasc. 17, pp. 5-6, pls.
      7-8</bibl></P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/ff2a06614131b553691ebc170eec627b8b928acc028db7f3b4720d26186330ee> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>Unbroken. Cracks down the right side, below the elbow, and through the right
      side of the face to the right hand; chip on rim. Incrustation on the left arm, the left side
      of the hair, and down the back left side.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/ff39064ed9ec8604b3e433199e18492c463d8c8ef8223b4e8b627305a5ec774d> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Running girl, usually identified as a Nereid"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/ff3c68eeefeb14b04ca60f09a175e21c9ce459425de473f107d6fd0675ffeea7> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "One of the major Classical city-states of ancient Greece."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/ff4cdcd1f85f2ca435a22746780f27c7d83389a6c366a5a7dfb4e7eef3bd5d67> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "A: Eos and Tithonos. B: a boy fleeing."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/ff4e874c1f6e36f6e989ed19dbd8ffc0104b41cdc8962aa2beb848c6f5d79a89> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Svoronos 1903-12, 632, pl. 130.6</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/ff5201c1e0bac1b40a5ab8a6d4cfb0d966b0e7420ac1766df1fbe463b172834c> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Standing youth with hands held forward and left leg advanced"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/ff520e80d1b0313c1ae5a1f4656a20688e4791bd26f9a3c9b9596661851889cf> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Side A</hi>: Two nude, bearded
      warriors are fighting with raised spears. They wear greaves and Corinthian crested helmets.
      The shield of the warrior on the left is turned so that only its interior is visible; the
      other warrior has a pinwheel pattern on the outside of his shield. The warriors are flanked by
      standing sirens with raised wings.</P><P><hi rend="ital">Side B</hi>:
      Confronting panthers stand with heads facing the viewer. Between them is a
      palmette-lotus-spiral ornament, and over each of them is a lotus bud.</P><P>At the
      base of the vessel is a ray pattern, above which are fine horizontal lines in red paint, then
      a thick band of black with red lines overlaid, and then more horizontal lines with the frieze
      above.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/ff62e06cdc8deb439e8337378cf28c85542cb28860a3fddf9688f75b3399d5d1> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Boardman 1978a, fig. 68</bibl>; <bibl>Richter 1970b, 48 no. 10, figs. 72-75</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/ff708ddd77e454e4bc845af98830599ada71ee4f9b0af97cbd888b1e95777580> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>Broken and repaired, with repainting of cracks. Misfired red in places. Handle
      chipped.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/ff83f4bcefda7a711a5364aaa859f2eda3746b3676f9b36e53d92db764e4bde8> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>The cup is in good condition. The surface is lightly pitted and worn in
      places.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/ff8ba36ddadda4c5760b98ff5478a14e3b712320e0d39525010382a9feb2b3dd> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>Broken and repaired, with the very bottom of the tondo and about two thirds of
      the rim restored in plaster. One circular piece reattached in tondo. Minor scratches. The
      added white of the chitons has largely worn away.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/ff8f0b7375ded2d34dbc5d3ccb7242c8e50fab772b3b425dacb9b67f7cc7bd96> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>Small fragments and chips are missing along the breaks and from the rim,
      handles, and foot. The glaze is chipped and spalled, and there are traces of
      incrustation.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/ffa3689b2cf68a734faa3478434989961abb017416bcbc79fd3f11dfd9b2e656> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Exterior, sides A and B: Centauromachy<lb>Tondo: a Lapith spearing a
      Centaur"""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/ffb32c3a3f070f45f20b2343675b52671a4e954ee485046b1df7fe6bb9cf5174> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Comstock & Vermeule 1976, 201 no. 319 (ill., with previous bibliography)</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/ffcac1d51e004c0193c8b6b92f54ac59a8ded9387b062797f3772569c67bab3e> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">RIC</hi></bibl> V.2, 168, no. 231; <bibl>Cohen 1880-1892, 396, no. 129</bibl>; <bibl>Milkovich 1961, no. 56</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/ffcc93d8f719f8d6d47def722459a2d333e278a0876704992521ae0b5e34a613> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Athena, wearing her Aegis, but no helmet, stands in 3/4-view to the left, with her right arm raised (to her spear?)"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/ffcd58c20d7efbf04144ace6ade6b1b19f9f0b7336ae4361bc7c3631d4dd9f7d> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Interior: Eos with body of Memnon<lb>Side A: Menelaos vs. Paris<lb>Side B:
      Ajax vs. Hector"""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/ffce60363501efeaa58e9ee1ac09f405efebd9500b2e9fe1ebc8f77c57190457> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Woman between two bearded sirens."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/ffced039dfa379a7ee4daabb0fba78f28054ee9fe920a1793bfed8ca795ef4e0> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<P><bibl>Moon 1979, p. 65</bibl></P>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/ffdefea8fe25ba211dd9699f72c85aabb44b8bfd197df2ca1a3cdda264806410> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>The base of the vase is a plain torus, lipped at the top. The
      side of the base is reserved. Below the scenes, and all around the vase, is an egg-and-dart
      pattern.</P><P><hi rend="ital">Side A</hi>: A warrior and a king stand
      facing each other. At the right, the king stands in profile to the left, leaning on a spear
      which he holds in his right hand. He wears a laurel wreath in his hair, and is clad in a
      himation. At the left, stands a youth in a relaxed pose, frontally, with his weight on his
      left leg and right leg back. He wears the short chiton and cuirass of a hoplite, and carries a
      spear upright in his left hand. Both figures hang their heads, a characteristic detail of the
      artist.</P><P><hi rend="ital">Side B</hi>: A youth stands in profile
      to the left. He is enveloped in a himation.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/ffdfca77dfd04595091514805f39eae7aebaee2b7da7d7947cbc06c39343083c> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Square altar with reliefs on three sides"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/ffededc5e774351346cc1326d40ca522a10a79befc3f03b395c708257367e97c> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Bruneau 1983, 56</bibl>; <bibl>Richter 1970b, 27 figs. 20-21</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/fff1b0e262b56bc4dce5ae442299b786cc08c595cb748dd0de038be8c02c2594> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "A snake below a sandal decorated with the figure of a worshipping man"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/fff7f8b37e79fbf94b99994e614b69454e26d910aeceb78d8975b9a8c1ed4388> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Side A: man and youth in chariot, side B: Apollo and two women."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/fffae8de4309aa10ea37a2b5544587aa49f76b67572c88094aca316c0ac9d4ba> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>The clay is pale buff, the decoration in red and brown glaze.
      The vessel's opening is in the top of the head. Two holes for suspension appear in the hair
      that draped over the shoulders. The head and feet are molded; the latter form a stand for the
      figure. Strokes, lattice work, wavy lines, zigzags, and in the rear four four-spoked wheels
      make up the painted decoration of the body and the back of the
      head.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/fffb569ff4d40dc631c68d93c68386c766ed93cfe6dfcc549269e19104d3ca11> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Light-armed warrior"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

