<https://aa.perseus.org/id/text/93022c745e9951afdd87d774bf2c68805240a169a61e7e44a54c77b90b8d4983> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Side A: Nike, pouring a libation of wine, flies right over a
      flaming altar. In her right hand she holds an oinochoe, and in her left a phiale. She wears a
      belted chiton. Her hair is in a krobylos, secured by a sphendone. The altar is decorated with
      volutes and ovulo. The flames and wine are in added red.</P><P>Side B: youth in a
      himation standing to left with a phiale in his lowered right hand. He wears a red fillet. The
      base lines are meanders to the right.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

