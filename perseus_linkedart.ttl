<https://aa.perseus.org/id/text/3d836d933e59d965b1a95fc11406cfc91271680eda90230ece2b82c828871d7c> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """On one side, a series of concentric circles with a star in the middle. On the other
      side, two men standing upright, a man in between them on his head (acrobats?)."""@en ;
