<https://aa.perseus.org/id/text/6173b5978f3ebeabe81bb9917b74508c716af63784e2b71cd933cd00d92c1eb4> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Two pairs of oversized, stylized eyes with great target-like
      irises, probably apotropaic. Between each pair of eyes a Greek hoplite battles with an Amazon.
      The men wear Corinthian helmets, the women high-crested Attic helmets with oblong cheek
      pieces. All wear short tunics, corslets, and greaves. The figures are armed with spears,
      swords in scabbards, and round shields. On side A, a nude youth with long red hair observes
      the struggle. Interior: Gorgoneion.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/6176a4980d4a86c01d81528e7645585c6980f8f2ebd12eb9505a0b36463139cc> a crm:E33_Linguistic_Object ;
