<https://aa.perseus.org/id/text/8add7bd5e65192c49ba57260442ecc20544b8f322b85799f92e1b3f007910260> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<P><bibl>PECS, 691</bibl>; <bibl>McDonagh 1989, 222-225</bibl>; <bibl>Bean 1979, 58-59</bibl></P>" ;
