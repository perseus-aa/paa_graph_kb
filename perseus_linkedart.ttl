<https://aa.perseus.org/id/text/cc12cf2e4037d77cfd1ef098a4654a6cd3ecf542f10b1a567f9c2169c581bce6> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>The cup is in good condition. There is pitting and encrustion of the surface on
