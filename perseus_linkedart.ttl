<https://aa.perseus.org/id/text/dc3113333808e4348846e03fe79aaf5f49b3e1b5879dfc7ccc54e04cdc019f86> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>The vase is decorated with a series of friezes from top to
      bottom in black-figure technique. There are substantial amounts of added red. The main frieze
      shows animals with rosettes interspersed. The animals are both real and fantastic, including
      lions, a goat, a bull, and a siren. Around the shoulder is a lotus-palmette chain, and on the
      neck is a band of solid red. Inside the mouth and under the foot are rings and concentric
      circles. The handles have been formed into female figures, each wearing a red dress and
      necklace.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/dc3541f7d40e4134482e57a884a348d302d35ceaa6b4a6634e5a42809d321f4a> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Plastic woman's head; meanders, palmettes, scale-pattern."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

