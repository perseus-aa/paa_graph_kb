<https://aa.perseus.org/id/text/2687b92e1f9fd0b095f6c28bcd7b155c0a98985a3bd579dd208d1e51c7d728bd> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Relief decoration of ivy and oak leaves with acorns and berries. Lustrous green
      glaze."""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/26a02b816f677708192c28ac5a36ad16ecc7c5dac2024b40dfa5916b24be0d15> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Side A</hi>: Two large eyes are
      depicted, with a nose (or ivy bud?) in between. The center and outlines of the eyes are
      painted black, the ground is white,and there are purple rings are the
      pupils.</P><P><hi rend="ital">SideB</hi>: decorated the same as Side
      A.</P><P>Under each handle are two confronted satyrs plaiting two vine branches
      which spread over the sides of the vase, enclosing the eyes. Around the nipple at the base is
      a row of dots, and a tongue pattern in purple and black.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/26b3fb745bc6bc2b7a2c54e8d73e4ecc0a9a5d09dcaa3015b7fb526684078f7c> a crm:E33_Linguistic_Object ;
