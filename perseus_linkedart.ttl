<https://aa.perseus.org/id/text/efee2bc4a4d3885b4716dcfeb0c2d35d7b436ee777eb90a4e9e16de7a67ef878> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Upper body of a woman, head to left. She wears a peplos pinned
      on the right shoulder only. She wears an earring. Her hair is held by a checkered wrap. On the
      interior is a reserved stripe below the rim.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/eff2569eacb901f131137163004738f37bb0ae0fca69b2475d829073de334608> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Body: Chariot with Iolaos as charioteer, surrounded by Herakles and gods. Above and
      below the main scene is an animal frieze."""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/eff34dff528a7ac2cc067b8faec132c226b2773afa5e4a9adfaa0ebe718a5e9e> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Stewart 1990, 38, 109</bibl>; <bibl>Kyrieleis 1986, 181ff. (Dontas)</bibl>; <bibl>Boardman 1978a, 81,85, fig. 150</bibl>" ;
