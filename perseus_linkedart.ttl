<https://aa.perseus.org/id/text/8f73e3e02b6fdac55fea72eaaea8f208850b387a95598d88ef2d1ef9855e652e> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="head">Tondo:</hi> armed hoplite and
      Amazon. Figured band at handle zone.</P><P><hi rend="head">Side
      A:</hi> Gigantomachy, gods fighting giants, mostly in hoplite armor. Herakles and three
      goddesses ride in quadrigas. <hi rend="head">Side B:</hi> departure of four war
      chariots. Nude, bearded men, two carrying shields on their backs, mount chariots while women
      and attendants bid farewell. On both sides, the two chariots at the edge of the scene move out
      towards the handle while the two at the center of the scene move in towards the
      center.</P><P><hi rend="head">Foot:</hi> two bearded nude men and tall
      tripod.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

