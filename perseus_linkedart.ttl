<https://aa.perseus.org/id/text/cfeac25c1265bb6f19d68b5f6e64d14aa5abf60f9f0538fb4c522ddca2ceb88e> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
