<https://aa.perseus.org/id/text/614b642d604503021094db26ad06c4ac15c289f59c50ca3fb5345b5111799d46> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>Broken and repaired, with moderate restoration of cracks and small gaps.
