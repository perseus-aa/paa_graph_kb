<https://aa.perseus.org/id/text/fcf9a5e6bcc43e76434bcf4ecc6b3eef2c1c04a1612452461d0b19ffd0784e1f> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>There are traces of a chalky white slip laid over the cream slip. The surface
      of the shoulder is chipped and the black glaze on the foot is eroded.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/fcfa1d3153c46dd37ebfa338d2669403fd4c2b2bd019fb87a3370a5e85f7729f> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>CVA, Munich, MAK 7. 32, p. 42-45, pls. 339,1-2 and 340,
      1-2</bibl>.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/fcfb8ffdf48c5e78840f4f2e5d8cc83f80d32921398a9e482fa4c3b08036ad1c> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Exterior: eyes; silens and nymphs dancing and in erotic attitudes<lb>Interior:
      Side A: Phineus; the Horai; Boreads pursuing the Harpies; Side B: Dionysos and Ariadne in a
      chariot with silens and nymphs; Tondo: Satyr's mask"""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/fcfe13ccb7dde3540886545814c7f6cb4c7204d2d85859f8674e9163afcb8d81> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>A youth (shade of the dead?) approaches from left with a
      tortoise shell lyre, with a plektron hanging from the lyre. He leans on a staff and wears a
      himation. At center is a tomb with pyramidal top and a four-stepped base. The outline of a
      tumulus is visible behind the tomb. At right, a woman in chiton and himation faces the tomb
      and carries a lekythos with a white ground scene in her raised right hand and a possibly a
      fruit or cake (or fig?) in her outstretched left hand. She wears a stephane in her
      hair.</P><P>Above the scene are meanders, saltiered squares and checkerboards. On
      the shoulder are palmettes and tendrils. There is an ovulo on the
      neck.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/fd0884f41daaa0a13efb8ffa0cb052bb36380e8a99627d68f466f25c0a4119bf> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Lewes 1920</bibl>, no. 64" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/fd0fe2145b753b53d02eb1874700d729db868a617ab1c5a4d57994eae808ff79> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Arrival of young horseman before a seated man. At the left a
      bearded man sits in a chair, facing right. His upper body is nude, the lower part draped in a
      himation. He wears a white fillet in his hair. In his right hand he holds a long staff. In
      front of, and facing him, is a youth in a three-quarters view, wearing a chlamys, fastened by
      a clasp about his neck, and a petasos strapped to his back. The front of his body is nude;
      beardless, he wears only a fillet. His left hand is on his hip and he holds two spears in his
      right. Behind him is his horse, head down, as if grazing. Beside, and in back of the horse, is
      a rectangular tomb stele, surmounted by an offering, and drawn with an attempt at
      foreshortening. Perhaps this represents the warrior's own monument.</P><P>The
      design occurs in a framed panel. Above there is an egg-and-dart border; below are meanders and
      saltire squares, and at the sides, a pointed reed pattern between vertical
      lines.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

