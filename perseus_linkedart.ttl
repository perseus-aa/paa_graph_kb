    crm:P190_has_symbolic_content """<P><bibl>Simon & Hirmer 1976, p. 51, pl.
      27</bibl>.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/d6c8fdb582c7307471e9230419e9df55ca0cbd90d2969a708c14f0ab7f2d2bf1> a crm:E33_Linguistic_Object ;
