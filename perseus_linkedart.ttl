    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">BMCRE</hi></bibl> V, 73, note, for variable legends (MONET AVG, etc.); Mabbott, <hi rend=\"ital\">Numismatic Review</hi>, Oct. 1946, 145-50" ;
