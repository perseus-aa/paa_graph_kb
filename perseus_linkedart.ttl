    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">BMCRE</hi></bibl> III, 547, nos. 1936-1937, pls. 101.4, 5; <bibl>Cohen 1880-1892, 2.260, 25</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/54f7ac085add00ad2fa31fe3baff22de8a0abf0574850c00911508465d94b6b7> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "The figure has a base ring"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/54f7eb3c5b7a110ba1fd8400a2f1289e29707db511445fe1ebdfd2534f94bd68> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>The sides of the vessel are convex, and decorated with a
      pattern of alternating meanders, swastikas, and quatrefoils, separated by vertical bands of
      chevrons. Above and below this decoration are hatched bands. The lid is decorated with
      concentric lines, rows of dots, and rows of triangles. The four plastically modeled horses on
      the lid are ornamented with stripes and a zigzag pattern around their
      necks.</P><P>This pyxis is unusual because of its large size, and because there
      are four, rather than three or two, horses on the lid (Vermeule,
      114).</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/54fc4e83e93bc17af24f9b2748003f7000a703e1de44b3ef9c7006bb71b6f102> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Irregularly shaped building; on the west side of the Agora, formed an architectural unit with the Old Bouleuterion."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

