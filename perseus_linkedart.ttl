<https://aa.perseus.org/id/text/6006d59ab3d0fd3bd2b74a0dd2f326d0beab91b8bc29d184dfb899372c9479a4> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Pollitt 1972, 38-39, n. 7</bibl>" ;
