<https://aa.perseus.org/id/text/219c6243c9a6c99591d0eecf45299c31429cf8aae742b6324db6a505d4683b36> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Karouzou 1968, 151</bibl>; <bibl>Svoronos 1903-12, 418, pl. 67</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/21a46461df0c84690a7b40e9004bf60a4cb3f73366603065e7f4a5309433537a> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>The clay is pale dull red, with occasional bits of chalk. The
      outside has a pale buff slip, but on the bowl the slip is now a dull orange brown. The
      decoration is in slightly lustrous black glaze and applied dull red.</P><P>The
      bowl has vertical sides above the straight sloping lines of the bottom. The vase has a low
      base ring, two horizontal loop handles, and the lid has a large flat knob in the center. On
      each side of the bowl, between the handles, is a pair of flying confronted birds. Each has a
      red spot on its body, and the wings and tails have linear decoration. Between them is a
      vertical band of reversing chevrons, bordered by rows of dots. In the field around them are
      filler ornaments, including a crossed triangle, spiral, and lined semicircle. There are bars
      painted on the handles, a running loop pattern over the handles, and bars on the upper edge.
      There are broad bands of thin glaze on the sloping sides, and on the inside of the bowl. On
      the cover is an elaborate pattern of palmettes and spirals with linear ornaments in the field,
      and short rays from the knob. On the knob itself is a
      rosette.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/21b1cdb904fc9aa1a86f42e3b4bb85d83983f874aa5ecfbd8ed1e33ccb262a84> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
