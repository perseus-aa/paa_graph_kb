<https://aa.perseus.org/id/text/7c7a033479049fdd4916ab5c1d385c9d8a3cbc1f0b980fe629213ce2d03cac55> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>On larger claw: youth runs to left with a lyre in his
      outstretched right hand. Behind to right are a writing tablet and purse. On smaller claw: a
      lotus bud with tendril is seen. There is an ovulo pattern on
      neck.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

