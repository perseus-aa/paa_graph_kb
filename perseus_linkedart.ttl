    crm:P190_has_symbolic_content """<P>Reconstructed from several large fragments, and missing some small fragments;
      retouched on the belly of Aigisthos (side B). Surface generally in good condition: vertical
      cracks in black glaze around handles; whitish adhesions on several of the
      figures.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

