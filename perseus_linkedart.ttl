<https://aa.perseus.org/id/text/a83f9854041b5e8d38000b39d10579a931becaa212ceb28d0fdbacef7a046ca2> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Tondo: Eros seated on a rock<lb>Side A: Eros striding toward an
      altar<lb>Side B: Eros flying."""@en ;
