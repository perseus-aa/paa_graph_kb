<https://aa.perseus.org/id/text/576081d46113ad0bfc1f592fd284e33fa35ee4d44f4792ddb4f14b76cc9b1e5a> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>An old man with white hair and a beard stands to left in
      conversation with a figure whose left hand holds a staff. The old man gestures with his right
      hand. At right, facing away, upper body of a woman is visible, wearing a peplos, a necklace,
      earrings, and a broad band in her hair.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

