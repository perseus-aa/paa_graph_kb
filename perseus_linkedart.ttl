    crm:P190_has_symbolic_content """<P>The handle zone is left reserved, and has been divided on each
      side into three panels by four groups of three vertical lines. The two outside panels have
      cross-hatched lozenges in frames. The central panel holds a water bird with "X" filler above
      its back.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

