    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/fddc3c7e994a462d9a161c177735fbf5a028cb3c7b3b63a036367f78b9824887> a crm:E33_Linguistic_Object ;
