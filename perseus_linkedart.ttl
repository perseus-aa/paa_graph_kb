<https://aa.perseus.org/id/text/df3828ee76d916644152cf84840badb2880c78e257d9daf17ecacc4679060791> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Wingless flying figure, perhaps Hebe or an Aura"@en ;
