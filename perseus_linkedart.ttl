    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/017d1f0aa5759fdebefe1c4fb0cc3c3c0d6a46060583b7f50c46a2fdf445cd49> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Mistress and maid. On the right stands a woman in a chiton with
      kolpos overfold, holding her grave gift, a toilet vase (plemochoe) in one hand. Her maid
      approaches, in a sleeveless chiton with kolpos overfold, carrying a basket with three handles
      filled with fillets. Behind her a small oinochoe is suspended. Inscribed between them,
      <foreign lang="Greek">*U*G*I*A*I*N*O*N *K*A*L*O*S</foreign> ("Hygiainon is
      beautiful"). Above, alternating leftward and rightward triple meanders alternating with
      saltires; on the shoulder, palmettes and volutes; at the neck, egg
      pattern.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/017f1e66b452a955549b9aca9b7d4a304ccf70121f9c8bfa5ea89af4f727617e> a crm:E33_Linguistic_Object ;
