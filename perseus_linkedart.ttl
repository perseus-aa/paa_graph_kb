    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/759e5f147050a3e1ec414eae542a3ed57820b2ca0809610b95ec34a063b86d40> a crm:E33_Linguistic_Object ;
