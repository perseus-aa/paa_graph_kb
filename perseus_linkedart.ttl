<https://aa.perseus.org/id/text/38836c5c849c50935cb7599b8d524626858450879f7e73d1a186058cab8ed636> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Opponent of right Champion W 2"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/3886aa8638a5803a28a880fe3f0ce22a13476dbcdd50ae8636c7031d8c584a78> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>At the foot-body join a red and a white line circle the vase.
      Below the scenes runs a right-facing meander band.</P><P>On side A, Theseus and
      Prokrustes are pictured. Theseus is wearing a short, belted chiton. His sword in its scabbard
      hangs from a strap over his right shoulder, and on his head is a wreath. With his left hand he
      grips the fleeing Prokrustes by the shoulder, and with his right hand he holds his
      double-bladed axe ready for use. Prokrustes is bearded and naked. Between the two figures
      stands the bed, and in the field above it the inscription <foreign
      lang="Greek">*A*L*K*I*M*A*X*O*S *K*A*L*O*S</foreign>. The figures are outlined in
      light relief.</P><P>On side B, a woman wearing a chiton, mantle, and sakkos-like
      cap holds a phiale decorated with black stripes in her outstretched right hand. Her sleeve
      shows a double black stripe. On the lower part of her chiton two vertical black stripes are
      visible. The woman is hurrying to the right. No relief is used on this
      figure.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/38980b7a804e6e61967ebe3fa5ab02f1e915677d11da4539bd45f18b09aa28ab> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "A Carian city refounded and enlarged in the Hellenistic period."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/3898c5ae97b607da57f603adf700330176230c171ea367069657840c9aecda14> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Tondo: youth with lyre. Side A: youths with musical instruments. Side B: male
      figures."""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/38a37b9a95174d0f137e0394851b94d59a183b90290b9a9dcaac891176a1f969> a crm:E33_Linguistic_Object ;
