<https://aa.perseus.org/id/text/e998e240a26519ddc4eeb10dcbdd597aa28c17e3429509951f6ee991ebcd04fe> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Under rim, rosettes and a thin black band. Sides A and B: Three
      padded dancers. On side B, all three are youthful, on side A, a bearded man faces two younger
      dancers. The dancers wear sleeveless chitons, with padding on the buttocks and shoulder rings
      for ribbons. They are stocky, more similar to komasts on Corinthian komast cups than to the
      later, more slender Attic komasts. Handles black, palmettes under each handle. Under dancers,
      black bands and thin black rays. Incision work sloppy.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/e99946bd5fb554cfce2b4f8fe2538d2a1bf25539f3208ed10f19272829d2e592> a crm:E33_Linguistic_Object ;
