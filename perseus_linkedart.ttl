<https://aa.perseus.org/id/text/a2521dd6310588cfa2976839f8daa33f67a45dd22b8eb24e668bac24b426cebe> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Exterior: an Eros, with large wings outspread, body in front
      view, head to left, floats down to earth, holding a long taenia before him in both
      hands.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/a261172d4dd85f3f20914371924c271d06072182253bfa9a5cca1137f9512c05> a crm:E33_Linguistic_Object ;
