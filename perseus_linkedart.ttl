    crm:P190_has_symbolic_content "<bibl>Gnecchi 1912, 2.73, no. 2</bibl>; <bibl>Toynbee 1944, 104</bibl>; M. Comstock, <hi rend=\"ital\">Bulletin of the Museum of Fine Arts</hi> 66 (1968) 33-34, fig. 6; W. M. Whitehall, <hi rend=\"ital\">MFA Boston. A Centennial History</hi> (Cambridge 1970) 667; <bibl>Greek & Roman Portraits 1972, no. 66</bibl>" ;
