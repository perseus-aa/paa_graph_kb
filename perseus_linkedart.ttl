<https://aa.perseus.org/id/text/2056bc0d7d17b389a78e32e0d954bdc2c6f6ef3bc90530ecbeb191a8736d7fe5> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>von Saldern 1968</bibl>, no. 35" ;
