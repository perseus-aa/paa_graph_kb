<https://aa.perseus.org/id/text/7cee8dfb4f10a4563a6c56f1b0c8b080a5c8f88df133dea0defbd09b9b8b0274> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>The vessel is a deep bowl with thin walls, small foot, and
      delicate loop handles horizontally attached. The decoration is in brown to black glaze,
      slightly lustrous. The inside of the skyphos is black, the outside has two fine horizontal
      lines at the top, below that a band of fine vertical lines set on either side of a "metope"
      decorated with short vertical zigzags, then a lower band of fine horizontal lines. The lower
      two thirds of the vase is black except for one reserved
      line.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/7cf3a16df5fd14b1f0ef93cc565eaec73c336ad3c184faad79110fcf67b032a9> a crm:E33_Linguistic_Object ;
