<https://aa.perseus.org/id/text/5f967be12952560c937a66987e1551352d01623e731b044619197dd2210f17a2> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Black figure on white ground. Side A: pair of boxers with
      wrapped fists are wearing red wreaths and sparring. To the left a trainer or judge leaning on
      a staff wears a red-striped himation and a red wreath. Side B: same.</P><P>Under
      each handle is a large alert dog with red collar.</P><P>A neck lotus and palmette
      chains with no incision also appear. Simple black tongues are seen on the shoulder. There are
      rays on the lower body.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/5f97896cd409d7023b79eeef6fddeb9c031db88877d3683f61175c2309897de0> a crm:E33_Linguistic_Object ;
