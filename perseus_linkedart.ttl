<https://aa.perseus.org/id/text/427c689a115c08ce00f1c17f30d37b49bf88b3ca6b1054d274f09d33900887cc> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Clairmont 1993, 1.378-81 cat 1.460 (ill.)</bibl> (with full bibliography); <bibl>Stewart 1990, 193, fig. 584</bibl>; <bibl>Karouzou 1968, 125-26</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/427d727d42b2be09596a6a04c51198f224caddc210f23cc380637e02743d4b18> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="head">Side A</hi>: woman with a youth.
      The woman stands on the left holding a hydria. The youth faces her holding out a sash over his
      right arm, his other hand on his hip. She is dressed in a peplos with overfall and black
      borders. The youth is naked but has a himation draped over his left arm and shoulder. A plant
      is on the ground between the two and a sash hangs in the field above.</P><P><hi
      rend="head">Side B</hi>: two youths. The youth on the right balances a stick on the
      back of his right hand. The other youth stands watching, one hand on his hip. Both youths wear
      himatia draped over the left arm and shoulder, leaving the right shoulder bare. The himatia
      have black borders.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

