<https://aa.perseus.org/id/text/8cf2abbfa5656a336383286061bd3d50b0c7d59656ba4b287ddd82de4febc44b> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<hi rend=\"ital\"><bibl>BMCRR</bibl></hi> I, 198, 1280; pl. XXX.20; <bibl>Babelon 1885-1886), 1.539, 1</bibl>; <hi rend=\"ital\"><bibl>RRC</bibl></hi> no. 308 1b" ;
