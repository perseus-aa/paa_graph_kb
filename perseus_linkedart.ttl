<https://aa.perseus.org/id/text/16fc1c41025328a9b72f47555cedff74de09f3cf2163662e8e142f60de0145e4> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Corinthian pilaster capital with small boy or personified Winter holding killed ducks and a staff"@en ;
