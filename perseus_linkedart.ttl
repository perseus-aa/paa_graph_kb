<https://aa.perseus.org/id/text/45354ab3eba60ed981c6dd2a955c347f492b178780ae35993b6745c949595cc4> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """Reconstructed from many fragments and extensively restored: much of the lip and the base
      are modern. Losses include the face of the woman, the lower legs of the youth, and the head
      and shoulder of the figure on the right. The surface is worn, especially on relief lines and
      the arm of the central figure.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

