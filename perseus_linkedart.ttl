<https://aa.perseus.org/id/text/97e4dd82dba55e298da5615b9ecac02a76ff1544e52dc89fb3e32cae2159d552> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Clairmont 1993, 2.165, cat. 2.223a</bibl>; <bibl>Smith 1892-1904, 3.2231</bibl>." ;
