<https://aa.perseus.org/id/text/dc78fc4f16411b5a66f0759721f40dbf15997e042b7039bc5d7871457c761da3> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "J. Polzer, <hi rend=\"ital\">AJA</hi> 77 (1973) 372, no. 1; <bibl><hi rend=\"ital\">RIC</hi></bibl> VI, 372 no. 166" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/dc7b0495ad40b6c65d01084a508c182aea43d8fa6f5d3fee47a773a3020a50c1> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Seated Aphrodite faces to right, wearing a chiton embroidered
      with palmettes and stars. To right, Eros in added white wears a fillet, his left foot propped
      up. At right, a woman runs to right, looking back wearing a peplos. Her hair is in a
      kekryphalos. There is a palmette under the handle; it has coiling tendrils extending to the
      sides. Tongues appear on the shoulder, and an ovulo below the
      scene.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/dc7b5bffbb696dfdd44c90879f4231a3d40835a573ee9faf5c8d7657375ee7be> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Side A: satyr and girl. Side B: satyr and maenad."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/dc7e1357695920d0caea4f4967ab8e8dfaf39331115578ec4c751d0eb6daa35b> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Karouzou 1968, 141-42</bibl>; <bibl>Svoronos 1903-12, 252-54, pl. 36.3</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/dc7e31978a0e0c4f55c384d81fd7b1fcfd79e0d4083fea8d2dbb3b31dff85653> a crm:E33_Linguistic_Object ;
