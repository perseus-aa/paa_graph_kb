    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/da8bfd34dccfb2fea47ac5e01d291bcf28a0574a54f3b98c1d09ede1e05ca0e6> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Karouzou 1968, 2, pl. 1</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/da8c1948f218075615de3d08a2ef689a2a8ee6a8b1c5a4dac1b4a8da8521e8e5> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>The body is almost entirely covered by glaze, with the
      exception of a reserved zone decorated with black rays above the foot and the edge of the rim.
      The zones of black glaze on the body are delineated by fine horizontal lines in added purple
      bordered by white. The shoulder is separated from the neck by a fine raised band. Below this
      band on the shoulder is an incised tongue pattern. The tongues beside the lower handle
      attachment are painted white, three to one side, two to the other. The other tongues are
      alternately painted purple, black or yellow in sets of threes. Three rotelles decorated with
      white dot rosettes are placed where the handle is attached to the rim of the
      vase.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/da962586b0c723e35514af9358ec568a01c50534abcc0bb57566e3a9aeca2307> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Siren with raised wing."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/da9e50f6c8db65835fda791dbf0ed4d9b7827c5c7bed36d0c8274325dd3dbee1> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Eleusinian deities"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/da9f0a72dcacba4e10231b50e3b30a56c2a33ceaa2a05574084d6453625feeae> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>Smith 1896, 137-139</bibl>; <bibl>Haspels 1936,
      14 n., 72 n.2</bibl>; <bibl>CVA, 5, 3-4, pl. 28,2</bibl>;
      <bibl>Boardman 1975, fig. 309</bibl>; <bibl>Kurtz 1989, 95-96, pls. 78,
      79</bibl>; <bibl>Williams 1991, 106, fig. 42</bibl>; <bibl>Barber
      1992, 115, fig. 73</bibl></P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/daa88c107947fea7dbba2e85cc297119d99e8c838365ae452073b554b8dbbce1> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Interior:</hi> In the center is an
      apple tree, its branches extending to the top of the tondo and spreading rather lower of the
      left than on the right. On the right a girl stands on tiptoe, stretching to reach up with her
      right hand to pluck an apple from the highest branch and holding her skirt aside with her
      left. She wears a long, undergirt chiton with apoptygma (overfold) and her hair is confined
      with a sphendone. Above her is her name, of which only three letters remain, ...<foreign
      lang="Greek">*L*D*O</foreign>. The figure on the left is completely lost, except
      perhaps for the outline of the back. Judging from the space, it must have been either seated
      or shorter than the other. Above the second figure runs the name <foreign
      lang="Greek">*M*E*L*I*S*I</foreign>. Below the design between the border and the lip,
      is inscribed <foreign lang="Greek">[*S*O*T]*A*D*E*S *E*P*O*I*S*E*N</foreign>,
      "(Sot)ades made (me)." The tondo is defined with a broad yellow band within a black
      band.</P><P>The inner surface is covered with a white slip, on which the design is
      drawn in brown outline. The fruit is painted in added white so thick as to look like relief.
      Coral red used.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/daa9886de6fca1c5eae92053ad02fc0204bb662f6b2a3a32372b7c1dea6434f2> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<P><bibl>Olynthus, vols. 1-14</bibl>; <bibl>J.W. Graham, <hi rend=\"ital\">Hesp.</hi> 22-23 (1953-54)</bibl>; <bibl>Mabel Gude, <hi rend=\"ital\">History of Olynthus</hi> (Johns Hopkins Studies in Archaeology 17, 1933)</bibl>; <bibl>Zahrnt 1971</bibl>; <bibl>N. Cahill, PhD diss. (UC Berkeley, 1991)</bibl></P>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/daad80b22945ce85bf7c267f9ae2aa4271e5c52199922c3c448f1865f25465e9> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Interior</hi>: komos. Two bearded
      men and two youths dance toward the right. The bearded man in front, on the far right, dances
      with his head turned down and to the left, one hand held to the back of his head, the other
      held straight at his side. Behind him, in the center, a youth and bearded man dance side by
      side, the man holding the youth by the waist with his right hand, his other hand holding a
      kylix. The youth holds a wine pitcher in his right hand, his left hand and knee raised in a
      dance pose. Both the youth and his partner look over their shoulders to the left where the
      second young man dances with his head tipped down. He is holding a funnel??? In the exergue
      are two large eyes done in red figure technique.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/dab05fc74f14974ff107d9836c71c16636099f15c11ae2f5f14249abf8f79e44> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Part of a relief from an honorary decree, with a possible representation of Demos"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

