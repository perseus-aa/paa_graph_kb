<https://aa.perseus.org/id/text/f5348f8d285e0e49717c82280a176f78509af236af62e5519648f979a7b8c01b> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>B. Cohen 1978, 379 ff., pl. 86, 2,3</bibl>;
      <bibl>J. Neils "The Loves of Theseus: An Early Cup by Oltos," <hi
