<https://aa.perseus.org/id/text/7fbaa3d02f25193012e8d1038dc6a850c28fa4aabbf4adaf5e47b3b551926de4> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">RIC</hi></bibl> IV.3, 144, no. 181*c, d; cf. pl. 12, 1" ;
