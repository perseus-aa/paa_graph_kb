<https://aa.perseus.org/id/text/06544552c94e29762f65466339750b4aead17d31d9786510d877e9d0ab1e45da> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>CVA, USA 2, RISD 1, p.32, Pl.24:
      3.</bibl></P>""" ;
