<https://aa.perseus.org/id/text/0efc5ad78dce418dbb3b615193e16138a8e8d07ce52ceea1ca2e1bc7859ac94b> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Side A</hi>: wedding. The bride and
      groom, each accompanied by an attendant, stand facing one another, a wreath hanging between
      them. The groom is wrapped in a long mantle with a black border, and wears a fillet over his
      hair. He is shown is three-quarter view, his right arm reaching forward to take the arm of his
      bride. The bride, head modestly lowered, wears a sakkos and earrings, a long, sheer chiton,
      and a himation decorated with a black border and black crosses. The female attendant, wearing
      a simple chiton and sakkos, stands behind her tying the bride's sakkos. The attendant behind
      the groom, also wearing a chiton, is holding up a long sash in both
      hands.</P><P><hi rend="ital">Side B</hi>: two
      women.</P><P><hi rend="ital">Side A, neck</hi>: woman. A woman wearing
      a chiton and himation stands facing to the right.</P><P><hi rend="ital">Side
      B, neck</hi>: man.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

