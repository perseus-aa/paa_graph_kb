<https://aa.perseus.org/id/text/fe5950fcbc8d14195fca12a526593697346568fcdcabba6f02a18b54986ebac6> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>Unpainted areas on the exterior of the vase are worn away leaving painted areas
      noticeably raised. Only a few small patches of original unpainted surface remain. The red
      paint has mostly flaked away.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

