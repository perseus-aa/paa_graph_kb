<https://aa.perseus.org/id/text/2618b23b89ea2213d91f299daef8d5c445eff0998aca48e64ed12cf5d0539c41> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Milkovich 1961, 61-62</bibl>; <bibl><hi rend=\"ital\">BMCRR</hi></bibl> I, 566, 4201; <bibl><hi rend=\"ital\">RRC</hi></bibl> no. 485/1" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/26227639a4a6ad016b2ef00a9faa1913a14c54e9bd3a4751a3466c0c360d8120> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Mother seated, and maid with baby. On the right a woman sits on
      a klismos (chair) facing left, her arms open to receive a small boy which a standing woman
      hands to her. The seated woman wears a chiton and a black himation with red design. Her hair
      is bound with a wide, red band. Over her head hang two small oil jugs and a mirror. The
      standing woman on the left wears a girdled chiton or a peplos, and has her hair held up with a
      red band. The boy is naked. An amulet band lies on his upper
      body.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/2625fdaf944b7f0f333e8cffe3cfdea2364dce9987c3f38a7c4ddc52d9e062b7> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>The design is in white and yellow paint on a black ground. A
      swan stands to the right, with its wings spread. It perches on a flower, the tendrils of which
      spread to either side, over the body of the vase. The swan is painted white, with yellow bill
      and legs. The wings are picked out with yellow. The neck of the vase is encircled by white
      vertical lines, and a row of yellow dots.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/2636cea402f994e21e8ee5542fffcf7e7d7f6828e89029c8ce7d31e065e32e85> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<P><bibl>Leekley and Noyes 1975, 34</bibl>; <bibl>PECS, 757</bibl>; <bibl>Rossiter 1977, 684</bibl></P>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/2638e4fce18020db3b9a19b4d45f4626136fe4ee4c746ce5e2b69966716c6842> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Herakles and Kerberos."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/2641abbdd5443594261509020067d4077466f84c4744ee2aa2eb00bf432fcd3b> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>The exterior rim is inscribed with a dedication to Kastor and
      Polydeukes. Both sides of the vessel are decorated with gilt garlands hanging from bukrania.
      The spaces above the garlands are filled with stars, and the offset between bowl and calyx is
      marked with a running wave pattern. Two raised bands encircle the stem, while three bands
      appear on the foot. Pellets inside the hollow lip rattle when the vessel is
      tilted.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/26432f1fbf3e8069c6c1a5fdb80371fe28d1b41761516e557f5d9602f83db9d1> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Side A: athlete washing. Side B: youth."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/2647e826853171999a2d8c3910f73aab6e0b069f4da414edb6b4029d6ed68250> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>Matheson & Pollitt
      1975</bibl></P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/2648fd30e5ac5b208f07b74adea413692606730fa966b246a0f1746485a4f4f8> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Jug with griffin protome as spout, showing lion killing stag, and horse."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/264d87742f337183b4b47d182ff4510a6aa0dc761f643c209195e51b07de54ed> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Seated figure with large horse (?) on wheels."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/2654eea7bb515d34712b94f222e5017c16ffd6c582d2c4cb0a218f5baa17127c> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Side A: Striding winged Eos in right profile, left leg
      advanced, arms extended. She wears a chiton with belted overfold; her hair is gathered at the
      nape and surmounted by a diadem with ornament executed in pellets of clay. In front of her and
      moving away is Kephalos, left leg advanced, head turned back in left profile. He wears a
      chlamys fastened on his right shoulder, a laurel wreath, a petasos hanging behind neck, and
      laced sandals. He carries two spears in his right hand. Behind Eos and moving away from her is
      a similarly attired youth, gazing back at Eos, with his head in right
      profile.</P><P>Relief contour is used for the face, back of the neck, and edge of
      wings of Eos, and for the faces and spears of the youths. Relief line is used for the drapery
      folds. Dilute glaze appears on the ends of hair, borders of garments, thongs of boots, and
      details on wings. Added white includes the ornament on the diadem, the laurel wreath, and
      lettering. A reserved hairline is apparent.</P><P>Side B: a standing youth is seen
      in right profile leaning on his staff and facing two other youths standing in left profile.
      All are draped in himatia and wear fillets; the central youth also leans on a staff. In the
      field are halteres and a bag. Added white is used for the cords of the bag and the fillets.
      Reserved hairlines are seen, as on side A.</P><P>Beneath the pictures is a band of
      meanders alternating with dotted cross-squares, with a reserved band beneath. A leftward
      laurel wreath between reserved bands encircles the vase above the pictures. A band of tongues
      runs around the base of the handles. A reserved groove appears at the juncture of body and
      foot.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/265e576e3e156f657e23957125d45b6495a7f21925a9b8a623081febe9a1b726> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Crouching warrior fighting hand to hand"@en ;
