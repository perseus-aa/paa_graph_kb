<https://aa.perseus.org/id/text/dd77977da3eb65b73295e9db16d01d28b641e6e671c41380512094081a432710> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>The cup has been mended from many fragments. There is some abrasion of the
      surface on the reserved areas.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

