<https://aa.perseus.org/id/text/a95535822e1bb845c9d7b867bafe9cb2e3c4d626c6b69ff2a26f2c503175dbb7> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
