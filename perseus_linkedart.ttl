    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/2ae9520dadc6a30d5293e1eaf4917e2ce6b02f5ebea7e5b8f0fbcdfe8eb3a680> a crm:E33_Linguistic_Object ;
