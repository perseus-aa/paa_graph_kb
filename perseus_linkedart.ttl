<https://aa.perseus.org/id/text/32b7eac9c5532038be582bb6b9cc2d053ca72f35ed1b963db1a9b57e0c4d4391> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>The preserved pieces are in good condition, showing some loss of the added
      white paint. The horse on side A is scratched.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

