<https://aa.perseus.org/id/text/76b5b710487171f0ced159cdfd07c088bac870a12ae2c839c413045ada7dc5a9> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">BMCRE</hi></bibl> III, 337, no. 780; pl. 62.6 " ;
