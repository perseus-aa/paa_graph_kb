<https://aa.perseus.org/id/text/59463769799edec0fbb7b7b7c54b958ab765702e7335ebc5ad8cc42740fbd916> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<hi rend=\"ital\"><bibl>BMCRR</bibl></hi> I, 381, 3096 ff.; pl. XLI.15; <bibl>Babelon 1885-1886, 1.349,5</bibl>; <hi rend=\"ital\"><bibl>RRC</bibl></hi> no. 383/1" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/596804cf733f6358f4fa5b500611190dbc985cc6c2c41ddd2216da14ad89c86c> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>The vase is in the form of a nude man, squatting on his hips.
      Both of his hands are raised to his breast, and he has short drawn-up legs and a bloated body.
      There are suspension holes through the hands and between the long hair and neck; there is an
      opening at the top of the head for filling. Most of the body is covered with fine black dots.
      On the left shoulder is a lotus ornament, on the back is a serpent, on the right shoulder is
      another smaller serpent, and on the back of the hips are two dogs facing a
      hare.</P><P>The decoration is in lustrous black glaze with applied red. The man
      wears red boots and a red fillet; his hair and beard are
      black.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

