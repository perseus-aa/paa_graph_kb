      right maenad on Side B.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/76c3295bb7cac7e0be0840c242f5ca6ef403c062dccc649111eb4db2dfbea229> a crm:E33_Linguistic_Object ;
