    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/a95a7aacbdae0aab930efbd4ae660ae909957b3f969b39f428eb867e7d7eecfa> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>The vase is formed as the head of a satyr. The lines of the
      beard are incised, while the front of each ear shows added red. Rows of applied clay pellets
      form the hair on the forehead. Under the rim a double row of ivy leaves in added white
      decorate the front of the vessel.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/a96daeb1a5c52d594e975c7ce7b4d5c84d3a6e3e11a43ddf3ef3bc30be6ebb11> a crm:E33_Linguistic_Object ;
