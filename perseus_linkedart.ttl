<https://aa.perseus.org/id/text/f573e7e3eb4fae86274882278eda2c749291cda8d2089e30c5a336145fca23aa> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>There are chips on the rim and handles, and spalls especially on Side
