    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/0a26825a449df84ecf1e68b452a0f247395d709257a1b9d2a26fc9619016b22a> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Satyr: double row of relief dots as hair, bushy eyebrows, flat
      spade beard, droopy mustache, upturned nose, grinning mouth. Eyes and irises outlined in
      black, rest of hair white with black wavy lines on beard.</P><P>Maenad: double row
      of relief dots as hair. Eyes and eyebrows in black.</P><P>Red stripe around mouth
      of vessel. Black stripe around foot.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

