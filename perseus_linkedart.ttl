    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/cc4cfa502353db978941f81ed41663ae2420d278588eca21ce2281db5fe0e7bf> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>Coldstream 1968, 75</bibl>; <bibl>Schweitzer
      1971, 48-49, pl. 57</bibl>; <bibl>Fairbanks 1928, 81, no. 269 c, pl.
