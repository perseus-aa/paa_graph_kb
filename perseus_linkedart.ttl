<https://aa.perseus.org/id/text/8c57ef85bc3c837cb42ec6703c34f7a8e57c92317f5887a625f95b0f8bd8cb64> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Nike and youth. Nike flying with a wreath to a youth who
      carries an acontion. The Nike flies in from the left holding a wreath toward the youth with
      outstretched hands. Her wings are extended behind her, and she wears a chiton, short mantle
      and a broad fillet over her hair. The youth (a victor in the javelin throw?) stands on the
      right holding an acontion in his right hand. He wears a mantle and
      wreath.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/8c6427961b736a50ff3667d382dae95eaf410bc4e304bbd2588330e4b7c261a3> a crm:E33_Linguistic_Object ;
