<https://aa.perseus.org/id/text/75bf7322fb631f438fce5e6a338118ab81c19101b00842810251bab1d16834d8> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Williams 1984, 150-154, no. 107</bibl>" ;
