<https://aa.perseus.org/id/text/13fc6e7eac382fa8e767858b0fd8c4570f785e9d434ac5a950fab6db9bdfeae6> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>Unbroken. Considerable surface pitting and wear, particularly on the lower part
      of the white ground area. The figure at right is largely effaced, and the lower half of the
      woman at left is badly damaged. Many of the added colors have worn off, especially the
      garments of the deceased and the figure at right. The black glaze on the mouth has
      suffered.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

