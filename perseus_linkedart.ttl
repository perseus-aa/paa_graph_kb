<https://aa.perseus.org/id/text/530d19702e9110c36a252df999e5b7f83a6db63cb3ed74e848fdeaf7c6921558> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Tondo</hi>: in black figure, a
      bearded man runs to right looking back over his shoulder. He wears a himation with added red
      stripes. Added red is also used for the beard and hair. Written in the field is <foreign
      lang="Greek">*M*E*M*N*O*N *K*A*L*O*S</foreign>. The exterior is in red figure. <hi
      rend="ital">Side A:</hi> eyes with wreathed running youth between. <hi
      rend="ital">Side B</hi>: eyes with nose between. Palmettes appear near the
      handles.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

