<https://aa.perseus.org/id/text/60109fe352249d604059286dd7b660ab14bfddaf6615e8e5a9b16c96e53ed096> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">RIC</hi></bibl> IV.2, 89, no. 246" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/6012a818934b3b2e64ab82583326f1331ab4f5ea0c9a972400a7b573aab12224> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Side A:</hi> A winged Nike flies
      above a groundline with a continuous maeander broken and running right. She is dressed in
      Ionic chiton and himation, wears bracelets and necklace in added red, earring, and stephane,
      and carries a thymiaterion (incense burner) and phiale. Her legs are visible through the folds
      of the chiton, and dilute glaze is used for the top of her hair and the
      bangs.</P><P><hi rend="ital">Side B</hi>: A youth draped in himation
      with black selvage and leaning on a staff reaches out with his arm. The details of musculature
      are done in dilute glaze. The drapery is like that on the painter's earlier mantled figures
      with peaks at the shoulder and bulk at the waist. The flat, two-dimensional drapery and
      angular body contours with inner details are characteristic of his "Middle" period
      (<bibl>Kurtz 1983, p. 70</bibl>). He stands on a groundline with stopt key
      pattern.</P><P>A double palmette decorates each handle and
      below.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/601bb9fc595f31c246d38aef88e83d41cd66adff804ebd8bee8c0b8744ec233a> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Brouskari 1974, 158-59, fig. 334</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/6021bfae42bafc1cc0613d271a260da77bc3b62bc0349fa77fc97d4a3c7aa0ee> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>The surface of the vase is covered with small chips and has suffered some
      discoloration.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/602b6b88b276218f1a47b311f85077980f75673dd56b5d3a7464c804d852482e> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Woman stands with her head turned to the left, and wears a
      chiton embroidered with tiny stars, a himation, and earrings. Her hair is tied in a krobylos
      with a red fillet. In her extended right hand she holds an oinochoe from which she pours a
      wine libation. In her left hand she holds a phiale. On the ground beside her is a kalathos
      full of red yarn. On the shoulder, a mirror, a pair of krotala, and a sakkos are
      visible.</P><P>An ovulo appears around the lower neck. The base line consists of
      meanders to the right.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/603ee81e4315c6ce4492de128ea791654fa5e8e7167b19fb0959397070f4a665> a crm:E33_Linguistic_Object ;
