<https://aa.perseus.org/id/text/f6e72079a5093a2266014e0bba71ac4a9630e17230f56f646b1a108e312c52a4> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>A girl with a wool basket. A girl is seated in front of her
      wool basket holding out an ivy wreath which she may just have completed. She is on the left
      side of the scene, the basket on the right. She has long black hair and is dressed in a chiton
      and himation. Her chair has a high, slightly curved back. Two spindles and some wool protrude
      from the basket. There is an undulating snake above the
      scene.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

