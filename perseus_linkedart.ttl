<https://aa.perseus.org/id/text/9a9d6715dc17a38c8a3676341a32ba9c6848a3b5d439169c1e38cd89d7827259> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Side A: Torch-racer and two other athletes. Side B: man, woman and woman with thyrsos.
      Tondo: satyr and maenad in erotic union."""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

