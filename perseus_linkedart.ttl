<https://aa.perseus.org/id/text/c8e26e7cd87ca5137a59284296df154e84e050d601f4884b2912f7e7df1a4bfd> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Herakles battling Kyknos while Athena, Hermes, Ares, and Aphrodite look on. Neck:
      confronted lions. Lower Register: Standing youth between seated lions, flanked by
      sirens."""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/c8e48b7259e46a43b1cbe565a1f434a7e62fbe51425b09a44e99c42758e1fe61> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>Williams 1984, 186, no.
      120</bibl></P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/c8e8f322cbd0584493ee7d1baeab746cac65a083ae3ff153eff4f1853633deef> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Plastic aryballos with lion's head spout and painted decoration
      on body in three miniaturist registers.</P><P>On the main, upper register is a
      hoplite battle, with seventeen armed hoplites in combat. Some hoplites stand, thrusting their
      spears at their fallen opponents who are on their knees in front of them. Most hoplites carry
      two spears. They carry round shields with various devices, including a cock, a ram's head, a
      swan, a bird, a winged animal and other symbols.</P><P>On the middle register is a
      horse race, with riders galloping to the left, their left hands holding their whips behind
      them. The spaces beneath the horses are occasionally filled with animals and birds. On the
      lowest register, a hare hunt: a rabbit runs to the left, chased by a dog, while the hunter
      hides behind a stylized bush.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/c8e94915d68fb18acb6a144357f398014f67fbe9db1394da047d7b45423f871b> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Side A: Oscan warriors, woman, and boy<BR>Side B: Dionysos, maenad, and
      satyr"""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

