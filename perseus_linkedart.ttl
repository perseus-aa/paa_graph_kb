<https://aa.perseus.org/id/text/69eff0beb417d52119c807f926415b39c2f603c2ce6acbd205d9d09711caf4ed> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<bibl>LIMC</bibl>, 7.914 s.v. Thebe no. 3 (C. Vlassopoulou);
      <bibl>Shapiro 1993</bibl>, 100, 103, 241 no. 49, fig. 56; <bibl>Robertson
      1992</bibl>, 247-48; <bibl>LIMC</bibl>, 5.799 s.v. Ismene 2 no. 1 (G.
      Berger-Doer), 801 s.v. Ismenos no. 2 (ill.) (G. Berger-Doer), 867 s.v. Kadmos 1 no. 19, pl.
      559 (M.A. Tiverios); <bibl>Add2</bibl>, 341; <bibl>LIMC</bibl>, 4.883
      s.v. Demeter no. 46 (Beschi); <bibl>Shapiro 1988</bibl>, 206; <bibl>McPhee
      1973</bibl>, 56 no. 29, pl. 26.1; <bibl>Mtzger 1965</bibl>, 99;
      <bibl>Vian 1963</bibl>, 38 no. 11 pl. 5; Beckel 1961, 75 n. 669; Grossman 212;
      <bibl>Neugebauer 1932</bibl>, 127-28; W. Hahland, Studien zur attischen
      Vasenmalerei um 400 v. Chr. (Marburg 1931) 70; J.D. Beazley, "Notes on the Vases in Castle
      Ashby," BSR 11 (1929) 27; M. Bieber, "Der Chiton der ephesischen Amazonen," <hi
      rend="ital">JdI</hi> 33 (1918) 52, fig. 3; G.E. Rizzo, ""Vasi Greci della Sicilia.
      Parte I. Cratere di Camarina,"" <hi rend="ital">MonAnt</hi> 14 (1904) 15 fig. 2
      pl. 3; <hi rend="ital">CIG</hi> 8426; <bibl>Roscher</bibl>, 2.1
      (1890-1894) 838 s.v. Kadmos (O. Crusius), fig. 2; E. Gerhard, Etruskische und kampanische
      Vasenbilder (Berlin 1843) pl. C.1-5.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/69fdb42493c30adc6c26a55a021f91e2c56579f2c9ba13eaa1f9bf5b8c814fe5> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<P><bibl>Clairmont 1993, 2.485-86, cat. 2.398 (ill.)</bibl>; <bibl>Vierneisel-Schlrb 1988, no. 9</bibl>.</P>" ;
