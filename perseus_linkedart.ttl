<https://aa.perseus.org/id/text/42692fc728ee4a1df9959255c8c6c5fd8258c4d7a021d39566cf663805c30ed1> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "The cryptoporticus, the lower level of the original Forum of Arelate, which was perhaps used as a granary or for other mercantile purposes, underlies the modern city. It is now accessed through the former Chapel of the Jesuits (a 17th c. structure). "@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

