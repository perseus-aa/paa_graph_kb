<https://aa.perseus.org/id/text/917f1ad5f52adcff43ec637adccf7e701008a5a5eface60b4b0ef81f13f72782> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">BMCRE</hi></bibl> V, 44, no. 145; <bibl>Cohen 1880-1892, 4.418</bibl>" ;
