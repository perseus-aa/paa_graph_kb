<https://aa.perseus.org/id/text/c13f590933d1b4be24541bf7fbacd12c24fa088301db5843619545cc95a622c7> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>von Saldern 1968</bibl>, no. 12" ;
