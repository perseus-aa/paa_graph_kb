<https://aa.perseus.org/id/text/965a534f5944b691e3ebac6ebce17e1f3df28fa4b4ce4be88f952da1e0e197e9> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>In reserve band around handle zone: <hi rend="head">Side
      A:</hi> two cocks fighting, flanked by two hens. Cocks have ruffled breast- and tail
      feathers. <hi rend="head">Side B:</hi> grazing goat, flanked by two winged sirens.
      In the tondo, concentric circles. Palmettes flanking
      handles.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

