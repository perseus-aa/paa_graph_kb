<https://aa.perseus.org/id/text/63522a70a664f102ce17ee1ce0c98418de9287dd1899bf6c8cd844dd42d3c5dc> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Side A: A satyr at right, runs to left, chasing a girl/nymph in
      a chiton and himation who runs to left. The satyr's penis is
      infibulated.</P><P>Side B: A satyr is chasing a maenad with thyrsos, sakkos and
      holding castanets (krotala).</P><P>There is an ovulo above the scenes, as well as
      palmettes at the bottom of the handles.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

