<https://aa.perseus.org/id/text/ec57743aa5fe3a928cf2b7c0be101346ccad3a43f10e9a1e7425aeada67d1d96> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>On the shoulder is a band of tongues, alternately red and
      black. Around the upper body, just below the shoulder, is an ivy vine. Below this is black
      band framed by triple stripes, then another ivy vine above a final group of three stripes. A
      third ivy vine, framed by stripes, circles the top of the rim. On all three vines, the leaves
      are alternately red and black. The neck, the side of the rim, and the inside of the mouth are
      black. The side of the foot is reserved, the rest black, with a red stripe around the
      top.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/ec5a6fc97fa8b2b584987c93f4252fa46e2288aec8ee8f5027b38ba923ca018a> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """Shallow bowl with applied figures on interior. Seated Orpheus playing
      lyre, surrounded by boar, rabbit, antelope, bear, goat, stag, lion. Tree to left of
      Orpheus.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/ec685c8ce32645ee48302d56f00ae4101456b87c0de1d4350156bac7d5de0afb> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>The surfaces of the shells are decorated with alternating red
      and black glaze stripes.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

