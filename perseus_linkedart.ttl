<https://aa.perseus.org/id/text/d7129d473c447b882974705e508317e16eea08d9edc4f93a74a9ab8a681702fd> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>The vase is painted black, with the decoration in opaque white
      paint and the hair and inner details of the drawing in gilt. A child is shown crawling on his
      hands and knees to a little dog, on the right.</P><P>This type of vase was a
      present to a child for the Festival of the Anthesteria; they were also buried with children
      who had not lived long enough to attend the festival, in the same way that unmarried girls
      were buried with bridal vases.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

