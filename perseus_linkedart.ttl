<https://aa.perseus.org/id/text/8044d2d824a4424ca256e3fdae60bbff283953e7ff65bdde988f99563fc1a6e0> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Brommer 1977</bibl>; <bibl>Brommer 1979b</bibl>; <bibl>Robertson & Frantz 1975</bibl>; <bibl>Boardman 1985a, 106-09, 172-74</bibl>; <bibl>Robertson 1975</bibl>; <bibl>Stewart 1990, 155-57</bibl>; <bibl>Bruno 1974</bibl>; <bibl>Shear 1978b, 36 n. 89</bibl>; <bibl>E. Simon 1983, 55-72</bibl>; <bibl>Goddess and Polis 1992, 25ff.</bibl>; <bibl>B. Nagy 1992</bibl>; <bibl>Connelly 1996</bibl>; <bibl>Pollitt 1997</bibl>." ;
