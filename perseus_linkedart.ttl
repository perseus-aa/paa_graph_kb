<https://aa.perseus.org/id/text/9ea1e275a2ec7fb97ffa12072669a749ffa16a34cc5a575ecadecda3327af525> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Stoa; in the Sanctuary of Apollo, south of the Apollo Temple platform, with the southern, polygonal wall of the platform forming the north wall of the stoa."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/9ea4a932bf4d92745b68f14dd69bd047903b4a2a5fa739df1af4f29817b8407e> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Youth holding wineskin and staff."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/9ea77e3b07fe9349ec2660adc1c1138393cdeaa00252dcb73c0ca1bf137d3a08> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Int.</hi>: A nude girl (probably a
      <hi rend="ital">hetaira</hi>) bends over to pick up or put down a washbasin. She
      is shown in profile to the right, and wears her hair tied up in a scarf with a symposiast's
      wreath around it. The basin she is holding appears to be made of metal. It has four handles
      around the rim, and three legs with lions' feet terminals.</P><P>An inscription
      runs around the tondo behind her back, <foreign lang="Greek">*E*R*M*A*I*O*S
      *E*P*O*I*E*S*E*N</foreign> ("Hermaios made (me)").</P><P>Hetairai were
      common subjects of drinking cups such as this kylix. See for example the kylix from Rhitsna
      with a similar scene (Burrows, 226-318).</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

