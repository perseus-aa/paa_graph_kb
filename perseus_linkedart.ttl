<https://aa.perseus.org/id/text/e092047ddb19c494966894181eda373708315152f5d8e4cd08879a9a7c7a5cbc> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<P><bibl>Wiegand & Schrader 1904, 172-182, figs. 166-177</bibl>; <bibl>Schede 1964, 101-106, figs. 124-127</bibl>; <bibl>Hoepfner & Schwandner 1986, fig. 147</bibl></P>" ;
