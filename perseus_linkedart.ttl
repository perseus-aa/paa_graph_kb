<https://aa.perseus.org/id/text/67f680d2e1fd75aed14008d4d3deffce41aac9ae1f7f7c24542a7988648adeba> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>Beazley 1951, 58</bibl>; <bibl>Boardman 1974,
      fig. 86</bibl>; <bibl>von Bothmer 1985, 134-37, no. 25</bibl>;
      <bibl>CVA, USA 14, Boston 1, pls. 27, 28.3</bibl>; <bibl>LIMC, I, pl. 109,
      Achilleus 508</bibl>; <bibl>Mommsen 1975, pl. 136</bibl>;
      <bibl>Schefold 1978, fig. 189, 270</bibl></P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/67f98e87c7e16e5193a15828f11de4fa163b642279f20c4b0b2dd8a52501d35f> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Side A: Three herms<lb>Side B: A girl with a sacrificial basket on her head, and
      a youth reaching for a hydria"""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/67fa73761dc766de5c30300a18657c2a1c67594a091eea723095cdca5dfabd9c> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Vierneisel-Schlrb 1988, 140-43 nos. 24-25, pls. 54-57</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/67ffc2e7f885902e106377feb8174f3e7176bd9da9c43abe056ed1cb7929bd65> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Side A</hi>: Two warriors are
      fighting, the one at left overpowering his opponent, who falls to the right, his bent legs in
      profile to the right, his torso frontal, and his head turned back to face his assailant. Each
      is nude but has different equipment. The victorious warrior wears greaves and a Corinthian
      helmet with a low white crest. He carries a Theban shield with a red interior and holds his
      spear in his right hand, raised high to administer the death blow. The falling warrior wears a
      Corinthian helmet with a stilted crest and has a sword on his hip; an incised line across the
      midriff suggests a belt rather than a baldric, an unusual arrangement. Even more unusual is
      the fact that he seems to be left-handed, for he holds his spear in his left hand and has a
      round shield on his right arm, its white color now largely eroded. At left and right, watching
      the combat, are two pairs of figures. In each pair, the figure closest to the handle is a male
      in a red himation: the one at left a youth, the one at right a bearded man. Before each of
      them, also watching the combat, is a woman wearing a peplos and himation, the latter pulled
      out in front in a manner that has caused such women to be nicknamed "penguin ladies." Rosettes
      float in the field to the right of the man and between the legs of the victorious
      warrior.</P><P><hi rend="ital">Side B</hi>: A nude youth stands
      between two seated sphinxes. The youth's legs are in profile to the right, his torso frontal,
      his head in profile to the left. His right hand is lowered, his left hand raised. Two vertical
      rows of dots "pseudo-inscriptions" flank his lower legs. The sphinxes have long hair that
      overlaps their wings, the right one with a row of red spots in her tresses. The coverts of
      their wings are painted with added red, and their faces and breasts are rendered with added
      white. A rosette floats in the field beneath the sphinx at left.</P><P>On either
      side of the neck is a lotus and palmette quatrefoil, with lotuses at top and bottom and
      palmettes on the sides, all connected by tendrils. Added red is used for the hearts of the
      palmettes and the cuffs of the lotuses. Above the figures on either side is a band of tongues,
      alternately red and black. A single brown stripe of dilute glaze serves as a groundline for
      the figures; below this, circling the vase, is a stripe of added red. The fillet between neck
      and body is red, and there are red stripes around the edge of the mouth and the foot. The
      handles, foot, and lower body are black, as are the inside and outside of the
      mouth.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/680596c0c4b2c798fc5565fa23c31076c6c35d98368f466706f8a90dc45d8328> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
