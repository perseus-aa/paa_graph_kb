<https://aa.perseus.org/id/text/81135c191720af5a05d3a7b8f1cc54c4fd2a80dafe5428ac0306a95ee3cd4d86> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Bruns-zgan 1987</bibl>; <bibl>Xanthos 2, 50 (Metzger)</bibl>; <bibl>Pryce 1928, 134-37</bibl>; <bibl>Smith 1892-1904, no. 81</bibl>" ;
