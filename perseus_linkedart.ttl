<https://aa.perseus.org/id/text/fdb3efe030c1e7a013622718fef5ddcdbd9950ead00e8fbfda5076e830960e0f> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """Parts of the figures of Ajax and Kassandra missing, including Kassandra's lower body,
      entire right leg and upper half of her left leg, Ajax's legs, except for the right foot and
      ankle, and the toes of his left foot; toes of Athena's left foot missing; other losses along
      the breaks, and some abrasion of relief line.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

