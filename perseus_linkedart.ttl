    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """A (upper level): The Judgment of Paris<lb>A (lower level): Hebe (labelled), Hera
      (labelled), Hermes, Paris, Athena, Eros, and Aphrodite.<lb>B (upper level): Tripod,
      satyr, woman, Apollo, Dionysos, woman, satyr<lb>B (lower level): Woman and
      satyr"""@en ;
