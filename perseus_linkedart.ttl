<https://aa.perseus.org/id/text/fa2f769c498b0506b628f605edeb2450ac2232595a544465653b5ba505572def> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Plastic shape of horse's head. On cup: silens and maenad"@en ;
