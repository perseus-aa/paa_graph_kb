<https://aa.perseus.org/id/text/548033f815adcf8430da465564cd4f9d045bb62153c71e59b5377ccd6aa9647d> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Side A</hi>: woman (goddess). A
      woman stands facing right holding a tall scepter. Her other hand is on her hip. She wears a
      chiton and himation, her hair in a sakkos.</P><P><hi rend="ital">Side
      B</hi>: woman (goddess). A woman stands facing right, her head turned to the left. She
      holds a scepter in her left hand; her right hand is held at her waist. She is wearing a chiton
      and himation and a sakkos.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

