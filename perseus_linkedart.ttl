<https://aa.perseus.org/id/text/b44944944ae22e42ad2913380faa4aae063616b8404faf3c1c2a7fbd67770f36> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Bands of Geometric motives."@en ;
