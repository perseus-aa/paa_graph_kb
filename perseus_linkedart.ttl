<https://aa.perseus.org/id/text/ab3897e2338e331115624f06bd65cb695e168cd99f539a10a85fd129eca45b0d> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<P><bibl>Vierneisel-Schlrb 1979, 23-35 no. 4</bibl> (with previous bibliography)</P>" ;
