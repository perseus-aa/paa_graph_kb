<https://aa.perseus.org/id/text/be6a312d6811ff2643f0c6e23f1e3383e784d08cf1b7e616d4c9ffc6772f8235> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Interior: sailing around the rim on opposite sides are the
      prows of two warships in added white, lacking interior details but with clearly defined ram,
      vertical bowsprit, and oarlocks on the deck. Between are two red octopi. Around the omphalos
      are red tongues. Exterior: there is a broad black band below the
      lip.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

