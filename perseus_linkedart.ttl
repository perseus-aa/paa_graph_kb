    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<bibl>C. Sourvinou-Inwood, "Menace and Pursuit: Differentiation and the
      Creation of Meaning," in C. Brard, C. Bron, A. Pomari, eds., <hi rend="ital">Images et
      socit en Grce ancienne</hi> (Lausanne 1987) 41-58</bibl>; <bibl>C.
      Sourvinou-Inwood," A series of erotic pursuits: images and meanings," <hi
      rend="ital">JHS</hi> 107 (1987) 131-53</bibl>; <bibl>Oakley
      1990</bibl>.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

