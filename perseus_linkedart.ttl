<https://aa.perseus.org/id/text/4cd14b1a327358e1f6cf649a8971a11bf4e127e3508f116912fd6b89d88a4d92> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Interior: A naked hetaira reclines facing right, while playing
      kottabos with a large skyphos. There is a kalos inscription in the field around her head. Side
      A: A reclining hetaira is playing castanets, while a youth in front of her holds a large
      skyphos, offering it to her. Another youth behind her is dancing. Side B: Three naked revelers
      dance; the central figure is playing castanets.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

