<https://aa.perseus.org/id/text/858b56e225034b8455f19c397a8e9104ab234f8fc8c4f9b1c6b5b8beb32091bb> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Tondo: youth seated to right on a stool. He wears a red fillet,
      and a himation hangs from his leg. He rests his hand on his knotty staff. In the field at
      right hangs a sponge, strigil, and aryballos.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/858f1a1cce7652ccd8d07f7001faa80d9af99e982554887ba07a17d4d0eadad1> a crm:E33_Linguistic_Object ;
