    crm:P190_has_symbolic_content "<bibl>Hamiaux 1992, no. 41</bibl>; <bibl>Adams 1978, 124</bibl>; <bibl>Boardman 1978a, 14, fig. 36</bibl>; <bibl>Hiller 1975, 136</bibl>; <bibl>Ddalische Kunst 1970, 121ff. (Drig)</bibl>; <bibl>Richter 1968, 33 no. 20, fig. 81</bibl>; <bibl>Charbonneaux 1963, 7</bibl>; <bibl>Jenkins 1936, 71</bibl>; <bibl>Cat. Som. 1922, 41 no. 3099</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/aabbc0261f987f9ba24c0e6cf68cb47e8884cf33be53ff24b87cb9bcb587c370> a crm:E33_Linguistic_Object ;
