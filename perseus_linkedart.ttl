      131</bibl>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/2a912f34559a032b27ae30afb249b499d45cb809b8a88d7cf4d2dc5b9047a203> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
