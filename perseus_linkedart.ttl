<https://aa.perseus.org/id/text/2fffce6a706cbaf601ec583c26bf30ebf06ba889d965e1820440a3ed3f24175d> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>Drill holes and remains of bronze rivets indicate ancient repairs, with handle
      B/A and a large adjacent fragment re-attached. The re-attached handle is smaller than handle
      A/B and may not belong. Other repairs indicate modern breakage. Glaze well-fired and glossy. A
      circular indention around the exterior was probably caused by setting the cup within the mouth
      of a larger vessel while drying.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

