    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "C. Vermeule, <hi rend=\"ital\">Numismatic Circular</hi>, June 1965, 133, 134, figs. 7, 8; <bibl>Robertson 1967, 176</bibl>; <bibl>Romans and Barbarians, 94, no. C 34, illus.</bibl>" ;
