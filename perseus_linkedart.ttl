<https://aa.perseus.org/id/text/c2caf673aa18196749059d903a4d1a3ae08bad6e048a2b0c75f1528da8b50aba> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """Beaker with emblems in relief on exterior. Relief appliqus: grape
      clusters below rim; an inverted swag high on each side; below, a running gladiator and a prone
      gladiator attacked by bear; vertical stalks of olive leaves and fruit as dividers. These are
      scenes of the brutal entertainment offered in Roman amphitheaters. Handle has foliate relief
      decoration. Glossy red slip.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/c2db931cbdc8f85b487bfe7c86652ae3f45f3d867c635bb7d2714a82ed86294a> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Persian king in two-horse chariot, with disk of the sun and leonine griffin"@en ;
