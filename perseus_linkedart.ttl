<https://aa.perseus.org/id/text/df69bb3dc3a880dedc570d8c17149d4d6b6f9c93cc59c048ce798f731e622922> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Freyer-Schauenburg 1974, 93-95 no. 48, pl. 34</bibl>" ;
