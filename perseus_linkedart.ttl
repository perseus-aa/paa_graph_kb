<https://aa.perseus.org/id/text/49271fd2091a59f699aac4d04142afd355c5c07f8c42f942072ea9351b00818b> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "A banqueting god and goddess, attended by a nude serving boy"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/4930ecbfce32218787e51802f1dba4c301cffc456eebb6f21bdc1651b91a842a> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Side A: satyr (mid-body restored) dances to right, gesturing at
      a goat facing him which rears up on its hind legs. The satyr wears a red wreath and looks at a
      maenad who advances toward him from the right, a flaming torch in each hand, the right hand
      outstretched, the left lowered. The maenad wears a chiton, himation, earrings, and a reserved
      fillet that ties her hair in a krobylos.</P><P>Side B: nearly identical; the
      satyr's left hand touches the goat. The maenad's left shoulder and the bottom of the left
      torch are restored.</P><P>The upper frame is made of lotus buds, the side frames
      of net pattern. A red stripe circles the lower body.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

