    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">BMCRE</hi></bibl> IV, 258, no. 1611 (no drapery); <bibl>Cohen 1880-1892, 2, no. 433 (no drapery)</bibl>" ;
