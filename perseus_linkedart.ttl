<https://aa.perseus.org/id/text/54ddc4f0cc681c601c5d5c49f298c32c0a0baf4743d537f6fb2c95f0b8505b8b> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Gadbery 1992, 487</bibl> (disassociates the reliefs from the Altar of the 12 Gods in Athens); <bibl>Boardman 1985a, fig. 239</bibl>; <bibl>Ridgway 1981, 206ff.</bibl>; <bibl>Harrison 1977a, 421</bibl>; <bibl>Langlotz 1975, 91ff.</bibl>; <bibl>Harrison 1964, 76ff.</bibl>; <bibl>Charbonneaux 1963, 27</bibl>; <bibl>Anti 1959, 76</bibl>; <bibl>Gtze 1938, 189ff.</bibl>" ;
