<https://aa.perseus.org/id/text/bd2de0d921d302bf9048599ba9d15717122afd212d702a03c505dfe4c1b1ab08> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Interior: maenad<lb>A and B: maenads attacked by silens"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/bd37cfe3a836ca36d1f2739b10acfdffae698271f41896ffe43010944afb7583> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Side A</hi>: head of horse. The
      head and neck of a haltered horse is drawn in profile to the right. Its mane is divided into
      eight locks which fall over its neck. The forelock is divided into two locks and falls between
      the horse's ears. Added red is used for the mane, and deep incision marks the halter and
      facial features of the horse.</P><P><hi rend="ital">Side B</hi>: head
      of a horse. The horse on side B differs only slightly from that on side A; the mane is here
      rendered in seven locks rather than eight.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/bd4372bfe0bc08df6ec632d81b3044e9088cc3c9cb13ddc08fc05c9c10f08bed> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Standing woman clutching her skirt with her right hand"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/bd473804911b04727e22f561833a4f9d497f3dfc64c3887d474ecefdc9d8daad> a crm:E33_Linguistic_Object ;
