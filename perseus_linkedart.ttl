<https://aa.perseus.org/id/text/ee971b8d4e5756c7ad8790cd3fa37bf83f35b44259c027571b434f248a800cf1> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Toynbee 1944, 149, no. 25, pl. 47.5</bibl>; <bibl>Cohen 1880-1892, 6, no. 380</bibl>; <bibl>Greek & Roman Portraits 1972, no. 79</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/eea189d6ad8f7e1cae8a740dc62d32edb849b6220337b8a7e08dc8f703e7eaa4> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="head">Side A</hi>: lion. The lion strides
      to the right open-mouthed. Its tail is curved in a figure eight above its back, and there is a
      small rosette under its belly.</P><P><hi rend="head">Side B</hi>:
      grazing deer. A doe faces left, head to the ground. There is an incised rosette under its
      belly and one over its neck.</P><P>The neck of the vase is decorated with
      interlocked lotus buds and flowers.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/eeaf42ee63970baf1836347c65abd1730101011fa9ca302b7ad99d34bdbfc2b8> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">BMCRE</hi></bibl> III, 10, no. 68; <bibl>Cohen 1880-1892, 2,9, no. 93</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/eeb3b2edd17de6c061ea7b95b0928facbe3aeff535f6f9fc1f410f54592f6b3c> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Lewes 1920</bibl>, no. 42" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

