<https://aa.perseus.org/id/text/16dd36767744acd03f25a2e5b677f724a2792b7f6502c57cd1cf4fec7676d536> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>Neck and handle broken and repaired. Considerable pocking and abrasion of the
      white slip and added colors. Some repainting; e.g. parts of the red
      himation.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

