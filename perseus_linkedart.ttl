    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Standing male youth with left foot advanced"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/c15a93bb3e4dec78ecd5511236521da461d207643491110ae96f95de3e925f23> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Richter 1984, 132, fig. 94</bibl>" ;
