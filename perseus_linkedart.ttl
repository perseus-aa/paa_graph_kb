<https://aa.perseus.org/id/text/f6cffc8939fe771b5ac189d1ba53465242e5b9b0c86f87789af190c17a092269> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">RIC</hi></bibl> V.2, 566 no. 82" ;
