<https://aa.perseus.org/id/text/0638335c691c1806817e7d57b6449b8669215f312bb81dbed265255cb749c8f9> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<P><bibl>Rossiter 1977, 287-88</bibl>; <bibl>PECS, 889-890</bibl>; <bibl>Leekley and Noyes 1976, 53-54</bibl></P>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/063c1b47f647627104765ae233525243b089f7d35a557c21d65bfd62f9eb01b2> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
