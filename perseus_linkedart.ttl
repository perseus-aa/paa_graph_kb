<https://aa.perseus.org/id/text/25cb940b30546d3ff1b0eab64ef4d5769cb5ec107a6d6d9e7a966d32c8361759> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Side A: Athena Promachos striding left. Side B: Charioteer
      driving right. Added red: Side A: Rim of shield, edge of helmet, border of peplos, combs,
      gullets, and breasts of cocks. Side B: Beard of charioteer, part of the chariot, tails of
      horses. On both sides: Line circling vase at bases of panels. Added white: Side A: Flesh of
      Athena, Pegasos. Side B: Chiton of charioteer.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/25d0a6dafad2b4089cee2cdc4ff63eaa47d7d1b93bc76487a67b6888b5a8670e> a crm:E33_Linguistic_Object ;
