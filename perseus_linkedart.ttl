    crm:P190_has_symbolic_content "<bibl>Richter 1961, 10 no. 1, figs. 1-7, 191</bibl>; <bibl>Richter 1954, 7 no. 9, pl. 12, 4d-e (with previous bibliography)</bibl>" ;
