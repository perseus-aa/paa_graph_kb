<https://aa.perseus.org/id/text/849fbcc8d28ddc671ae9ab4aef7a208d8c8426bf15fc6ba37f36f4ec6006e5d3> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
