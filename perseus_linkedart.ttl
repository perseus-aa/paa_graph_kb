<https://aa.perseus.org/id/text/15407eba3145bac71bb58b7a58049556099ab084af4e3becad88e06196b6f431> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>Ducati 1968, 24, III, 2, pl. 11b, 12</bibl>;
      <bibl>Simon 1975b, 260</bibl>.</P>""" ;
