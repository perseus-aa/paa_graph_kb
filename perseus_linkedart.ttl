<https://aa.perseus.org/id/text/50ea43befa5ff6e85ef759e3c5d2a82e95977c40abe5984451b9b4ee1cc6430d> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
