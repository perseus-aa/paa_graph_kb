<https://aa.perseus.org/id/text/c68625ba4a080585cef937fe489160f918c29f83adc8099870d947a528e12e2a> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Lawton 1995, 122 no. 84, pl. 44</bibl> (with previous bibliography); D.M. Lewis and R.S. Stroud, \"\"Athens Honors King Euagoras of Salamis,\"\" <hi rend=\"ital\">Hesperia</hi> 48 (1979) 181" ;
