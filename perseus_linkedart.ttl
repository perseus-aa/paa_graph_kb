<https://aa.perseus.org/id/text/4582c20df2a27ea34d2d2d346708e1db464118d1e8c6d6f79b906ceaa8bb2bb9> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
