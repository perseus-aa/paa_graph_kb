<https://aa.perseus.org/id/text/166df40f7c98c259bb998d34a584c2d49cd449b4a7912e796672d75099fd0859> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="head">Mid-body</hi>: continuous frieze of
      chariots advancing to the right. Each chariot is pulled by a single horse and holds a bearded
      charioteer gripping the reins. There are six chariots represented.</P><P><hi
      rend="head">Lower Body</hi>: continuous frieze of warriors. The warriors, wearing
      crested helmets, march to the right carrying round shields and two spears. Their torsos and
      arms are completely hidden by the shields.</P><P><hi rend="head">Neck, side
      A</hi>: six men mourning. Six men move to the right, their right hands on their heads in
      a gesture of mourning, their left hands extended by their sides. They are dressed in
      chitoniskoi.</P><P><hi rend="head">Neck, side B</hi>: five mourning
      women. The five women advance to the right, their hands on their heads in a gesture of
      mourning. They are dressed in long chitons and have the stylized, triangular torsos typical of
      Geometric figures.</P><P>Plastic snakes decorate the rim and handles of the
      vase.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/1674046991297f601e1d3cf28495fbd7dcbe35c108ed5c9a6fb896fcc0b3ce8b> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Amazonomachy<BR>On neck, A, Peleus and Thetis; B, youth with spears (Theseus?)
      pursuing woman."""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

