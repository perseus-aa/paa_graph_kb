<https://aa.perseus.org/id/text/d3d811722c511f80315b46da774744724f4d0e90bed825c3529775db2e9eee05> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Lewes 1920</bibl>, no. 68" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/d3dc1639a160c3328d5c7b4e1af32b979b4787c393294b172b5b9e7420de8c87> a crm:E33_Linguistic_Object ;
