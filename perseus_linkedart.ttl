<https://aa.perseus.org/id/text/7144375a3b757f6b74451d61fb27faa15a485ac2e2f12189b9fc02cfc9a33165> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Footrace. Two nude youths are racing while two men watch. In
      the center of the scene, the two nude youths run toward the right. They have fillets around
      their hair. On either side stands a cloaked spectator looking toward them. Their chitons are
      black and their himations red, they wear little red caps, and they are clean
      shaven.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/714439f42823212e6404b6e40bccedaef9ac6428cf0424fe52eae7fcd09fe2ae> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Side A: lotus palmette quatrefoil between water fowl. Side B:
      same. "Pontic" style.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

