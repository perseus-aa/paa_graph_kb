    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/b516d85060d8461f6512732dc5df4c08e36179296342c34f335bb9963ef6ffa5> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Temple; northernmost of the 3 temples to Apollo in the central part of the Sanctuary of Apollo."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/b5249b97d25aa62ac6b22a4ce81788daa679d3856486678a13a4913c2dbd6979> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>Broken and repaired, with several pieces missing, particularly on side B, where
      the head of the herm and portions of all three figures are lost. Half of the foot, the center
      of the base, and parts of the lower body are also lost. Some missing contours have been
      restored, most noticeably the head of the herm and the top of the mound on side B. The added
      color has worn off in many places. At least one fragment present in the CVA, publication of
      1938 is now lost: it gave the top of the head and part of the basket of the central man on
      side B.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/b526403b671aa78ac00df2fe9f293b89ef69cce5379b395dcac1918bf5cd7b5a> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Main panel: Herakles, Kerberos, and Eurystheus<lb>Rear handle zone: two eagles
      hunting a hare."""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/b5268bc57a0d8c79e11951b4e478933db66053db6ceabce1c1a551c89b703648> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>CVA, USA fasc. 20, pp. 19-20, pls.
      96-97</bibl></P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/b52cbeb83ecaf0efd02bcecea8bbf294004efc067880ec5b67effcecb512bc83> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Nude boy playing the double flute and an youthful reveler in a
      courtship scene. A provisions basket hangs to left. The boy's cheeks are puffed for playing
      the aulos and he wears a red fillet in his hair. The reveler is nude except for a cloak draped
      over his shoulders and a wreath in his hair. He holds a walking stick and the flute case.
      Painted inscription <foreign lang="Greek">*K*A*L*O*S*E*U*X*A*R*I*D*E*S</foreign>,
      retrograde ("Eucharides is beautiful").</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/b52d513e63be089abada301f73fc8f16ecf5e7238495b50f11b6deece6ce1359> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">BMCRE</hi></bibl> I, 197, no. 234; pl. 34, 3; <bibl>Cohen 1880-1892, 1.273.2 = TR P XIIX in fig., but XIX in text</bibl>; <hi rend=\"ital\">Hesperia Art Bulletin</hi> XVII, no. 80" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/b530c85ef591d943581dcc119005885f747517479cfe3813c8e7ef617b8c33ba> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="head">Side A</hi>: Herakles and the
      Nemean Lion. Herakles, on the left, faces the lion, his left arm around the lion's neck and
      grasping the lion's upper jaw with his right hand, forcing his head and chest to the ground.
      The exhausted lion's tongue hangs out; his haunches are raised as he struggles to stand. His
      left paw is stretched forward against Herakles' head as he tries to push him away. Herakles is
      naked and wears a headband. His club leans behind him on the left. A quiver hangs by a leather
      thong above him. A tree is placed centrally behind the struggling
      figures.</P><P><hi rend="head">Side B</hi>: Theseus and the Marathon
      Bull. Theseus and the bull face each other, Theseus on the left and the bull on the right.
      Theseus, standing over the bull, pushes him down with his left arm, forcing the bull's chest
      to the ground while he holds him down with his left foot on the bull's head. Theseus is
      prepared to strike the bull, his club raised behind him in his extended right arm. The bull's
      front left leg is curled beneath him, and his hindquarters are raised as he struggles to stay
      up. Theseus is naked but wears his quiver. A short cloak hangs behind him on the left. There
      is a tree behind the bull.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

