<https://aa.perseus.org/id/text/c7d459ffa7e1cd64e41016218492690e462c11a5a62f3a4c74e06f7903d41b5a> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Interior</hi>: potter. A young
      potter sits on a bench holding a skyphos. In front of him is a stepped construction of three
      levels. A skyphos is placed on the bottom step and an oinochoe on the second step. The youth
      wears a mantle pushed down around his waist to leave his upper body free. He wears a fillet
      around his hair.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

