<https://aa.perseus.org/id/text/36200ec89e2364294d944362e51da12f648a9bd95af6945bf897e07c9c2d05b5> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">RIC</hi></bibl> IV.3, 74, no. 54; <bibl>Cohen 1880-1892, 5.96, no. 14</bibl>; <bibl>Gnecchi 1912, 1.48, no. 4</bibl> = Cohen I (14) variant; M. Gbchow, <hi rend=\"ital\">Mem. Pont</hi> 4 (1938) pl. xlv, no. 16 (same die); <bibl>Greek & Roman Portraits 1972, no 74</bibl>; C. Vermeule, <hi rend=\"ital\">Dumbarton Oaks Papers</hi> 15, 1961, fig. 40; <bibl>Hanfmann 1964b, 98-99, 181, pl. 87</bibl>; <bibl>Hanfmann 1975, 98-99, 181, 324, fig. 87</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/362a02fc1326e3b0c60000c1df2825792aefc6bda99e1dd37b40b46f4009c244> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "A goddess (Dionysos' nurse, Nysa?) draped in a himation over a chiton stands slightly to the left, while next to her sits a youthful Dionysos, in 3/4-view to the left, wearing a chiton and an animal skin (nebris), and holding a thyrsos in his upraised right hand."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/3655e91106a6a839ed8943c87a199bd77f29fae624b5a5ecf6cf68b565e1c2d2> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>The vase was badly fired and is much worn. The rim is misshaped over the
      reverse side. There are indentations on both sides of the body: on the obverse just left of
      center (where there is an unglazed circular red spot), and at lower right of center on the
      reverse.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

