<https://aa.perseus.org/id/text/e2a166c4171df8614eafba92b80b0e03b43171053cbc8b763f4f357c3659d2ba> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>Moon 1979, no. 113, pp.
      202-203</bibl></P>""" ;
