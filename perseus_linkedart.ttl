    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/df6d2903072aa5d7d52ad72f518e27f485606f88956d90b070a43c4f47604045> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">BMCRE</hi></bibl> I, 139, no. 129; <bibl>Cohen 1880-1892, 1.104.304</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/df75f8f37671ea227932ed7efb92091c7f7c4730f1f74dbcb790b1e216e9a0ec> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Svoronos 1903-12, 575-76, pl. 96</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/df77e3d609802e70165258b72907fb68aaedd01b6fdfcb6df04ed2e0233bae0f> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Side A: a man leading a bull to right to sacrifice, preceded by
      a pair of nude men carrying an amphora, slung from a pole. The men wear wreaths and across
      their chests are garlands of ivy. Grape vines grow in the background.</P><P>Side
      B: a youth carrying a basin of offerings on his left shoulder. In his left hand he holds a
      pair of grape vines. He wears a grape wreath on his head. In the center, a nude male drags a
      pig to the right by its hind leg. At right, a man walking right carries a bale on his back
      which he holds in his left hand. He holds a pair a grape vines in his right
      hand.</P><P>Under each handle, a white heron is seen to right. Many details are in
      added white, largely effaced: the beards of the first two men on Side A and the rightmost man
      on Side B, all wreaths and fillets, the ribbons on the bull, the mouth and body band on the
      amphora, and the herons. There is an ivy vine around the rim, with black and red tongues
      around the lower body. In the interior is a reserved circle with a smaller black circle at the
      bottom.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/df87358d7784d41163f47cf21cda02f312a19cb401309219c7ec771873a5c60c> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Argonauts"@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/df8dd0c79693f8a326176a2c139663aa49717eac0f06cb0640e26d3ea4dda302> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content """Side A: Herakles and three Amazons<lb>Side B: Combat, two warriors parted by a
      bearded man"""@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/df91cffd2e4184a45157c0fd3d12511f1d54125085df03f1f5f39a15215c0cac> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content "<P>Broken and mended in part with fragments of another skyphos.</P>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/df9767555d507a9add2e1fadfcbac7ce5961fce5441df926e4ee600ced09190f> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Karouzou 1968, 143</bibl>; <bibl>Svoronos 1903-12, 270-72, pl. 45.5</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/df9c016b46723f1ba6819e4bcb01211ee1f6009eba8f4d6d24f6b6b4e02a42f0> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>On both sides a pair of large eyes. Under eye-brows, eyes with
      red pupils, black iris and a white circle in between. Between each eye and handle on either
      side there is a bushy fan-shaped palmette linked to each handle through a
      tendril.</P><P><hi rend="ital">Side A</hi>: Between the eyes, a naked
      satyr squatting frontally. An ithyphallic satyr is squatting frontally in an indecent
      position. He turns his head to left and holds a drinking horn in his right hand. He has beard,
      horse ears, and wears a red ivy wreath over a long curly hair falling in ringlets over his
      left shoulder. Over his head, in red, the signature of the painter: <foreign
      lang="Greek">*E*P*I*K*T*E*T*O*S *E*G*R*A*S*F*E*N</foreign>: (Epiktetos painted
      it.)</P><P><hi rend="ital">Side B</hi>: Between the eyes, a horse with
      red tail stepping to right. The black inner drawing is almost totally worn. Above, in red, the
      signature of the potter: <foreign lang="Greek">*N*I*K*O*S*Q*E*N*E*S
      *E*P*O*I*E*S*E*N</foreign>: (Nikosthenes made it.)</P><P><hi
      rend="ital">Tondo</hi>: Black figured komast carrying a skyphos. A naked youth with a
      cloak over his shoulders is running to the right, carrying a skyphos in his outstretched right
      hand. On his head is a red ivy wreath.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

