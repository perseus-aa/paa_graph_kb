<https://aa.perseus.org/id/text/ed0a941f3e2a89ac43184d621087375896b69cf24635b06354f06092a7eb693f> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """Bowl with relief appliqus in interior depicting sacrifice of Isaac. Hand
      represents the voice of God stopping the sacrifice. The ram and the tree represent the ram in
      the thicket that was sacrificed in Isaac's place.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/ed0c79c887278849a96372dd6f67ee4381a497db39622b0600de32b4604d630d> a crm:E33_Linguistic_Object ;
