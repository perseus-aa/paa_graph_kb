<https://aa.perseus.org/id/text/52c524f7d68f43e3a2ba3d4ff6509e578de0abd7ba4a327ca1e0d9426681f4c9> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P>Mississippi museum archives; <bibl>CVA, Robinson Collection 2, USA
      6, 28, pls. 36-37</bibl>; <bibl>D.M. Robinson "Illustrations of Aeschylus'
      Choephoroi and of a Satyr-Play on Hydrias by the Niobid Painter"<hi
      rend="ital">AJA</hi> 36 (1932) 406-407</bibl>; <bibl>Webster 1935, 18,
      fn. 32</bibl></P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/52c8ef3c3fa062232e5e46eac8c1b7e7bfe659d29df9a82ccd8e2af573d5ab48> a crm:E33_Linguistic_Object ;
