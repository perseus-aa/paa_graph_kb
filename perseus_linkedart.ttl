<https://aa.perseus.org/id/text/b342368073959a5f5d0d10d0964b0f9fd8a480258637f7eaf91e60b7b550bdcf> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>Broken and repaired, with some repainting of cracks and small gaps, including
      parts of the following: the tongues below the neck, the ivy vine at left, both shields, the
      feet of the horses, gesturing man, and man at right, and the left arm and upper torso of the
      left runner on the shoulder.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

