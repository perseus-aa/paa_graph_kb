<https://aa.perseus.org/id/text/f6e6c380b3e42643f117febd03b387acacb205489925ff8481297345b9ea50ac> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Boardman 1995, 115, fig. 121</bibl>" ;
