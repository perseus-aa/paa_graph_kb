<https://aa.perseus.org/id/text/8ac06852cb49700e0e42e6f66c6d7f911e5545c09a8523e4be1040803bcfd8da> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>Svoronos 1903-12, 257, pl. 38.5</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/8ac3bf29a052df72574f1a03076f09e968e28f50d6b8a0a9628ce6a7b8274ed1> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Side A</hi>: The murder of
      Hipparchos. Harmodios and Aristogeiton are murdering Hipparchos, the brother of the tyrant
      Hippias. In the middle of the scene is Hipparchos, a richly dressed figure wearing a mantle,
      his hair arranged in locks falling over the forehead. He is being attacked from both sides. At
      left, seen from the back, Aristogeiton is plunging his sword into Hipparchos' body.
      Aristogeiton is bearded, and wears a light mantle. On the other side Harmodios, dressed in the
      same way as his friend, but without beard and with blonde hair, brandishes his sword in his
      right hand over his head. All three wear wreaths for the feast and have their mouths open as
      if screaming or shouting.</P><P><hi rend="ital">Side B</hi>: Three
      bodyguards of Hipparchos brandishing spears. The bodyguards, two youths and an older man,
      holding spears, are moving excitedly in all directions. The youth at left and the man wear
      mantles and the youth at right a cloak over his shoulders. Both youths are moving outwards and
      the man in the middle moves his body to the right but turns his head and extends his right arm
      to the left.</P><P>This is the representation of an almost comtemporary event. The
      murder of Hipparchos took place during the Panathenaics of 514 BC (see <bibl n="Hdt.
      5.55">Hdt. 5.55</bibl>, <bibl n="Hdt. 6.109">Hdt. 6.109</bibl>, <bibl
      n="Hdt. 6.123">Hdt. 6.123</bibl>, <bibl n="Paus. 1.8.5">Paus.
      1.8.5</bibl>, <bibl n="Paus. 1.29.15">Paus. 1.29.15</bibl>. The picture of
      this vase seems to be inspired in the sculpture group erected for Harmodios and Aristogeiton
      in 477/476 BC in Athens (<bibl n="Paus. 1.8.5">Paus.
      1.8.5</bibl>).</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/8acb1a37198e702fe9730c28d187775d0cd6c6d00c492792d98c189dd7ec41c3> a crm:E33_Linguistic_Object ;
