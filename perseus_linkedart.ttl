<https://aa.perseus.org/id/text/2988c8421130aa68a39117da5053adf22e700f5201ec691fc922930af7bd9140> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content "<P>Broken and repaired. Glaze slightly abraded.</P>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/299172947e8648fa479e508fb3fa3a9311a42e8d30f5c57a9375ffb6940b3cd6> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Class of Neck Amphorae with Shoulder Pictures. <hi
      rend="ital">Side A</hi> on shoulder: running Gorgon with double wings and frontal
      face between eyes. <hi rend="ital">Side B</hi> on shoulder: running goddess (Iris
      or Nike?) in profile looking back between eyes. Added white for eyeballs and female skin.
      Lotus and palmette chain on neck. Alternating red and black tongues high on shoulder. Rays on
      lower body above base. Thin reserved band on body just above point of maximum
      diameter.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/29a0413fbdb017865a9146bf3b43171116f62de68716a1ce0d16b62d89c0c5ae> a crm:E33_Linguistic_Object ;
    rdfs:label "Summary"@en ;
    crm:P190_has_symbolic_content "Side A: confronted rams."@en ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300080102> .

<https://aa.perseus.org/id/text/29a3c98d699e66d57527b89e0b4fd84626c7e8977906142ea379c65e56f1bce6> a crm:E33_Linguistic_Object ;
