    crm:P190_has_symbolic_content "<bibl><hi rend=\"ital\">BMCRE</hi></bibl> IV, 265, no. 1645; <bibl>Cohen 1880-1892, 2, no. 470</bibl>; <bibl>Romans and Barbarians, 82, no. C25, illus.</bibl>" ;
