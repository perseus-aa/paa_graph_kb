<https://aa.perseus.org/id/text/df41e15bce3a5dd565d248b8ceb3a9a77529e5eb43023b24560677e5f41d6ee7> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Shoulder</hi>: Herakles wrestles
      the Nemean lion. Iolaos stands at left next to Athena with shield, helmet, and spear. At right
      is Hermes. In field, Herakles' quiver, cloak, and scabbard. <hi
      rend="ital">Body</hi>: Apollo struggling with Herakles for possession of the Delphic
      tripod. Artemis with polos, bow and quiver at left and Athena with aegis, helmet, and spear at
      right look on. Figures are labelled as <foreign
      lang="Greek">*A*R*T*E*M*I*D*E*S</foreign>,<foreign
      lang="Greek">*A*P*O*L*O*N*O*S</foreign>, retrograde,<foreign
      lang="Greek">*E*R*A*K*E*O*S</foreign>,<foreign
      lang="Greek">*A*Q*E*N*A*S</foreign>. The panel is bordered above by a battlement
      pattern, to the sides by ivy, and below by a lotus bud chain. Rays on lower body above base.
      The edges of the foot and mouth are painted white.</P><P>This painter, named for
      the charioteer of Apollo who appears on a krater in New York, is among the last of the black
      figure artists.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/df41ec03aea56ca6e4df6c34837244ec3f8b60be9d1e0b2d6c021c236d7c2b91> a crm:E33_Linguistic_Object ;
