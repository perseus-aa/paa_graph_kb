<https://aa.perseus.org/id/text/5c7b7e044514ef8e371887e300c29dc89d8543a05f590a9478a14cf8f3c16559> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>Smith 1896, 406</bibl>; <bibl>Fairbanks 1907, II,
      no. 137</bibl>; <bibl>Kurtz 1975, 60 n.3, 62, 63 and n.11, 205, 221, 223, pl. 47,
      3, pl. 49,4</bibl>; <bibl>Murray & Smith 1896, pl.
      12</bibl></P>""" ;
