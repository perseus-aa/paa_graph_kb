<https://aa.perseus.org/id/text/107d58dd31125b52f17b8e014c67de4535a0f9d998b2d5fec5ed92726102754d> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Side A</hi>: A rhapsode stands in
      profile to the right. He wears a loosely draped himation, and his right shoulder is exposed.
      His right arm is extended in front of him, resting on his staff. He is reciting poetry, as we
      see the words come out of his mouth <foreign
      lang="Greek">*O*D*E*P*O*T*E*N*T*U*P*I*N*Q*I</foreign>("As once in Tiryns . . ."). He
      stands on a platform, on which is inscribed <foreign lang="Greek">*K*A*L*O*S
      *E*I</foreign> ("You are beautiful").</P><P><hi rend="ital">Side
      B</hi>: A flute player walks toward the right. He is dressed in a himation which
      flutters out behind him, and a sleeveless overshirt decorated with a checker pattern. This
      same pattern is seen on the shirt of another flute player ; a fragment of a volute krater
      <rs type="vase">Wrzburg inv. 4781</rs> shows only the arm of the musician, and he
      is wearing a long sleeved checkered shirt.</P><P>Both panels have a lower border
      of stopped meanders alternating with patterned squares (crosses and dotted
      saltires).</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/107ea3ab278310d15da400135860d4f4de8590cb9777af072626f7af7d4d9fab> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P><hi rend="ital">Side A:</hi> herm between a maenad
      and a satyr. Maenad wears a chiton, a himation, and a sakkos, and holds a thyrsos. The satyr
      advances from right offering a bunch of grapes and cradling a thyrsos in his arm. He wears a
      fillet and has black hair and beard. He is ithyphallic. A caduceus is on the side of the
      herm.</P><P><hi rend="ital">Side B:</hi> three youths in himatia. The
      youths at left and right hold staffs in their right hands.</P><P>The base line is
      composed of groups of meanders alternating with cross squares. There is a laurel wreath under
      the rim.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/1082e1a4983d4ddaedd396f0da34653fecc2919290481783cbb5bc1a6afb5d73> a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content """<P><bibl>Robertson 1959, 113-14</bibl>; <bibl>Simon &
      Hirmer 1976, 129.</bibl></P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/108588b2267a4bb705d37000390d589351fd164a0abdbf40bb4a2883cda5d931> a crm:E33_Linguistic_Object ;
