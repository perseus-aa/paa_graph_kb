    rdfs:label "Bibliographic references"@en ;
    crm:P190_has_symbolic_content "<bibl>CVA, Louvre 8, III.Id, pl. 38.1-2</bibl>" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300026497> .

<https://aa.perseus.org/id/text/c21568402fd78bfc43c5af46ce598f9965f1024e1915db1544e1be87bb99f208> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """The exterior is not decorated. Preliminary sketch lines on the figural
      scenein the tondo (especially apparent where the painter did not follow these lines) indicate
      the degree to which the painter (perhaps a minor figure in the Pioneer Group) experimented
      (somewhat unsuccessfully) with rendering the figures in a naturalistic
      pose.""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

<https://aa.perseus.org/id/text/c217b28bd699fd37918d7fd80d9347bc7903a28ec839a5c1efec1cf9ad13da89> a crm:E33_Linguistic_Object ;
    rdfs:label "Condition"@en ;
    crm:P190_has_symbolic_content """<P>Broken and repaired, with several missing pieces and wide cracks restored; only
      minimal re-painting. On side A, damage to the face of Poseidon, Zeus' right arm, upper legs,
      lower body, and throne, and Hermes' right leg and foot. On side B, damage to the chest of the
      youth at left.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435429> .

<https://aa.perseus.org/id/text/c21bfd0a8821de78c72c22f92729c0f07649032d5bc4ee2fb815bd06ee11424c> a crm:E33_Linguistic_Object ;
    rdfs:label "Iconographic description"@en ;
    crm:P190_has_symbolic_content """<P>Plastic neck and spout in the shape of a griffin. Orientalizing
      motifs: guilloche and rays, lion and stag, grazing horse on
      shoulder.</P>""" ;
    crm:P2_has_type <http://vocab.getty.edu/aat/300435430> .

