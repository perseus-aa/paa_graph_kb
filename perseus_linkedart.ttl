    crm:P190_has_symbolic_content "<bibl>Vierneisel-Schlrb 1979, 262 n. 4.11</bibl>; <bibl>La Rocca 1974, 113 no. 13</bibl>; <bibl>Richter 1970d, 255-56, figs. 662-63</bibl>; <bibl>Grossman 1959, 239 no. FS19</bibl>; <bibl>Herrmann 1925, 33 no. 107</bibl>;<bibl>Hettner 1881, 60 n. 29</bibl>." ;
